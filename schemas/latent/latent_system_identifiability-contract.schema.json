{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F15-D1-I1 Latent-System Discovery & Identifiability Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "capability_id",
    "parent_binding",
    "evidence_registry",
    "records",
    "facts",
    "rule_assertions",
    "conclusion"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "const": "F15-D1-I1"
    },
    "capability_id": {
      "const": "latent_system_identifiability"
    },
    "parent_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "exact_head"
      ],
      "properties": {
        "task_id": {
          "const": "Q41-I1"
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "evidence_registry": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "record_type",
          "latent_system_candidate",
          "cross_system_ancestor_graph",
          "missing_system_search_plan",
          "identifiability_gate",
          "observational_signature",
          "equivalent_decompositions",
          "distinguishing_evidence_request",
          "candidate_status",
          "contradictions",
          "unsupported_elements",
          "claim_ceiling"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "record_type": {
            "enum": [
              "IDENTIFIABLE_CANDIDATE",
              "NON_IDENTIFIABLE_EQUIVALENCE_SET"
            ]
          },
          "latent_system_candidate": {
            "$ref": "#/$defs/boundedField"
          },
          "cross_system_ancestor_graph": {
            "$ref": "#/$defs/boundedField"
          },
          "missing_system_search_plan": {
            "$ref": "#/$defs/boundedField"
          },
          "identifiability_gate": {
            "$ref": "#/$defs/boundedField"
          },
          "observational_signature": {
            "$ref": "#/$defs/boundedField"
          },
          "equivalent_decompositions": {
            "$ref": "#/$defs/boundedField"
          },
          "distinguishing_evidence_request": {
            "$ref": "#/$defs/boundedField"
          },
          "candidate_status": {
            "$ref": "#/$defs/boundedField"
          },
          "contradictions": {
            "$ref": "#/$defs/boundedField"
          },
          "unsupported_elements": {
            "$ref": "#/$defs/boundedField"
          },
          "claim_ceiling": {
            "$ref": "#/$defs/boundedField"
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "residual_not_entity",
        "pattern_not_common_cause",
        "equivalent_decompositions_preserved",
        "distinguishing_evidence_required",
        "non_identifiable_stays_unresolved",
        "contradictions_preserved",
        "unsupported_not_promoted",
        "claim_ceiling_preserved"
      ],
      "properties": {
        "residual_not_entity": {
          "type": "boolean"
        },
        "pattern_not_common_cause": {
          "type": "boolean"
        },
        "equivalent_decompositions_preserved": {
          "type": "boolean"
        },
        "distinguishing_evidence_required": {
          "type": "boolean"
        },
        "non_identifiable_stays_unresolved": {
          "type": "boolean"
        },
        "contradictions_preserved": {
          "type": "boolean"
        },
        "unsupported_not_promoted": {
          "type": "boolean"
        },
        "claim_ceiling_preserved": {
          "type": "boolean"
        }
      }
    },
    "rule_assertions": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "status",
          "evidence_refs",
          "effect"
        ],
        "properties": {
          "rule_id": {
            "enum": [
              "residual_not_entity",
              "pattern_not_common_cause",
              "equivalent_decompositions_preserved",
              "distinguishing_evidence_required",
              "non_identifiable_stays_unresolved",
              "contradictions_preserved",
              "unsupported_not_promoted",
              "claim_ceiling_preserved"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "effect": {
            "enum": [
              "ALLOW_WITHIN_CEILING",
              "BLOCK",
              "DOWNGRADE"
            ]
          }
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "claim_ceiling",
        "history_preserved",
        "external_action_performed"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "history_preserved": {
          "type": "boolean"
        },
        "external_action_performed": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "boundedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "const": "RECORDED"
        },
        "value": {
          "type": [
            "string",
            "boolean",
            "number",
            "array",
            "object",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "artifact",
        "exact_head",
        "artifact_digest",
        "rights_status"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rights_status": {
          "enum": [
            "REPOSITORY_INTERNAL",
            "PUBLIC_METADATA_ONLY"
          ]
        }
      }
    }
  }
}
