{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Q43-I1 Graded Intervention & Professional Escalation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "capability_id",
    "parent_binding",
    "evidence_registry",
    "records",
    "facts",
    "rule_assertions",
    "conclusion"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "const": "Q43-I1"
    },
    "capability_id": {
      "const": "graded_intervention_escalation"
    },
    "parent_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "exact_head"
      ],
      "properties": {
        "task_id": {
          "const": "Q42-I1"
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "evidence_registry": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "record_type",
          "action_risk_class",
          "reversibility",
          "evidence_grade",
          "authority",
          "expertise_requirement",
          "automatic_repository_local_action",
          "user_confirmation_required",
          "expert_escalation",
          "institutional_approval",
          "prohibited_action",
          "request_only_external_action",
          "stop_rollback_result_return",
          "claim_ceiling"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "record_type": {
            "enum": [
              "REPOSITORY_LOCAL_REVERSIBLE",
              "HIGH_RISK_REQUEST_ONLY"
            ]
          },
          "action_risk_class": {
            "$ref": "#/$defs/boundedField"
          },
          "reversibility": {
            "$ref": "#/$defs/boundedField"
          },
          "evidence_grade": {
            "$ref": "#/$defs/boundedField"
          },
          "authority": {
            "$ref": "#/$defs/boundedField"
          },
          "expertise_requirement": {
            "$ref": "#/$defs/boundedField"
          },
          "automatic_repository_local_action": {
            "$ref": "#/$defs/boundedField"
          },
          "user_confirmation_required": {
            "$ref": "#/$defs/boundedField"
          },
          "expert_escalation": {
            "$ref": "#/$defs/boundedField"
          },
          "institutional_approval": {
            "$ref": "#/$defs/boundedField"
          },
          "prohibited_action": {
            "$ref": "#/$defs/boundedField"
          },
          "request_only_external_action": {
            "$ref": "#/$defs/boundedField"
          },
          "stop_rollback_result_return": {
            "$ref": "#/$defs/boundedField"
          },
          "claim_ceiling": {
            "$ref": "#/$defs/boundedField"
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_class_required",
        "reversibility_required",
        "evidence_grade_required",
        "authority_required",
        "expertise_boundary_enforced",
        "automatic_only_repository_local",
        "confirmation_for_external",
        "high_risk_request_only",
        "prohibited_never_executed",
        "stop_rollback_return_present"
      ],
      "properties": {
        "risk_class_required": {
          "type": "boolean"
        },
        "reversibility_required": {
          "type": "boolean"
        },
        "evidence_grade_required": {
          "type": "boolean"
        },
        "authority_required": {
          "type": "boolean"
        },
        "expertise_boundary_enforced": {
          "type": "boolean"
        },
        "automatic_only_repository_local": {
          "type": "boolean"
        },
        "confirmation_for_external": {
          "type": "boolean"
        },
        "high_risk_request_only": {
          "type": "boolean"
        },
        "prohibited_never_executed": {
          "type": "boolean"
        },
        "stop_rollback_return_present": {
          "type": "boolean"
        }
      }
    },
    "rule_assertions": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "status",
          "evidence_refs",
          "effect"
        ],
        "properties": {
          "rule_id": {
            "enum": [
              "risk_class_required",
              "reversibility_required",
              "evidence_grade_required",
              "authority_required",
              "expertise_boundary_enforced",
              "automatic_only_repository_local",
              "confirmation_for_external",
              "high_risk_request_only",
              "prohibited_never_executed",
              "stop_rollback_return_present"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "effect": {
            "enum": [
              "ALLOW_WITHIN_CEILING",
              "BLOCK",
              "DOWNGRADE"
            ]
          }
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "claim_ceiling",
        "history_preserved",
        "external_action_performed"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "history_preserved": {
          "type": "boolean"
        },
        "external_action_performed": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "boundedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "const": "RECORDED"
        },
        "value": {
          "type": [
            "string",
            "boolean",
            "number",
            "array",
            "object",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "artifact",
        "exact_head",
        "artifact_digest",
        "rights_status"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rights_status": {
          "enum": [
            "REPOSITORY_INTERNAL",
            "PUBLIC_METADATA_ONLY"
          ]
        }
      }
    }
  }
}
