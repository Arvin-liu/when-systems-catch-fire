{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Q42-I1 Counterfactual & Unrealized-Path Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "capability_id",
    "parent_binding",
    "evidence_registry",
    "records",
    "facts",
    "rule_assertions",
    "conclusion"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "const": "Q42-I1"
    },
    "capability_id": {
      "const": "counterfactual_unrealized_path"
    },
    "parent_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "exact_head"
      ],
      "properties": {
        "task_id": {
          "const": "D2-I1"
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "evidence_registry": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "record_type",
          "counterfactuals",
          "alternative_decompositions",
          "unrealized_paths",
          "speculative_narratives",
          "intervention_differences",
          "identifiability_status",
          "observable_portion",
          "unobservable_portion",
          "evidence",
          "claim_ceiling"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "record_type": {
            "enum": [
              "IDENTIFIABLE_COUNTERFACTUAL",
              "SPECULATIVE_UNREALIZED_PATH"
            ]
          },
          "counterfactuals": {
            "$ref": "#/$defs/boundedField"
          },
          "alternative_decompositions": {
            "$ref": "#/$defs/boundedField"
          },
          "unrealized_paths": {
            "$ref": "#/$defs/boundedField"
          },
          "speculative_narratives": {
            "$ref": "#/$defs/boundedField"
          },
          "intervention_differences": {
            "$ref": "#/$defs/boundedField"
          },
          "identifiability_status": {
            "$ref": "#/$defs/boundedField"
          },
          "observable_portion": {
            "$ref": "#/$defs/boundedField"
          },
          "unobservable_portion": {
            "$ref": "#/$defs/boundedField"
          },
          "evidence": {
            "$ref": "#/$defs/boundedField"
          },
          "claim_ceiling": {
            "$ref": "#/$defs/boundedField"
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "types_separated",
        "identifiability_gate_required",
        "unobservable_not_promoted",
        "evidence_required",
        "intervention_difference_explicit",
        "speculation_labeled",
        "no_if_then_causal_upgrade",
        "claim_ceiling_preserved"
      ],
      "properties": {
        "types_separated": {
          "type": "boolean"
        },
        "identifiability_gate_required": {
          "type": "boolean"
        },
        "unobservable_not_promoted": {
          "type": "boolean"
        },
        "evidence_required": {
          "type": "boolean"
        },
        "intervention_difference_explicit": {
          "type": "boolean"
        },
        "speculation_labeled": {
          "type": "boolean"
        },
        "no_if_then_causal_upgrade": {
          "type": "boolean"
        },
        "claim_ceiling_preserved": {
          "type": "boolean"
        }
      }
    },
    "rule_assertions": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "status",
          "evidence_refs",
          "effect"
        ],
        "properties": {
          "rule_id": {
            "enum": [
              "types_separated",
              "identifiability_gate_required",
              "unobservable_not_promoted",
              "evidence_required",
              "intervention_difference_explicit",
              "speculation_labeled",
              "no_if_then_causal_upgrade",
              "claim_ceiling_preserved"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "effect": {
            "enum": [
              "ALLOW_WITHIN_CEILING",
              "BLOCK",
              "DOWNGRADE"
            ]
          }
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "claim_ceiling",
        "history_preserved",
        "external_action_performed"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "history_preserved": {
          "type": "boolean"
        },
        "external_action_performed": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "boundedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "const": "RECORDED"
        },
        "value": {
          "type": [
            "string",
            "boolean",
            "number",
            "array",
            "object",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "evidence_id",
        "artifact",
        "exact_head",
        "artifact_digest",
        "rights_status"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rights_status": {
          "enum": [
            "REPOSITORY_INTERNAL",
            "PUBLIC_METADATA_ONLY"
          ]
        }
      }
    }
  }
}
