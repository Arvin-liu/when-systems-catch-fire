{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adaptive-relational-runtime:schema:observation",
  "title": "ARR Observation record",
  "description": "Plane 1 product of a single collection/read act over a Source; carries collection provenance, no interpretation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "record_kind",
    "schema_version",
    "scope",
    "provenance",
    "explicitness",
    "claim_ceiling",
    "uncertainty",
    "alternatives",
    "lifecycle",
    "time",
    "extensions",
    "source_ref",
    "observer",
    "raw_excerpt",
    "collection_metadata"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[a-z]{2,4}_[0-9a-f]{32}$"
    },
    "record_kind": {
      "const": "Observation"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^arr-r[0-9]+\\.[0-9]+$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "context_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "explicitness": {
      "type": "string",
      "enum": [
        "EXPLICIT",
        "UNKNOWN"
      ]
    },
    "claim_ceiling": {
      "type": "string",
      "enum": [
        "PRIMARY_VERIFIED",
        "SECONDARY",
        "UNKNOWN"
      ]
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "OBSERVED",
            "PROVISIONAL",
            "CANDIDATE",
            "SUPPORTED",
            "CONTESTED",
            "SUPERSEDED",
            "ARCHIVED",
            "REACTIVATED",
            "REJECTED",
            "UNKNOWN"
          ]
        },
        "entered_at_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "transition_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_time",
        "observation_time_status",
        "ingestion_time",
        "ingestion_time_status"
      ],
      "properties": {
        "observation_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "observation_time_status": {
          "type": "string",
          "enum": [
            "OK",
            "ABSENT",
            "MALFORMED"
          ]
        },
        "ingestion_time": {
          "type": "string"
        },
        "ingestion_time_status": {
          "type": "string",
          "enum": [
            "OK",
            "ABSENT",
            "MALFORMED"
          ]
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "pattern": "^x_[a-z0-9_]+$"
      },
      "patternProperties": {
        "^x_[a-z0-9_]+$": {}
      }
    },
    "source_ref": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{32}$"
    },
    "observer": {
      "type": "string",
      "minLength": 1
    },
    "raw_excerpt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "inline",
            "hash_only",
            "none"
          ]
        },
        "value": {
          "type": "string"
        }
      }
    },
    "collection_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "tool_ref",
        "parameters"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "tool_ref": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      }
    }
  },
  "$comment": "SPDX-License-Identifier: Apache-2.0"
}
