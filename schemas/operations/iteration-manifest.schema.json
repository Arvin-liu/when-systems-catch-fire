{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/iteration-manifest.schema.json",
  "title": "Ignition Iteration Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "method_version",
    "task_id",
    "change_classification",
    "verified_start",
    "branch_pr",
    "candidate_head",
    "candidate_head_note",
    "gap",
    "claim_ceiling",
    "status",
    "impact_matrix",
    "changed_surfaces",
    "validation",
    "rollback_strategy",
    "remaining_limitations",
    "receipt_location"
  ],
  "properties": {
    "method_version": { "$ref": "#/$defs/nonblankString" },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "change_classification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "REPAIR",
          "CAPABILITY_ADDITION",
          "INTERFACE_CHANGE",
          "EVIDENCE_UPDATE",
          "GOVERNANCE_CHANGE",
          "RELEASE_OR_CURRENT_STATE_SYNC",
          "HISTORICAL_ONLY",
          "OPERATIONS_METHOD"
        ]
      },
      "uniqueItems": true
    },
    "verified_start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main_head", "source", "verified_at"],
      "properties": {
        "main_head": { "$ref": "#/$defs/sha" },
        "source": { "$ref": "#/$defs/nonblankString" },
        "verified_at": { "$ref": "#/$defs/nonblankString" }
      }
    },
    "branch_pr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "pr_number", "base", "base_head", "draft", "merged"],
      "properties": {
        "branch": { "$ref": "#/$defs/nonblankString" },
        "pr_number": { "type": ["integer", "null"], "minimum": 1 },
        "base": { "$ref": "#/$defs/nonblankString" },
        "base_head": { "$ref": "#/$defs/sha" },
        "draft": { "type": "boolean" },
        "merged": { "type": "boolean" }
      }
    },
    "candidate_head": { "$ref": "#/$defs/sha" },
    "candidate_head_note": { "$ref": "#/$defs/nonblankString" },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "evidence", "smallest_material_action"],
      "properties": {
        "summary": { "$ref": "#/$defs/nonblankString" },
        "evidence": { "$ref": "#/$defs/nonblankStringArray" },
        "smallest_material_action": { "$ref": "#/$defs/nonblankString" }
      }
    },
    "claim_ceiling": { "$ref": "#/$defs/nonblankString" },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "ready_for_gpt_verification", "accepted", "merged", "current"],
      "properties": {
        "candidate": { "type": "boolean" },
        "ready_for_gpt_verification": { "type": "boolean" },
        "accepted": { "type": "boolean" },
        "merged": { "type": "boolean" },
        "current": { "type": "boolean" }
      }
    },
    "impact_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "decision", "reason"],
        "properties": {
          "surface": { "$ref": "#/$defs/nonblankString" },
          "decision": { "enum": ["CHANGE", "NO_CHANGE_WITH_REASON", "NOT_APPLICABLE"] },
          "reason": { "$ref": "#/$defs/nonblankString" }
        }
      }
    },
    "changed_surfaces": { "$ref": "#/$defs/nonblankStringArray" },
    "explicitly_unaffected_surfaces": { "$ref": "#/$defs/nonblankStringArray" },
    "required_synchronization_decisions": { "$ref": "#/$defs/nonblankStringArray" },
    "schema_tools_tests_workflows_reports_changed": { "$ref": "#/$defs/nonblankStringArray" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local", "remote"],
      "properties": {
        "local": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/validationItem" } },
        "remote": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/validationItem" } }
      }
    },
    "rollback_strategy": { "$ref": "#/$defs/nonblankString" },
    "remaining_limitations": { "$ref": "#/$defs/nonblankStringArray" },
    "receipt_location": { "$ref": "#/$defs/nonblankString" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "positiveRunId": { "type": "integer", "minimum": 1 },
    "nonblankString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "nonblankStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonblankString" },
      "uniqueItems": true
    },
    "validationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence"],
      "properties": {
        "name": { "$ref": "#/$defs/nonblankString" },
        "status": { "$ref": "#/$defs/nonblankString" },
        "evidence": { "$ref": "#/$defs/nonblankString" },
        "head": { "$ref": "#/$defs/sha" },
        "run_id": { "$ref": "#/$defs/positiveRunId" },
        "conclusion": { "$ref": "#/$defs/nonblankString" }
      }
    }
  }
}
