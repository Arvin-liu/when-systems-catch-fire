{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generated-output-authority.schema.json",
  "title": "Generated Output Authority",
  "description": "Schema for the canonical machine-readable authority declaring all generated outputs in PR diff coverage. Authority kinds are mutually exclusive: producer_command, registered_generator, historical_sealed_record. Free-string generators are NOT permitted.",
  "type": "object",
  "required": ["schema_version", "task_id", "description", "generated_outputs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Schema version of this authority document"
    },
    "task_id": {
      "type": "string",
      "description": "Task identifier this authority belongs to"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of this authority"
    },
    "generated_outputs": {
      "type": "array",
      "description": "All generated outputs covered by this PR diff",
      "items": {
        "type": "object",
        "anyOf": [
          {
            "description": "Producer-command generated output (regenerated by an explicit command).",
            "required": [
              "path",
              "producer_id",
              "producer_command",
              "input_authorities",
              "output_type",
              "freshness_mode",
              "coverage_class",
              "justification"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "description": "Repository-relative path of the generated output",
                "pattern": "^[^/]"
              },
              "producer_id": {
                "type": "string",
                "minLength": 1,
                "description": "Unique identifier of the producer tool or function"
              },
              "producer_command": {
                "type": "string",
                "minLength": 1,
                "description": "Command to regenerate this output"
              },
              "input_authorities": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 1,
                "uniqueItems": true,
                "description": "Canonical input files this output is deterministically derived from"
              },
              "output_type": {
                "type": "string",
                "enum": [
                  "materialized_projection",
                  "residue",
                  "seal_bound_derivative",
                  "report",
                  "deployment_artifact"
                ],
                "description": "Classification of the output type"
              },
              "freshness_mode": {
                "type": "string",
                "enum": ["byte_level_recompute", "timestamp_based", "semantic_diff"],
                "description": "How freshness is verified"
              },
              "coverage_class": {
                "type": "string",
                "enum": ["generated_output"],
                "description": "Diff coverage classification"
              },
              "justification": {
                "type": "string",
                "minLength": 1,
                "description": "Why this path is a genuine generated output"
              }
            }
          },
          {
            "description": "Registered-generator output: produced by a generator registered in generator-registry.json. The generator_id, canonical_tool, allowed output path, and input authorities MUST all match the registry entry. Verified by content digest.",
            "required": [
              "path",
              "generator_id",
              "canonical_tool",
              "input_authorities",
              "output_type",
              "freshness_mode",
              "coverage_class",
              "lifecycle_status",
              "authority_schema_version",
              "content_digest_sha256",
              "justification"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "description": "Repository-relative path of the generated output",
                "pattern": "^[^/]"
              },
              "generator_id": {
                "type": "string",
                "minLength": 1,
                "description": "Generator identifier registered in generator-registry.json (NOT a free string)"
              },
              "canonical_tool": {
                "type": "string",
                "minLength": 1,
                "description": "Canonical tool/path that materializes this output, as registered"
              },
              "input_authorities": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 1,
                "uniqueItems": true,
                "description": "Input authorities this output is derived from (must equal registry required inputs)"
              },
              "output_type": {
                "type": "string",
                "enum": [
                  "materialized_projection",
                  "residue",
                  "seal_bound_derivative",
                  "report",
                  "deployment_artifact"
                ]
              },
              "freshness_mode": {
                "type": "string",
                "enum": ["byte_level_recompute", "timestamp_based", "semantic_diff"]
              },
              "coverage_class": {
                "type": "string",
                "enum": ["generated_output"]
              },
              "lifecycle_status": {
                "type": "string",
                "enum": ["active"],
                "description": "Registered generators authorize CURRENT/live output only when active"
              },
              "authority_schema_version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "content_digest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "SHA-256 of the generated file content; must match the live file for freshness"
              },
              "justification": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "description": "Historical sealed record: validates a SEALED historical output only. It MUST NOT authorize current/live output and MUST NOT enter production-executable authority (historical_only is constant true).",
            "required": [
              "path",
              "sealed_ref",
              "seal_file",
              "seal_sha256",
              "output_type",
              "coverage_class",
              "historical_only",
              "justification"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[^/]"
              },
              "sealed_ref": {
                "type": "string",
                "minLength": 1,
                "description": "Reference to the sealing iteration/authority"
              },
              "seal_file": {
                "type": "string",
                "minLength": 1,
                "description": "Path to the seal file that attests this historical output"
              },
              "seal_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "SHA-256 of the seal file"
              },
              "output_type": {
                "type": "string",
                "enum": [
                  "materialized_projection",
                  "residue",
                  "seal_bound_derivative",
                  "report",
                  "deployment_artifact"
                ]
              },
              "coverage_class": {
                "type": "string",
                "enum": ["generated_output"]
              },
              "historical_only": {
                "const": true,
                "description": "This record is historical only; it cannot authorize current/live output"
              },
              "justification": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
