{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/synchronization-surfaces.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "purpose", "surfaces"],
  "properties": {
    "registry_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "purpose": {"$ref": "#/$defs/nonblank"},
    "surfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surface"}}
  },
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "stringArray": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "surface_type", "locator", "roles", "authority", "derived_from", "trigger_dimensions", "trigger_classifications", "allowed_decisions", "validation_mode", "blocks"],
      "properties": {
        "surface_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
        "surface_type": {"enum": ["repository_source", "repository_derived_surface", "external_rendered_deployed_surface"]},
        "locator": {"$ref": "#/$defs/nonblank"},
        "roles": {"$ref": "#/$defs/stringArray"},
        "authority": {"enum": ["canonical", "derived", "external"]},
        "derived_from": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"}, "uniqueItems": true},
        "trigger_dimensions": {"type": "array", "items": {"enum": ["capability", "identity", "usage", "handoff", "lifecycle_current_state", "governance", "deployment_rendering", "operations_method"]}, "uniqueItems": true},
        "trigger_classifications": {"type": "array", "items": {"enum": ["REPAIR", "CAPABILITY_ADDITION", "INTERFACE_CHANGE", "EVIDENCE_UPDATE", "GOVERNANCE_CHANGE", "RELEASE_OR_CURRENT_STATE_SYNC", "HISTORICAL_ONLY", "OPERATIONS_METHOD"]}, "uniqueItems": true},
        "allowed_decisions": {"type": "array", "minItems": 1, "items": {"enum": ["CHANGE", "NO_CHANGE_WITH_REASON", "NOT_APPLICABLE"]}, "uniqueItems": true},
        "validation_mode": {"$ref": "#/$defs/nonblank"},
        "blocks": {"type": "array", "items": {"enum": ["ready", "current", "closed"]}, "uniqueItems": true}
      }
    }
  }
}
