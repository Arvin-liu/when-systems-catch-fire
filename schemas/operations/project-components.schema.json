{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/project-components.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "purpose", "components"],
  "properties": {
    "registry_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "purpose": {"$ref": "#/$defs/nonblank"},
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
    "allowed_path_overlaps": {"type": "array", "items": {"$ref": "#/$defs/pathOverlap"}}
  },
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "stringArray": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
    "pathOverlap": {
      "type": "object", "additionalProperties": false,
      "required": ["component_ids", "reason", "authority_source", "path_patterns"],
      "properties": {
        "component_ids": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
        "reason": {"$ref": "#/$defs/nonblank"},
        "authority_source": {"$ref": "#/$defs/nonblank"},
        "path_patterns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "label", "description", "component_type", "canonical_target", "path_patterns", "authority", "layer_or_overlay", "lifecycle", "map_projection"],
      "properties": {
        "component_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "label": {"$ref": "#/$defs/nonblank"},
        "description": {"$ref": "#/$defs/nonblank"},
        "component_type": {"enum": ["front_door", "architecture_layer", "foundation_core", "model_projection", "operation_control", "governance_constraint", "publication_chain", "feedback_interface", "interpretation_boundary", "repository_infrastructure", "historical_asset"]},
        "canonical_target": {"$ref": "#/$defs/nonblank"},
        "path_patterns": {"type": "array", "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
        "authority": {"enum": ["canonical", "derived", "declarative", "historical"]},
        "layer_or_overlay": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6", "foundation", "overlay", "governance", "publication", "infrastructure", "boundary"]},
        "lifecycle": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "source"],
          "properties": {"status": {"enum": ["current", "draft_candidate", "historical", "accepted_work", "boundary"]}, "version": {"$ref": "#/$defs/nonblank"}, "source": {"$ref": "#/$defs/nonblank"}}
        },
        "map_projection": {
          "type": "object", "additionalProperties": false,
          "required": ["visible"],
          "properties": {
            "visible": {"type": "boolean"},
            "group": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "represented_by": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "no_change_reason": {"$ref": "#/$defs/nonblank"}
          },
          "allOf": [
            {"if": {"properties": {"visible": {"const": true}}, "required": ["visible"]}, "then": {"required": ["group"]}},
            {"if": {"properties": {"visible": {"const": false}}, "required": ["visible"]}, "then": {"required": ["represented_by", "no_change_reason"]}}
          ]
        }
      }
    }
  }
}
