{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/change-propagation-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_version", "task_id", "base_identity", "head_identity", "changed_paths", "state_transition_subjects", "changed_dimensions", "change_classifications", "component_decisions", "surface_decisions", "system_map_decision"],
  "properties": {
    "request_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "base_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_identity": {"type": "string", "minLength": 1},
    "changed_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "explicit_seed_components": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "explicit_seed_evidence": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["reason", "authority"], "properties": {"reason": {"type": "string", "minLength": 1}, "authority": {"type": "string", "minLength": 1}, "source_path": {"type": "string"}}}},
    "state_transition_subjects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "changed_dimensions": {"type": "array", "items": {"enum": ["capability", "identity", "usage", "handoff", "lifecycle_current_state", "governance", "deployment_rendering", "operations_method"]}, "uniqueItems": true},
    "change_classifications": {"type": "array", "minItems": 1, "items": {"enum": ["REPAIR", "CAPABILITY_ADDITION", "INTERFACE_CHANGE", "EVIDENCE_UPDATE", "GOVERNANCE_CHANGE", "RELEASE_OR_CURRENT_STATE_SYNC", "HISTORICAL_ONLY", "OPERATIONS_METHOD"]}, "uniqueItems": true},
    "component_decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "surface_decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "system_map_decision": {"$ref": "#/$defs/decision"}
  },
  "$defs": {
    "decision": {"type": "object", "additionalProperties": false, "required": ["item_id", "decision", "reason"], "properties": {"item_id": {"type": "string", "minLength": 1}, "decision": {"enum": ["CHANGE", "NO_CHANGE_WITH_REASON", "NOT_APPLICABLE"]}, "reason": {"type": "string", "minLength": 1}}}
  }
}
