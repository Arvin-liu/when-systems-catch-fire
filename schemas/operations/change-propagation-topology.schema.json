{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/change-propagation-topology.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["topology_version", "purpose", "relation_classes", "relations"],
  "properties": {
    "topology_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "purpose": {"$ref": "#/$defs/nonblank"},
    "relation_classes": {"type": "array", "minItems": 1, "items": {"enum": ["derives", "generates", "validates", "publishes", "projects", "documents", "version_tracks", "lifecycle_depends_on", "governance_constrains", "synchronization_requires", "deployment_depends_on", "mechanism_hypothesis", "enabling_condition", "constraint", "unknown_or_unmapped"]}, "uniqueItems": true},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["relation_id", "source", "target", "relation_class", "relation_domain", "trigger_dimensions", "trigger_classifications", "propagation_mode", "required_evaluation", "creates_sync_obligation", "map_visible", "label", "declaration_source", "claim_ceiling", "residue"],
      "properties": {
        "relation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "source": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "target": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "relation_class": {"enum": ["derives", "generates", "validates", "publishes", "projects", "documents", "version_tracks", "lifecycle_depends_on", "governance_constrains", "synchronization_requires", "deployment_depends_on", "mechanism_hypothesis", "enabling_condition", "constraint", "unknown_or_unmapped"]},
        "relation_domain": {"enum": ["substantive_causal_candidate", "repository_dependency", "synchronization_obligation"]},
        "trigger_dimensions": {"type": "array", "items": {"enum": ["capability", "identity", "usage", "handoff", "lifecycle_current_state", "governance", "deployment_rendering", "operations_method"]}, "uniqueItems": true},
        "trigger_classifications": {"type": "array", "items": {"enum": ["REPAIR", "CAPABILITY_ADDITION", "INTERFACE_CHANGE", "EVIDENCE_UPDATE", "GOVERNANCE_CHANGE", "RELEASE_OR_CURRENT_STATE_SYNC", "HISTORICAL_ONLY", "OPERATIONS_METHOD"]}, "uniqueItems": true},
        "propagation_mode": {"enum": ["automatic", "required_assessment", "informational_only", "blocks_on_residue"]},
        "required_evaluation": {"type": "boolean"},
        "creates_sync_obligation": {"type": "boolean"},
        "map_visible": {"type": "boolean"},
        "label": {"$ref": "#/$defs/nonblank"},
        "declaration_source": {"$ref": "#/$defs/nonblank"},
        "claim_ceiling": {"$ref": "#/$defs/nonblank"},
        "residue": {"type": "array", "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true}
      },
      "allOf": [
        {
          "if": {"properties": {"relation_domain": {"const": "substantive_causal_candidate"}}, "required": ["relation_domain"]},
          "then": {
            "properties": {
              "propagation_mode": {"const": "informational_only"},
              "required_evaluation": {"const": false},
              "creates_sync_obligation": {"const": false}
            }
          }
        }
      ]
    }
  }
}
