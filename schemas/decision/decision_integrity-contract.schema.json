{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DECISION-INTEGRITY-I1 Principle Lock, Process Quality & Outcome-Bias Governance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "capability_id",
    "parent_binding",
    "evidence_registry",
    "records",
    "facts",
    "rule_assertions",
    "conclusion"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "const": "DECISION-INTEGRITY-I1"
    },
    "capability_id": {
      "const": "decision_integrity"
    },
    "parent_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "exact_head"
      ],
      "properties": {
        "task_id": {
          "const": "SYMBOLIC-SPHERE-I1"
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "evidence_registry": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "record_type",
          "principle_registry",
          "principle_version",
          "revision_authority",
          "ex_ante_decision_record",
          "known_unknown_assumptions",
          "decision_hierarchy",
          "competence_boundary",
          "risk_reversibility_stop",
          "process_quality",
          "outcome_quality",
          "process_outcome_quadrant",
          "result_bias_audit",
          "post_hoc_narrative_diff",
          "principle_capture",
          "legitimate_revision",
          "usefulness_necessity_gate",
          "bargain_fomo_signal",
          "information_intake",
          "integration_evidence",
          "learning_update",
          "claim_ceiling"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "record_type": {
            "enum": [
              "BAD_PROCESS_GOOD_OUTCOME",
              "GOOD_PROCESS_BAD_OUTCOME"
            ]
          },
          "principle_registry": {
            "$ref": "#/$defs/boundedField"
          },
          "principle_version": {
            "$ref": "#/$defs/boundedField"
          },
          "revision_authority": {
            "$ref": "#/$defs/boundedField"
          },
          "ex_ante_decision_record": {
            "$ref": "#/$defs/boundedField"
          },
          "known_unknown_assumptions": {
            "$ref": "#/$defs/boundedField"
          },
          "decision_hierarchy": {
            "$ref": "#/$defs/boundedField"
          },
          "competence_boundary": {
            "$ref": "#/$defs/boundedField"
          },
          "risk_reversibility_stop": {
            "$ref": "#/$defs/boundedField"
          },
          "process_quality": {
            "$ref": "#/$defs/boundedField"
          },
          "outcome_quality": {
            "$ref": "#/$defs/boundedField"
          },
          "process_outcome_quadrant": {
            "$ref": "#/$defs/boundedField"
          },
          "result_bias_audit": {
            "$ref": "#/$defs/boundedField"
          },
          "post_hoc_narrative_diff": {
            "$ref": "#/$defs/boundedField"
          },
          "principle_capture": {
            "$ref": "#/$defs/boundedField"
          },
          "legitimate_revision": {
            "$ref": "#/$defs/boundedField"
          },
          "usefulness_necessity_gate": {
            "$ref": "#/$defs/boundedField"
          },
          "bargain_fomo_signal": {
            "$ref": "#/$defs/boundedField"
          },
          "information_intake": {
            "$ref": "#/$defs/boundedField"
          },
          "integration_evidence": {
            "$ref": "#/$defs/boundedField"
          },
          "learning_update": {
            "$ref": "#/$defs/boundedField"
          },
          "claim_ceiling": {
            "$ref": "#/$defs/boundedField"
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success_not_process_proof",
        "failure_not_process_disproof",
        "ex_ante_record_immutable",
        "principle_relabel_blocked",
        "competence_required",
        "utility_before_bargain",
        "fomo_not_need",
        "intake_not_integration",
        "integration_requires_output",
        "revision_versioned_authorized",
        "original_record_preserved",
        "claim_ceiling_preserved"
      ],
      "properties": {
        "success_not_process_proof": {
          "type": "boolean"
        },
        "failure_not_process_disproof": {
          "type": "boolean"
        },
        "ex_ante_record_immutable": {
          "type": "boolean"
        },
        "principle_relabel_blocked": {
          "type": "boolean"
        },
        "competence_required": {
          "type": "boolean"
        },
        "utility_before_bargain": {
          "type": "boolean"
        },
        "fomo_not_need": {
          "type": "boolean"
        },
        "intake_not_integration": {
          "type": "boolean"
        },
        "integration_requires_output": {
          "type": "boolean"
        },
        "revision_versioned_authorized": {
          "type": "boolean"
        },
        "original_record_preserved": {
          "type": "boolean"
        },
        "claim_ceiling_preserved": {
          "type": "boolean"
        }
      }
    },
    "rule_assertions": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "status",
          "evidence_refs",
          "effect"
        ],
        "properties": {
          "rule_id": {
            "enum": [
              "success_not_process_proof",
              "failure_not_process_disproof",
              "ex_ante_record_immutable",
              "principle_relabel_blocked",
              "competence_required",
              "utility_before_bargain",
              "fomo_not_need",
              "intake_not_integration",
              "integration_requires_output",
              "revision_versioned_authorized",
              "original_record_preserved",
              "claim_ceiling_preserved"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "effect": {
            "enum": [
              "ALLOW_WITHIN_CEILING",
              "BLOCK",
              "DOWNGRADE"
            ]
          }
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "claim_ceiling",
        "history_preserved",
        "external_action_performed"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "history_preserved": {
          "type": "boolean"
        },
        "external_action_performed": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "boundedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "const": "RECORDED"
        },
        "value": {
          "type": [
            "string",
            "boolean",
            "number",
            "array",
            "object",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "artifact",
        "exact_head",
        "artifact_digest",
        "rights_status"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rights_status": {
          "enum": [
            "REPOSITORY_INTERNAL",
            "PUBLIC_METADATA_ONLY"
          ]
        },
        "repository_relative_path": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "record_type": {
          "type": "string",
          "minLength": 1
        },
        "declared_role": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
