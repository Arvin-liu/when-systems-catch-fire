{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/schemas/atlas/atlas.schema.json",
  "title": "Ignition Atlas",
  "type": "object",
  "additionalProperties": false,
  "required": ["atlas_spec", "maps"],
  "properties": {
    "atlas_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "as_of_commit", "purpose", "canonical_truth_source", "permanent_total_map"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "as_of_commit": { "type": "string", "minLength": 7 },
        "purpose": { "type": "string", "minLength": 1 },
        "canonical_truth_source": { "type": "string", "minLength": 1 },
        "permanent_total_map": { "type": "boolean", "const": false }
      }
    },
    "maps": {
      "type": "array",
      "items": { "$ref": "#/$defs/map_spec" }
    }
  },
  "$defs": {
    "map_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "map_type",
        "as_of_commit",
        "observer_or_decision_owner",
        "decision_question",
        "value_recipient_or_affected_subject",
        "layout_semantics",
        "data_sources",
        "generation_method",
        "claim_ceiling",
        "update_triggers",
        "nodes",
        "edges",
        "projections",
        "unmapped_residue"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "map_type": { "enum": ["WARDLEY_STYLE_EVOLUTION", "STRUCTURAL_LANDSCAPE"] },
        "as_of_commit": { "type": "string", "minLength": 7 },
        "observer_or_decision_owner": { "type": "string", "minLength": 1 },
        "decision_question": { "type": "string", "minLength": 1 },
        "value_recipient_or_affected_subject": { "type": "string", "minLength": 1 },
        "layout_semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x_axis", "y_axis", "visual_boundary"],
          "properties": {
            "x_axis": { "type": "string", "minLength": 1 },
            "y_axis": { "type": "string", "minLength": 1 },
            "visual_boundary": { "type": "string", "minLength": 1 }
          }
        },
        "data_sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "generation_method": { "type": "string", "minLength": 1 },
        "claim_ceiling": { "type": "string", "minLength": 1 },
        "update_triggers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/map_node" }, "minItems": 1 },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/map_edge" } },
        "projections": { "type": "array", "items": { "$ref": "#/$defs/map_projection" }, "minItems": 1 },
        "unmapped_residue": { "type": "array", "items": { "$ref": "#/$defs/unmapped_residue" } }
      }
    },
    "map_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "object_ref", "source_refs", "maturity", "value_visibility", "cost_bearers", "maintainer", "uncertainty"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "object_ref": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "maturity": { "enum": ["GENESIS", "CUSTOM_BUILT", "PRODUCT_RENTAL", "COMMODITY_UTILITY", "NOT_APPLICABLE"] },
        "value_visibility": { "type": "string", "minLength": 1 },
        "cost_bearers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "maintainer": { "type": "string", "minLength": 1 },
        "uncertainty": { "type": "string", "minLength": 1 },
        "sourcing_decision": { "$ref": "#/$defs/sourcing_decision" },
        "evolution_record": { "$ref": "#/$defs/evolution_record" }
      }
    },
    "map_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "edge_type", "source_refs", "uncertainty", "not_causality"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "edge_type": { "enum": ["dependency", "information_flow", "control_flow", "evidence_flow", "value_flow"] },
        "source_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "uncertainty": { "type": "string", "minLength": 1 },
        "not_causality": { "type": "boolean", "const": true }
      }
    },
    "map_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input_sources", "projection_rule", "deterministic", "reviewer", "uncertainty"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "input_sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "projection_rule": { "type": "string", "minLength": 1 },
        "deterministic": { "type": "boolean", "const": true },
        "reviewer": { "type": "string", "minLength": 1 },
        "uncertainty": { "type": "string", "minLength": 1 }
      }
    },
    "evolution_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "basis", "not_natural_law"],
      "properties": {
        "stage": { "enum": ["GENESIS", "CUSTOM_BUILT", "PRODUCT_RENTAL", "COMMODITY_UTILITY", "NOT_APPLICABLE"] },
        "basis": { "type": "string", "minLength": 1 },
        "not_natural_law": { "type": "boolean", "const": true }
      }
    },
    "sourcing_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason", "affordable_loss", "charter_constraint", "responsibility_retained"],
      "properties": {
        "decision": { "enum": ["build", "co_build", "buy", "rent", "outsource", "automate", "standardize", "preserve", "freeze", "stop", "pending"] },
        "reason": { "type": "string", "minLength": 1 },
        "affordable_loss": { "type": "string", "minLength": 1 },
        "charter_constraint": { "type": "string", "minLength": 1 },
        "responsibility_retained": { "type": "boolean", "const": true }
      }
    },
    "unmapped_residue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "reason", "next_condition"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "next_condition": { "type": "string", "minLength": 1 }
      }
    }
  }
}
