{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCIENTIFIC-CONTEXT-PROTOCOL-I1 Open Scientific Context Protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "capability_id",
    "parent_binding",
    "evidence_registry",
    "records",
    "facts",
    "rule_assertions",
    "conclusion"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "const": "SCIENTIFIC-CONTEXT-PROTOCOL-I1"
    },
    "capability_id": {
      "const": "open_scientific_context_protocol"
    },
    "parent_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "exact_head"
      ],
      "properties": {
        "task_id": {
          "const": "Q44-I1"
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "evidence_registry": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "record_type",
          "protocol_version",
          "source_rights_context",
          "model_tool_executor_identity",
          "authority_capability",
          "observation_prediction",
          "analogy_search_case",
          "intervention_failure",
          "symbolic_perspectives",
          "decision_integrity",
          "epistemic_state",
          "latent_multi_history_counterfactual",
          "experiment_hardware_request_result",
          "exact_head_provenance_digest",
          "stop_rollback",
          "sensitive_data_network_local_first",
          "capability_negotiation",
          "request_response_envelope",
          "identity_authorization",
          "artifact_binding",
          "failure_retry_semantics",
          "compatibility_policy",
          "local_mock_adapter",
          "claim_ceiling"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "record_type": {
            "enum": [
              "LOCAL_MOCK_REQUEST",
              "LOCAL_MOCK_RESPONSE"
            ]
          },
          "protocol_version": {
            "$ref": "#/$defs/boundedField"
          },
          "source_rights_context": {
            "$ref": "#/$defs/boundedField"
          },
          "model_tool_executor_identity": {
            "$ref": "#/$defs/boundedField"
          },
          "authority_capability": {
            "$ref": "#/$defs/boundedField"
          },
          "observation_prediction": {
            "$ref": "#/$defs/boundedField"
          },
          "analogy_search_case": {
            "$ref": "#/$defs/boundedField"
          },
          "intervention_failure": {
            "$ref": "#/$defs/boundedField"
          },
          "symbolic_perspectives": {
            "$ref": "#/$defs/boundedField"
          },
          "decision_integrity": {
            "$ref": "#/$defs/boundedField"
          },
          "epistemic_state": {
            "$ref": "#/$defs/boundedField"
          },
          "latent_multi_history_counterfactual": {
            "$ref": "#/$defs/boundedField"
          },
          "experiment_hardware_request_result": {
            "$ref": "#/$defs/boundedField"
          },
          "exact_head_provenance_digest": {
            "$ref": "#/$defs/boundedField"
          },
          "stop_rollback": {
            "$ref": "#/$defs/boundedField"
          },
          "sensitive_data_network_local_first": {
            "$ref": "#/$defs/boundedField"
          },
          "capability_negotiation": {
            "$ref": "#/$defs/boundedField"
          },
          "request_response_envelope": {
            "$ref": "#/$defs/boundedField"
          },
          "identity_authorization": {
            "$ref": "#/$defs/boundedField"
          },
          "artifact_binding": {
            "$ref": "#/$defs/boundedField"
          },
          "failure_retry_semantics": {
            "$ref": "#/$defs/boundedField"
          },
          "compatibility_policy": {
            "$ref": "#/$defs/boundedField"
          },
          "local_mock_adapter": {
            "$ref": "#/$defs/boundedField"
          },
          "claim_ceiling": {
            "$ref": "#/$defs/boundedField"
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_negotiated",
        "identity_authorized",
        "capability_not_authority",
        "artifact_exact_head_bound",
        "rights_preserved",
        "failure_retry_typed",
        "compatibility_fail_closed",
        "sensitive_local_first",
        "hardware_request_only",
        "no_ecosystem_overclaim",
        "stop_rollback_present"
      ],
      "properties": {
        "version_negotiated": {
          "type": "boolean"
        },
        "identity_authorized": {
          "type": "boolean"
        },
        "capability_not_authority": {
          "type": "boolean"
        },
        "artifact_exact_head_bound": {
          "type": "boolean"
        },
        "rights_preserved": {
          "type": "boolean"
        },
        "failure_retry_typed": {
          "type": "boolean"
        },
        "compatibility_fail_closed": {
          "type": "boolean"
        },
        "sensitive_local_first": {
          "type": "boolean"
        },
        "hardware_request_only": {
          "type": "boolean"
        },
        "no_ecosystem_overclaim": {
          "type": "boolean"
        },
        "stop_rollback_present": {
          "type": "boolean"
        }
      }
    },
    "rule_assertions": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "status",
          "evidence_refs",
          "effect"
        ],
        "properties": {
          "rule_id": {
            "enum": [
              "version_negotiated",
              "identity_authorized",
              "capability_not_authority",
              "artifact_exact_head_bound",
              "rights_preserved",
              "failure_retry_typed",
              "compatibility_fail_closed",
              "sensitive_local_first",
              "hardware_request_only",
              "no_ecosystem_overclaim",
              "stop_rollback_present"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "effect": {
            "enum": [
              "ALLOW_WITHIN_CEILING",
              "BLOCK",
              "DOWNGRADE"
            ]
          }
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "claim_ceiling",
        "history_preserved",
        "external_action_performed"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "history_preserved": {
          "type": "boolean"
        },
        "external_action_performed": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "boundedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "const": "RECORDED"
        },
        "value": {
          "type": [
            "string",
            "boolean",
            "number",
            "array",
            "object",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "artifact",
        "exact_head",
        "artifact_digest",
        "rights_status"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rights_status": {
          "enum": [
            "REPOSITORY_INTERNAL",
            "PUBLIC_METADATA_ONLY"
          ]
        }
      }
    }
  }
}
