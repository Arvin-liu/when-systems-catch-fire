{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/schemas/governance/knowledge-change.schema.json",
  "title": "Meaningful knowledge change",
  "type": "object",
  "required": ["change_id", "date", "change_type", "title", "summary", "status", "sources", "asset_ids", "supersedes", "human_anchor", "record_sha256"],
  "properties": {
    "change_id": {"type": "string", "minLength": 1},
    "date": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
    "change_type": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "asset_ids": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "human_anchor": {"type": "string", "pattern": "^change-[a-z0-9-]+$"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
