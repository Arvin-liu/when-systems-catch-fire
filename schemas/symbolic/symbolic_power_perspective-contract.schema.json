{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SYMBOLIC-SPHERE-I1 Symbolic Object, Power & Multi-Perspective Governance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "capability_id",
    "parent_binding",
    "evidence_registry",
    "records",
    "facts",
    "rule_assertions",
    "conclusion"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "const": "SYMBOLIC-SPHERE-I1"
    },
    "capability_id": {
      "const": "symbolic_power_perspective"
    },
    "parent_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "exact_head"
      ],
      "properties": {
        "task_id": {
          "const": "121Q39-I1"
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "evidence_registry": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "record_type",
          "symbolic_object",
          "material_fact_base",
          "actor_positions",
          "power_forms",
          "meaning_projections",
          "intended_use",
          "actual_use",
          "front_face",
          "suppressed_faces",
          "benefit_cost_distribution",
          "counter_readings",
          "institutionalization_mechanism",
          "symbolic_capture",
          "counter_appropriation",
          "transformation_history",
          "evidence_constraints",
          "claim_ceiling"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "record_type": {
            "enum": [
              "COMMUNITY_FOOTBALL_FIELD",
              "SCHOOL_DATA_POLICY"
            ]
          },
          "symbolic_object": {
            "$ref": "#/$defs/boundedField"
          },
          "material_fact_base": {
            "$ref": "#/$defs/boundedField"
          },
          "actor_positions": {
            "$ref": "#/$defs/boundedField"
          },
          "power_forms": {
            "$ref": "#/$defs/boundedField"
          },
          "meaning_projections": {
            "$ref": "#/$defs/boundedField"
          },
          "intended_use": {
            "$ref": "#/$defs/boundedField"
          },
          "actual_use": {
            "$ref": "#/$defs/boundedField"
          },
          "front_face": {
            "$ref": "#/$defs/boundedField"
          },
          "suppressed_faces": {
            "$ref": "#/$defs/boundedField"
          },
          "benefit_cost_distribution": {
            "$ref": "#/$defs/boundedField"
          },
          "counter_readings": {
            "$ref": "#/$defs/boundedField"
          },
          "institutionalization_mechanism": {
            "$ref": "#/$defs/boundedField"
          },
          "symbolic_capture": {
            "$ref": "#/$defs/boundedField"
          },
          "counter_appropriation": {
            "$ref": "#/$defs/boundedField"
          },
          "transformation_history": {
            "$ref": "#/$defs/boundedField"
          },
          "evidence_constraints": {
            "$ref": "#/$defs/boundedField"
          },
          "claim_ceiling": {
            "$ref": "#/$defs/boundedField"
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_truth_separate",
        "ownership_not_truth",
        "popularity_not_truth",
        "institution_not_fact",
        "all_actors_present",
        "costs_visible",
        "intent_effect_separate",
        "interpretive_power_not_legitimacy",
        "no_causal_totalization",
        "history_append_only",
        "evidence_constrained",
        "claim_ceiling_preserved"
      ],
      "properties": {
        "material_truth_separate": {
          "type": "boolean"
        },
        "ownership_not_truth": {
          "type": "boolean"
        },
        "popularity_not_truth": {
          "type": "boolean"
        },
        "institution_not_fact": {
          "type": "boolean"
        },
        "all_actors_present": {
          "type": "boolean"
        },
        "costs_visible": {
          "type": "boolean"
        },
        "intent_effect_separate": {
          "type": "boolean"
        },
        "interpretive_power_not_legitimacy": {
          "type": "boolean"
        },
        "no_causal_totalization": {
          "type": "boolean"
        },
        "history_append_only": {
          "type": "boolean"
        },
        "evidence_constrained": {
          "type": "boolean"
        },
        "claim_ceiling_preserved": {
          "type": "boolean"
        }
      }
    },
    "rule_assertions": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "status",
          "evidence_refs",
          "effect"
        ],
        "properties": {
          "rule_id": {
            "enum": [
              "material_truth_separate",
              "ownership_not_truth",
              "popularity_not_truth",
              "institution_not_fact",
              "all_actors_present",
              "costs_visible",
              "intent_effect_separate",
              "interpretive_power_not_legitimacy",
              "no_causal_totalization",
              "history_append_only",
              "evidence_constrained",
              "claim_ceiling_preserved"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "effect": {
            "enum": [
              "ALLOW_WITHIN_CEILING",
              "BLOCK",
              "DOWNGRADE"
            ]
          }
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "claim_ceiling",
        "history_preserved",
        "external_action_performed"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "history_preserved": {
          "type": "boolean"
        },
        "external_action_performed": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "boundedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "const": "RECORDED"
        },
        "value": {
          "type": [
            "string",
            "boolean",
            "number",
            "array",
            "object",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "artifact",
        "exact_head",
        "artifact_digest",
        "rights_status"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rights_status": {
          "enum": [
            "REPOSITORY_INTERNAL",
            "PUBLIC_METADATA_ONLY"
          ]
        }
      }
    }
  }
}
