{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/data/schemas/discovery.schema.json",
  "title": "Discovery",
  "type": "object",
  "required": [
    "id",
    "type",
    "status",
    "title",
    "summary",
    "related_functions",
    "related_cases",
    "source_notes",
    "mathematical_formalization",
    "mathematical_derivation",
    "human_explanation_path",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "discovery"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "$ref": "#/$defs/bilingualNullableText"
    },
    "summary": {
      "$ref": "#/$defs/bilingualNullableText"
    },
    "related_functions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "related_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caseRelation"
      }
    },
    "source_notes": {
      "type": "array"
    },
    "mathematical_formalization": {
      "$ref": "#/$defs/mathFormalization"
    },
    "mathematical_derivation": {
      "$ref": "#/$defs/mathDerivation"
    },
    "human_explanation_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "const": "CC-BY-NC-4.0"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "bilingualNullableText": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": [
            "string",
            "null"
          ]
        },
        "en": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "function_id",
        "path"
      ],
      "properties": {
        "function_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "unresolved": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "caseRelation": {
      "type": "object",
      "required": [
        "case_id",
        "path"
      ],
      "properties": {
        "case_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "unresolved": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "mathFormalization": {
      "type": "object",
      "required": ["symbol", "math_expression", "domain", "codomain", "validity_condition"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "math_expression": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "codomain": {"type": "string", "minLength": 1},
        "validity_condition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "mathDerivation": {
      "type": "object",
      "required": ["status", "kind", "steps_math", "forward_check", "reverse_check", "convergence"],
      "properties": {
        "status": {"const": "converged"},
        "kind": {"type": "string", "minLength": 1},
        "steps_math": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "forward_check": {"type": "object"},
        "reverse_check": {"type": "object"},
        "convergence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  }
}
