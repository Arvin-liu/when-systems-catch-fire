{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/schemas/publication_universe.schema.json",
  "title": "Publication Universe Index",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "status",
      "priority",
      "forms",
      "entry",
      "evidence_level",
      "content_license"
    ],
    "properties": {
      "id": {"type": "string", "pattern": "^PUB-[A-Z0-9-]+$"},
      "title": {"type": "string", "minLength": 2},
      "subtitle": {"type": "string"},
      "status": {"type": "string", "enum": ["active", "candidate", "archived", "draft"]},
      "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
      "forms": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "enum": ["essay", "series", "book", "chapter_set", "front_end_card"]}
      },
      "entry": {"type": "string"},
      "evidence_level": {"type": "string", "enum": ["L1", "L2", "L3", "L4", "L5"]},
      "content_license": {"type": "string", "enum": ["CC-BY-NC-SA-4.0", "mixed", "pending"]},
      "notes": {"type": "string"}
    }
  }
}
