{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Normalized JSONL v1",
  "description": "Schema for project-level normalized JSONL data layer",
  "definitions": {
    "common_fields": {
      "id": {"type": "string"},
      "object_class": {"type": "string"},
      "canonical_source": {"type": "string"},
      "canonical_page": {"type": ["string", "null"]},
      "schema_version": {"type": "string", "const": "normalized-jsonl-v1"},
      "generated_at": {"type": "string", "format": "date-time"},
      "source_commit": {"type": "string"},
      "source_sha": {"type": "string"},
      "inference_not_conclusion": {"type": "boolean", "const": true}
    }
  },
  "functions": {
    "type": "object",
    "required": ["id", "object_class", "name", "definition", "expression", "derivation", "related_cases", "extended_notes", "canonical_source", "schema_version", "generated_at", "source_commit", "source_sha", "inference_not_conclusion"],
    "properties": {
      "id": {"type": "string"},
      "object_class": {"type": "string", "const": "function"},
      "name": {"type": "string"},
      "name_en": {"type": ["string", "null"]},
      "definition": {"type": "string"},
      "definition_en": {"type": ["string", "null"]},
      "expression": {"type": "string"},
      "derivation": {"type": "string"},
      "related_cases": {"type": "array", "items": {"type": "string"}},
      "extended_notes": {"type": "string"},
      "canonical_source": {"type": "string"},
      "canonical_page": {"type": ["string", "null"]},
      "schema_version": {"type": "string", "const": "normalized-jsonl-v1"},
      "generated_at": {"type": "string", "format": "date-time"},
      "source_commit": {"type": "string"},
      "source_sha": {"type": "string"},
      "inference_not_conclusion": {"type": "boolean", "const": true}
    }
  },
  "cases": {
    "type": "object",
    "required": ["id", "object_class", "get_brain_alias", "layer", "grid", "status", "core_function", "core_functions", "description", "key_discovery", "related_functions", "canonical_source", "schema_version", "generated_at", "source_commit", "source_sha", "inference_not_conclusion"],
    "properties": {
      "id": {"type": "string"},
      "object_class": {"type": "string", "const": "case"},
      "get_brain_alias": {"type": "string"},
      "layer": {"type": "string"},
      "grid": {"type": "string"},
      "status": {"type": "string"},
      "core_function": {"type": "string"},
      "core_functions": {"type": "array", "items": {"type": "string"}},
      "description": {"type": "string"},
      "description_en": {"type": ["string", "null"]},
      "key_discovery": {"type": "string"},
      "related_functions": {"type": "array", "items": {"type": "string"}},
      "entailment_status": {"type": "string", "const": "non_entailing"},
      "canonical_source": {"type": "string"},
      "canonical_page": {"type": ["string", "null"]},
      "schema_version": {"type": "string", "const": "normalized-jsonl-v1"},
      "generated_at": {"type": "string", "format": "date-time"},
      "source_commit": {"type": "string"},
      "source_sha": {"type": "string"},
      "inference_not_conclusion": {"type": "boolean", "const": true}
    }
  },
  "effect_leads": {
    "type": "object",
    "required": ["id", "object_class", "current_label", "suggested_class", "name", "definition", "expression", "derivation", "related_functions", "related_cases", "audit_reason_zh", "audit_reason_en", "should_keep_eff_id", "should_migrate_now", "is_likely_misnumbered", "status", "canonical_source", "schema_version", "generated_at", "source_commit", "source_sha", "inference_not_conclusion"],
    "properties": {
      "id": {"type": "string"},
      "object_class": {"type": "string", "const": "effect_lead"},
      "current_label": {"type": "string", "const": "effect_lead"},
      "suggested_class": {"type": "string"},
      "name": {"type": "string"},
      "name_en": {"type": ["string", "null"]},
      "definition": {"type": "string"},
      "expression": {"type": "string"},
      "derivation": {"type": "string"},
      "related_functions": {"type": "array", "items": {"type": "string"}},
      "related_cases": {"type": "array", "items": {"type": "string"}},
      "audit_reason_zh": {"type": "string"},
      "audit_reason_en": {"type": "string"},
      "should_keep_eff_id": {"type": "boolean"},
      "should_migrate_now": {"type": "boolean"},
      "is_likely_misnumbered": {"type": "boolean"},
      "status": {"type": "string", "const": "lead"},
      "canonical_source": {"type": "string"},
      "canonical_page": {"type": ["string", "null"]},
      "schema_version": {"type": "string", "const": "normalized-jsonl-v1"},
      "generated_at": {"type": "string", "format": "date-time"},
      "source_commit": {"type": "string"},
      "source_sha": {"type": "string"},
      "inference_not_conclusion": {"type": "boolean", "const": true}
    }
  }
}
