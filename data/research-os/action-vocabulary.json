  "generated_by": "Checkpoint A draft",
  "description": "Finite, inspectable next-action vocabulary for the Research OS scheduler. These 24 actions are the contract-mandated minimum. The scheduler selects from this closed vocabulary; LLM-generated proposals are only permitted as optional candidate inputs and never as the sole selector or validator. Each action declares the gap codes it typically resolves, whether it is reversible, whether it requires human judgment, and a cost class.",
  "categories": {
    "QUESTION": "narrow or freeze the research question",
    "SOURCE": "locate primary sources and provenance",
    "READ": "read full text, methods or supplement",
    "COMPUTE": "recompute or reproduce numeric/analytic results",
    "RECONCILE": "build crosswalks and compare constructs",
    "DEPENDENCE": "assess source-chain independence",
    "REPLICATION": "seek replication / null / contradictory evidence",
    "CHALLENGE": "methodological critique and alternative mechanisms",
    "REVIEW": "adversarial claim and claim-ceiling review",
    "CLAIM": "downgrade or branch a claim",
    "CONTROL": "pause / checkpoint control-flow actions",
    "ESCALATION": "escalate to human (GPT/owner)",
    "STOP": "stop with insufficient evidence",
    "PUBLISH": "assemble candidate publication packet"
  },
  "actions": [
