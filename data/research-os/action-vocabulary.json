    {"code": "PAUSE_AND_CHECKPOINT", "category": "CONTROL", "reversible": true, "requires_human": false, "cost_class": "low", "typical_gaps": ["NO_INFORMATION_GAIN"], "description": "Pause at a budget/interrupt boundary and write a resumable checkpoint."},
    {"code": "ESCALATE_TO_GPT_OWNER", "category": "ESCALATION", "reversible": false, "requires_human": true, "cost_class": "low", "typical_gaps": ["HUMAN_JUDGMENT_REQUIRED", "CLAIM_EXCEEDS_EVIDENCE"], "description": "Escalate to GPT/owner for value, high-stakes or exceptional adjudication."},
    {"code": "STOP_WITH_INSUFFICIENT_EVIDENCE", "category": "STOP", "reversible": false, "requires_human": false, "cost_class": "low", "typical_gaps": ["NEGATIVE_EVIDENCE_NOT_SEARCHED", "REPLICATION_STATUS_UNKNOWN"], "description": "Stop with a reliable insufficient-evidence / honest-null conclusion."},
    {"code": "PUBLISH_CANDIDATE_PACKET", "category": "PUBLISH", "reversible": false, "requires_human": true, "cost_class": "low", "typical_gaps": ["ADVERSARIAL_REVIEW_MISSING", "CLAIM_EXCEEDS_EVIDENCE"], "description": "Assemble the candidate publication packet; only after review gates and claim-ceiling bound, never self-approved by the executor."}
