    {"code": "SEARCH_PRIMARY_SOURCE", "category": "SOURCE", "reversible": true, "requires_human": false, "cost_class": "low", "typical_gaps": ["PRIMARY_SOURCE_MISSING", "SOURCE_DEPENDENCE_HIGH"], "description": "Locate the primary source(s) for a material claim."},
    {"code": "FETCH_FULL_TEXT", "category": "READ", "reversible": true, "requires_human": false, "cost_class": "low", "typical_gaps": ["FULL_TEXT_MISSING"], "description": "Retrieve full text of a located primary source."},
    {"code": "READ_METHODS", "category": "READ", "reversible": true, "requires_human": false, "cost_class": "low", "typical_gaps": ["METHODS_OR_SUPPLEMENT_MISSING"], "description": "Read methods section to verify construct and outcome definitions."},
    {"code": "READ_SUPPLEMENT", "category": "READ", "reversible": true, "requires_human": false, "cost_class": "low", "typical_gaps": ["METHODS_OR_SUPPLEMENT_MISSING"], "description": "Read supplementary material, tables and appendices."},
    {"code": "LOCATE_RAW_DATA", "category": "SOURCE", "reversible": true, "requires_human": false, "cost_class": "medium", "typical_gaps": ["RAW_DATA_OR_CODE_MISSING"], "description": "Locate raw data tables or repositories underlying a numeric claim."},
    {"code": "LOCATE_ANALYSIS_CODE", "category": "SOURCE", "reversible": true, "requires_human": false, "cost_class": "medium", "typical_gaps": ["RAW_DATA_OR_CODE_MISSING"], "description": "Locate analysis code used to produce a reported result."},
    {"code": "RECOMPUTE_RESULT", "category": "COMPUTE", "reversible": true, "requires_human": false, "cost_class": "medium", "typical_gaps": ["NUMERIC_CLAIM_NOT_RECOMPUTED", "OBJECT_OR_DENOMINATOR_MISMATCH"], "description": "Independently recompute a numeric claim from located data/code."},
    {"code": "REPRODUCE_ANALYSIS", "category": "COMPUTE", "reversible": true, "requires_human": false, "cost_class": "medium", "typical_gaps": ["NUMERIC_CLAIM_NOT_RECOMPUTED", "RAW_DATA_OR_CODE_MISSING"], "description": "Reproduce the original analysis pipeline end to end."},
    {"code": "BUILD_DEFINITION_CROSSWALK", "category": "RECONCILE", "reversible": true, "requires_human": false, "cost_class": "medium", "typical_gaps": ["OUTCOME_DEFINITION_CONFLICT", "OBJECT_OR_DENOMINATOR_MISMATCH"], "description": "Build a crosswalk mapping differing constructs, outcomes and denominators across sources."},
    {"code": "CHECK_SOURCE_DEPENDENCE", "category": "DEPENDENCE", "reversible": true, "requires_human": false, "cost_class": "low", "typical_gaps": ["SOURCE_DEPENDENCE_HIGH", "TIMESTAMP_BATCH_NOT_PROOF_OF_READING"], "description": "Assess whether sources are independent or derive from a single chain."},
    {"code": "SEEK_REPLICATION", "category": "REPLICATION", "reversible": true, "requires_human": false, "cost_class": "medium", "typical_gaps": ["REPLICATION_STATUS_UNKNOWN"], "description": "Seek replication studies or independent re-analyses."},
    {"code": "SEEK_NULL_OR_CONTRADICTORY_RESULT", "category": "REPLICATION", "reversible": true, "requires_human": false, "cost_class": "medium", "typical_gaps": ["NEGATIVE_EVIDENCE_NOT_SEARCHED"], "description": "Actively search for null or contradictory results."},
    {"code": "SEEK_METHODOLOGICAL_CRITIQUE", "category": "CHALLENGE", "reversible": true, "requires_human": false, "cost_class": "medium", "typical_gaps": ["ADVERSARIAL_REVIEW_MISSING", "NEGATIVE_EVIDENCE_NOT_SEARCHED"], "description": "Seek methodological critique of the study design or analysis."},
    {"code": "COMPARE_POPULATIONS_OR_JURISDICTIONS", "category": "RECONCILE", "reversible": true, "requires_human": false, "cost_class": "low", "typical_gaps": ["POPULATION_SCOPE_MISMATCH"], "description": "Compare populations or jurisdictions to test scope generalizability."},
    {"code": "COMPARE_OUTCOMES_OR_DENOMINATORS", "category": "RECONCILE", "reversible": true, "requires_human": false, "cost_class": "low", "typical_gaps": ["OBJECT_OR_DENOMINATOR_MISMATCH", "OUTCOME_DEFINITION_CONFLICT"], "description": "Compare outcomes or denominators to test comparability."},
    {"code": "TEST_ALTERNATIVE_MECHANISM", "category": "CHALLENGE", "reversible": true, "requires_human": false, "cost_class": "high", "typical_gaps": ["MECHANISM_ALTERNATIVES_UNTESTED", "CAUSAL_IDENTIFICATION_MISSING"], "description": "Test an alternative mechanism explanation for the observed association."},
    {"code": "RUN_ADVERSARIAL_REVIEW", "category": "REVIEW", "reversible": true, "requires_human": false, "cost_class": "medium", "typical_gaps": ["ADVERSARIAL_REVIEW_MISSING", "CLAIM_EXCEEDS_EVIDENCE"], "description": "Run an adversarial review of candidate claims and ceilings."},
    {"code": "DOWNGRADE_CLAIM", "category": "CLAIM", "reversible": true, "requires_human": false, "cost_class": "low", "typical_gaps": ["CLAIM_EXCEEDS_EVIDENCE", "CAUSAL_IDENTIFICATION_MISSING"], "description": "Downgrade a candidate claim or its claim ceiling to match the evidence."},
