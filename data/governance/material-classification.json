{
  "schema_version": "1.0.0",
  "schema_date_HE": "12026年7月19日（人类纪元；对应公元2026年7月19日）",
  "schema_date_ISO": "2026-07-19T00:00:00Z",
  "purpose": "Classification of materials by rights status, publication gate eligibility, and governance requirements.",
  "classification_levels": {
    "L0_public_domain": {
      "level": 0,
      "label": "Public Domain / No Restriction",
      "publication_gate": "PASS",
      "provenance_required": true,
      "permission_required": false
    },
    "L1_project_owned": {
      "level": 1,
      "label": "Project-Owned Content",
      "publication_gate": "PASS",
      "provenance_required": true,
      "permission_required": false,
      "license_applies": "PROJECT_LAYERED_LICENSE"
    },
    "L2_open_license_compliant": {
      "level": 2,
      "label": "Open License (Compliant)",
      "publication_gate": "PASS_WITH_COMPLIANCE",
      "provenance_required": true,
      "permission_required": false,
      "compliance_requirements": [
        "attribution",
        "share_alike",
        "license_inclusion"
      ]
    },
    "L3_fair_dealing_eligible": {
      "level": 3,
      "label": "Fair Dealing / Fair Use Eligible (Limited Quotation)",
      "publication_gate": "CONDITIONAL_PASS",
      "provenance_required": true,
      "permission_required": false,
      "conditions": [
        "only_excerpt_or_quotation",
        "purpose_must_be_criticism_review_commentary_or_research",
        "no_substantial_portion",
        "attribution_required",
        "jurisdiction_analysis_recommended"
      ]
    },
    "L4_permission_required": {
      "level": 4,
      "label": "Permission Required",
      "publication_gate": "BLOCK",
      "provenance_required": true,
      "permission_required": true,
      "permitted_without_permission": [
        "source_citation",
        "brief_quotation_under_fair_dealing_if_applicable"
      ]
    },
    "L5_counsel_required": {
      "level": 5,
      "label": "Counsel Required",
      "publication_gate": "BLOCK",
      "provenance_required": true,
      "permission_required": false,
      "counsel_review_required": true
    },
    "L6_critical_restriction": {
      "level": 6,
      "label": "Critical Restriction — Access-Restricted or Potentially Unauthorized",
      "publication_gate": "BLOCK",
      "provenance_required": true,
      "permission_required": true,
      "additional_restrictions": [
        "no_disclosure_of_access_credentials",
        "no_republishing_of_access_mechanism",
        "written_permission_from_both_rights_holder_and_access_provider_required"
      ]
    }
  },
  "material_type_registry": {
    "external_input": {
      "type": "external_input",
      "definition": "Material obtained from sources outside the project, including third-party publications, course materials, articles, notes, and other external content.",
      "required_fields": [
        "source_category",
        "rights_status",
        "access_method",
        "provenance_chain",
        "publication_gate_decision",
        "risk_level"
      ],
      "classification": "default_L4_to_L6"
    },
    "ignition_increment": {
      "type": "ignition_increment",
      "definition": "Output generated by this project's own operations (analysis, classification, registry entries, gate decisions).",
      "required_fields": [
        "canonical_path",
        "generation_task",
        "version",
        "claim_ceiling",
        "residue",
        "original_source_ref"
      ],
      "classification": "L1_project_owned"
    },
    "project_documentation": {
      "type": "project_documentation",
      "definition": "Documentation, architecture, governance, and explanatory content created for this project.",
      "classification": "L1_project_owned"
    },
    "registry_data": {
      "type": "registry_data",
      "definition": "Machine-readable registry entries, schemas, validators, and operational data.",
      "classification": "L1_project_owned"
    }
  }
}