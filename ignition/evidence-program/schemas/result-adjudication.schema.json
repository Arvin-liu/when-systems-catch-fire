{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/blob/main/ignition/evidence-program/schemas/result-adjudication.schema.json",
  "title": "Result and Adjudication",
  "description": "Outcome of a pilot against preregistered thresholds (Task 103 §8).",
  "type": "object",
  "required": [
    "run_id", "pilot_id", "preregistration_ref", "outcome", "metrics_observed",
    "thresholds_used", "uncertainty_output", "adjudication_basis", "e_axis_decision",
    "propagated_surfaces", "human_readable_ref"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "pilot_id": {"type": "string"},
    "preregistration_ref": {"type": "string"},
    "outcome": {
      "type": "string",
      "enum": [
        "SUPPORTED_WITHIN_SCOPE",
        "PARTIALLY_SUPPORTED",
        "NULL_OR_INCONCLUSIVE",
        "CONTRADICTED_WITHIN_SCOPE",
        "TEST_INVALID_OR_ABORTED"
      ]
    },
    "metrics_observed": {"type": "object"},
    "thresholds_used": {"type": "object", "description": "MUST be byte-identical to preregistration.success_conditions etc. (post-hoc check)."},
    "uncertainty_output": {"type": "string"},
    "adjudication_basis": {"type": "string"},
    "e_axis_decision": {
      "type": "object",
      "required": ["decision", "changed"],
      "properties": {
        "decision": {"type": "string"},
        "changed": {"type": "boolean"},
        "from_level": {"type": "string"},
        "to_level": {"type": "string"}
      }
    },
    "propagated_surfaces": {"type": "array", "items": {"type": "string"}},
    "human_readable_ref": {"type": "string"}
  }
}
