{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/blob/main/ignition/evidence-program/schemas/e-axis-transition.schema.json",
  "title": "E-axis Transition Record",
  "description": "Explicit E-axis promotion/retention driven by a pilot (Task 103 §8).",
  "type": "object",
  "required": ["transition_id", "target_id", "from_level", "to_level", "reason", "justification_ref", "explicit_criteria_met"],
  "properties": {
    "transition_id": {"type": "string"},
    "target_id": {"type": "string"},
    "from_level": {"type": "string", "pattern": "^E[0-9]$"},
    "to_level": {"type": "string", "pattern": "^E[0-9]$"},
    "reason": {"type": "string"},
    "justification_ref": {"type": "string"},
    "explicit_criteria_met": {"type": "boolean", "description": "False => retain prior level (no promotion without criteria, §3.7)."}
  }
}
