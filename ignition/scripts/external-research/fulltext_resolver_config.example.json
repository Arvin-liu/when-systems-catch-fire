{
  "resolver_email": "research@ignition.local",
  "unpaywall_email": "{UNPAYWALL_EMAIL}",
  "openalex_mailto": "{OPENALEX_MAILTO}",
  "user_agent": "ignition-fulltext-resolver/1.0 (mailto:{OPENALEX_MAILTO})",
  "timeout_seconds": 30,
  "retries": 2,
  "delay_between_requests_ms": 500,
  "cache_dir": ".cache/fulltext",
  "providers": [
    "arxiv_html",
    "arxiv_pdf",
    "arxiv_api",
    "ar5iv_html",
    "openalex_oa",
    "crossref",
    "unpaywall",
    "semantic_scholar",
    "europe_pmc",
    "core",
    "neurips",
    "pmlr",
    "acl_anthology",
    "openreview",
    "zenodo",
    "hal",
    "doaj",
    "institutional_repository"
  ],
  "blocked_providers": ["sci_hub", "libgen", "paid_login", "captcha_bypass"],
  "evidence_fields": [
    "source_id",
    "title",
    "authors",
    "year",
    "venue",
    "doi_or_identifier",
    "source_family",
    "access_channel",
    "access_url",
    "access_time_utc",
    "version",
    "license",
    "file_sha256",
    "local_cache_path",
    "content_type",
    "file_size_bytes",
    "page_count",
    "sections",
    "anchors",
    "what_the_paper_supports",
    "what_the_paper_does_not_support",
    "claim_support_status"
  ]
}
