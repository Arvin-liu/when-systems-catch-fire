{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/schemas/epistemic-governance/transition-grammar-r0.schema.json",
  "type": "object",
  "required": ["schema_version", "registry_id", "source_contract", "rules"],
  "properties": {
    "schema_version": {"const": "transition-grammar-r0"},
    "registry_id": {"const": "epistemic-transition-grammar-r0"},
    "source_contract": {"const": "Canonical repository rules are projected; this registry does not invent truth or authority."},
    "rules": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": ["stable_id", "human_label", "source_refs", "domain", "antecedent", "candidate_transition", "forbidden_inference", "required_gate_or_evidence", "allowed_weaker_conclusion", "unknown_retention_rule", "withdrawal_rebound_semantics", "hard_or_soft", "status"],
        "properties": {
          "stable_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "human_label": {"type": "string", "minLength": 3},
          "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
          "domain": {"enum": ["knowledge", "engineering", "publication", "agent", "owner", "cross-cutting"]},
          "antecedent": {"type": "string", "minLength": 20},
          "candidate_transition": {"type": "string", "minLength": 20},
          "forbidden_inference": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
          "required_gate_or_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
          "allowed_weaker_conclusion": {"type": "string", "minLength": 20},
          "unknown_retention_rule": {"type": "string", "minLength": 20},
          "withdrawal_rebound_semantics": {"type": "string", "minLength": 20},
          "hard_or_soft": {"enum": ["HARD_CANONICAL_RULE", "SOFT_RESEARCH_PROJECTION"]},
          "status": {"enum": ["CURRENT", "HISTORICAL"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
