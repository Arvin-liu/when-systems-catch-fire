{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/schemas/epistemic-governance/structural-projections-r0.schema.json",
  "type": "object",
  "required": ["schema_version", "projection_id", "projection_type", "source_surface", "design_intent", "control_properties", "items"],
  "properties": {
    "schema_version": {"const": "structural-projection-r0"},
    "projection_id": {"type": "string", "pattern": "^ESI-[A-Z0-9_]+$"},
    "projection_type": {"enum": ["DELEXICALIZED_STRUCTURE", "TERMINOLOGY_ONLY", "STRUCTURE_BROKEN_CONTROL", "STYLE_MATCHED_CONTROL", "CONCISE_CAPSULE"]},
    "source_surface": {"const": "ignition/data/epistemic-governance/structural-surface-r0.json"},
    "design_intent": {"type": "string", "minLength": 30},
    "control_properties": {
      "type": "object",
      "required": ["relation_preserved", "terminology_preserved", "style_matched", "content_length_chars", "item_count"],
      "properties": {
        "relation_preserved": {"type": "boolean"},
        "terminology_preserved": {"type": "boolean"},
        "style_matched": {"type": "boolean"},
        "content_length_chars": {"type": "integer", "minimum": 0},
        "item_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stable_id", "body"],
        "properties": {"stable_id": {"type": "string"}, "body": {"type": "string", "minLength": 10}},
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
