{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "record_id",
    "stable_id",
    "legacy_id",
    "legacy_path",
    "legacy_blob_sha",
    "reviewed_at",
    "reviewer_model_class",
    "review_method",
    "source_files_read",
    "source_line_anchors",
    "direct_source_status",
    "original_claim_verbatim_or_precise_paraphrase",
    "controlled_semantic_proposition",
    "subject",
    "predicate_or_relation",
    "quantifiers",
    "modality",
    "premises",
    "hidden_premises",
    "scope",
    "boundary_conditions",
    "failure_conditions",
    "counterexample_requirements",
    "formal_object_type",
    "claim_type",
    "logic_form",
    "logic_status",
    "formalization_status",
    "proof_status",
    "evidence_status",
    "provenance_status",
    "related_cases",
    "dependencies",
    "strong_terms_found",
    "allowed_wording",
    "forbidden_wording",
    "open_questions",
    "highest_model_escalation_required",
    "escalation_reason",
    "confidence",
    "review_status",
    "coverage_eligible"
  ],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "stable_id": { "type": "string", "minLength": 1 },
    "legacy_id": { "type": "string", "minLength": 1 },
    "legacy_path": { "type": "string", "minLength": 1 },
    "legacy_blob_sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewed_at": { "type": "string", "minLength": 1 },
    "reviewer_model_class": { "type": "string", "minLength": 1 },
    "review_method": { "const": "FULL_SOURCE_TEXT_REVIEW" },
    "review_status": { "const": "SOURCE_TEXT_SEMANTICALLY_ADJUDICATED" },
    "coverage_eligible": { "const": true },
    "source_files_read": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_line_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "start_line", "end_line"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "start_line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": true
      }
    },
    "direct_source_status": { "type": "string", "minLength": 1 },
    "original_claim_verbatim_or_precise_paraphrase": { "type": "string", "minLength": 1 },
    "controlled_semantic_proposition": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "predicate_or_relation": { "type": "string", "minLength": 1 },
    "quantifiers": { "type": "array", "items": { "type": "string" } },
    "modality": { "type": "string", "minLength": 1 },
    "premises": { "type": "array", "items": { "type": "string" } },
    "hidden_premises": { "type": "array", "items": { "type": "string" } },
    "scope": { "type": "string", "minLength": 1 },
    "boundary_conditions": { "type": "array", "items": { "type": "string" } },
    "failure_conditions": { "type": "array", "items": { "type": "string" } },
    "counterexample_requirements": { "type": "array", "items": { "type": "string" } },
    "formal_object_type": {
      "enum": [
        "FUNCTION",
        "PARTIAL_FUNCTION",
        "PREDICATE",
        "RELATION",
        "STATE_TRANSITION",
        "CAUSAL_MODEL",
        "PROBABILISTIC_MODEL",
        "METRIC",
        "ORDER",
        "OPTIMIZATION_PROBLEM",
        "OPERATOR",
        "ALGORITHM",
        "FORMAL_PROPOSITION",
        "ARGUMENT_SCHEMA",
        "MECHANISM_MODEL",
        "NATURAL_LANGUAGE_CANDIDATE"
      ]
    },
    "claim_type": {
      "enum": [
        "DEFINITION",
        "MATHEMATICAL_PROPOSITION",
        "ALGORITHMIC_CLAIM",
        "EMPIRICAL_ASSOCIATION",
        "EMPIRICAL_CAUSAL_CLAIM",
        "HISTORICAL_INTERPRETATION",
        "STRUCTURAL_ANALOGY",
        "STRICT_ISOMORPHISM_CLAIM",
        "NORMATIVE_CLAIM",
        "PHILOSOPHICAL_CLAIM",
        "EXPLANATORY_HYPOTHESIS",
        "EXTERNAL_THEOREM_REFERENCE"
      ]
    },
    "logic_form": { "type": "string", "minLength": 1 },
    "logic_status": { "type": "string", "minLength": 1 },
    "formalization_status": { "type": "string", "minLength": 1 },
    "proof_status": { "type": "string", "minLength": 1 },
    "evidence_status": { "type": "string", "minLength": 1 },
    "provenance_status": { "type": "string", "minLength": 1 },
    "related_cases": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "strong_terms_found": { "type": "array", "items": { "type": "string" } },
    "allowed_wording": { "type": "array", "items": { "type": "string" } },
    "forbidden_wording": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "highest_model_escalation_required": { "type": "boolean" },
    "escalation_reason": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": true
}
