{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "escalation_id",
    "stable_id",
    "category",
    "status",
    "legacy_path",
    "source_files",
    "source_line_anchors",
    "original_claim",
    "candidate_interpretations",
    "known_evidence",
    "question_for_highest_model",
    "forbidden_mechanical_actions",
    "created_at"
  ],
  "properties": {
    "escalation_id": { "type": "string", "minLength": 1 },
    "stable_id": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "status": { "const": "PENDING_HIGHEST_MODEL_REVIEW" },
    "legacy_path": { "type": "string", "minLength": 1 },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_line_anchors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "original_claim": { "type": "string", "minLength": 1 },
    "candidate_interpretations": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "known_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "question_for_highest_model": { "type": "string", "minLength": 1 },
    "forbidden_mechanical_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
