{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.invalid/ignition/operations/step11-residual-reclassification-r1.schema.json",
    "title": "IGNITION-130 Step 11 residual reclassification",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "task_id", "source_task_id", "source_receipt", "new_regressions", "residuals", "current_130_rule", "claim_ceiling"],
    "properties": {
        "schema_version": {"const": "step11-residual-reclassification-r1"},
        "task_id": {"const": "IGNITION-20260821-130"},
        "source_task_id": {"const": "IGNITION-20260821-129"},
        "source_receipt": {"type": "string", "minLength": 1},
        "new_regressions": {"const": 0},
        "residuals": {
            "type": "array",
            "minItems": 5,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["residual_id", "classification", "count", "evidence", "action"],
                "properties": {
                    "residual_id": {"type": "string", "minLength": 1},
                    "classification": {"enum": ["PRE_EXISTING_SOURCE_HASH_DRIFT", "HISTORICAL_PROJECTION_RESIDUAL", "ENVIRONMENTAL_TIMEOUT", "ENVIRONMENTAL_LONG_RUNNING_BASELINE"]},
                    "count": {"type": "integer", "minimum": 1},
                    "entries": {"type": "array", "items": {"type": "string", "minLength": 1}},
                    "evidence": {"type": "string", "minLength": 1},
                    "action": {"type": "string", "minLength": 1}
                }
            }
        },
        "current_130_rule": {"type": "string", "minLength": 1},
        "claim_ceiling": {"type": "string", "minLength": 1}
    }
}
