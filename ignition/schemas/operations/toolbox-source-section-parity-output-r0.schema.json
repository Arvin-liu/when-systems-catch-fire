{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolbox-source-section-parity-output-r0.schema.json",
  "title": "Source Section Byte Parity Result R0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_id",
    "tool_version",
    "status",
    "task_id",
    "source_ref",
    "source_ref_authenticated",
    "source_document",
    "candidate_file",
    "source_section",
    "candidate_section",
    "byte_identical",
    "findings",
    "effects",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "toolbox-source-section-parity-result-r0"},
    "tool_id": {"const": "maintenance.compare_source_section_bytes"},
    "tool_version": {"const": "0.1.0"},
    "status": {"enum": ["BYTE_IDENTICAL", "BYTE_DIFFERENT", "INPUT_INVALID", "COMPARE_FAILED"]},
    "task_id": {"type": ["string", "null"]},
    "source_ref": {"type": ["string", "null"]},
    "source_ref_authenticated": {"const": false},
    "source_document": {"$ref": "#/$defs/document_observation"},
    "candidate_file": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["relative_path", "sha256", "byte_count"],
          "properties": {
            "relative_path": {"type": "string"},
            "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "byte_count": {"type": ["integer", "null"], "minimum": 0}
          }
        }
      ]
    },
    "source_section": {"$ref": "#/$defs/section_observation"},
    "candidate_section": {"$ref": "#/$defs/section_observation"},
    "byte_identical": {"type": ["boolean", "null"]},
    "findings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path"],
        "properties": {
          "code": {"type": "string", "minLength": 1, "maxLength": 96},
          "path": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_file_accessed", "files_written", "network", "execution_authorized"],
      "properties": {
        "candidate_file_accessed": {"type": "boolean"},
        "files_written": {"const": false},
        "network": {"const": false},
        "execution_authorized": {"const": false}
      }
    },
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "document_observation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "byte_count"],
          "properties": {
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "byte_count": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "section_observation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_offset_bytes", "end_offset_bytes", "byte_count", "sha256"],
          "properties": {
            "start_offset_bytes": {"type": "integer", "minimum": 0},
            "end_offset_bytes": {"type": "integer", "minimum": 0},
            "byte_count": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    }
  }
}
