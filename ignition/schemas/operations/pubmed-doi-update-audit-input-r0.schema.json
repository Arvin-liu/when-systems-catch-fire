{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ignition:pubmed-doi-update-audit-input-r0",
  "title": "Bounded PubMed DOI Update Audit Input R0",
  "type": "object",
  "additionalProperties": false,
  "required": ["dois"],
  "properties": {
    "dois": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$"
      }
    }
  }
}
