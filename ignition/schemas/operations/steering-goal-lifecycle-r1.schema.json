{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/schemas/operations/steering-goal-lifecycle-r1.schema.json",
  "title": "OS Steering Goal Lifecycle R1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contracts", "goals", "events", "goal_count"],
  "properties": {
    "schema": {"const": "os-steering-intent-obligation-r1.goal-registry"},
    "contracts": {"type": "array", "items": {"type": "object", "required": ["contract_id", "acceptance_predicates", "required_evidence_types", "completion_authority", "forbidden_shortcuts"], "properties": {"contract_id": {"type": "string"}, "acceptance_predicates": {"type": "array", "minItems": 1}, "required_evidence_types": {"type": "array", "minItems": 1}, "completion_authority": {"type": "string"}, "forbidden_shortcuts": {"type": "array"}, "review_window_ref": {"type": ["string", "null"]}}}},
    "goals": {"type": "array", "items": {"type": "object", "required": ["goal_id", "intent_id", "statement", "namespace", "completion_contract_id", "provenance", "status", "version", "created_at", "updated_at"], "properties": {"goal_id": {"type": "string"}, "intent_id": {"type": "string"}, "statement": {"type": "string"}, "namespace": {"type": "string"}, "completion_contract_id": {"type": "string"}, "provenance": {"type": "object"}, "status": {"enum": ["PROPOSED", "ACTIVE", "PAUSED", "BLOCKED", "SATISFIED", "ABANDONED", "SUPERSEDED", "FAILED_BOUNDED"]}, "version": {"type": "integer", "minimum": 1}, "parent_goal_id": {"type": ["string", "null"]}, "supersedes_goal_id": {"type": ["string", "null"]}, "created_at": {"type": "string"}, "updated_at": {"type": "string"}}}},
    "events": {"type": "array", "items": {"type": "object"}},
    "goal_count": {"type": "integer", "minimum": 0}
  }
}
