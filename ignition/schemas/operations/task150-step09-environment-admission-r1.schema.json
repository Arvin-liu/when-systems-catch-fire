{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/task150-step09-environment-admission-r1.schema.json",
  "title": "Task150 Step09 environment admission without forced installation",
  "description": "Defines bounded read-only admission when a provider is present and typed unavailable results when it is absent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "step", "record_type", "status", "formal_previous_commit", "environment_observation", "admission_policy", "simulated_admission_cases", "scope_freeze", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "ignition-150-step09-environment-admission-r1"},
    "task_id": {"const": "IGNITION-20260901-150"},
    "step": {"const": "09"},
    "record_type": {"const": "ENVIRONMENT_ADMISSION_NO_INSTALL"},
    "status": {"const": "ENVIRONMENT_ADMISSION_POLICY_PASS_NO_FORCED_INSTALL"},
    "formal_previous_commit": {"const": "eb649e6dbd9c3bd09e3a0a4bd36d03bc997b6e2b"},
    "environment_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "provider"],
      "properties": {
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "path", "version"],
          "properties": {"available":{"const":true},"path":{"const":"/Users/zhiyuan/.local/bin/node"},"version":{"const":"v22.23.0"}}
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "available", "revision", "package_version", "doctor"],
          "properties": {"id":{"const":"archify"},"available":{"const":true},"revision":{"const":"7a16d30322f5bd09c832386faa95d8c9a933f0c0"},"package_version":{"const":"2.17.0-dev.0"},"doctor":{"const":"PASS"}}
        }
      }
    },
    "admission_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present_provider", "absent_provider", "absent_node", "alternate_provider", "automatic_system_install", "skill_install", "scope"],
      "properties": {
        "present_provider": {"const":"RUN_BOUNDED_READ_ONLY"},
        "absent_provider": {"const":"PROVIDER_UNAVAILABLE_IN_CURRENT_ENVIRONMENT"},
        "absent_node": {"const":"PROVIDER_UNAVAILABLE_IN_CURRENT_ENVIRONMENT"},
        "alternate_provider": {"const":"ROUTE_ONLY_IF_EXPLICITLY_ADMITTED"},
        "automatic_system_install": {"const":false},
        "skill_install": {"const":"EXPLICIT_REQUEST_ONLY"},
        "scope": {"const":"PROVIDER_SELECTION_IS_NOT_PERMISSION"}
      }
    },
    "simulated_admission_cases": {
      "type": "array",
      "const": [
        {"id":"provider-present-node-present","provider_present":true,"node_present":true,"result":"RUN_BOUNDED_READ_ONLY","system_install":false},
        {"id":"provider-absent","provider_present":false,"node_present":true,"result":"PROVIDER_UNAVAILABLE_IN_CURRENT_ENVIRONMENT","system_install":false},
        {"id":"node-absent","provider_present":true,"node_present":false,"result":"PROVIDER_UNAVAILABLE_IN_CURRENT_ENVIRONMENT","system_install":false},
        {"id":"both-absent","provider_present":false,"node_present":false,"result":"PROVIDER_UNAVAILABLE_IN_CURRENT_ENVIRONMENT","system_install":false}
      ],
      "items": {"$ref":"#/$defs/case"}
    },
    "scope_freeze": {
      "type":"object",
      "additionalProperties":false,
      "required":["task150_scope","agent_reach","authenticated_channels","installation","live_external_invocation","current_admission"],
      "properties": {
        "task150_scope":{"const":"ARCHIFY_ONLY"},
        "agent_reach":{"const":"NO_CHANGE"},
        "authenticated_channels":{"const":"NO_AUTHENTICATED_ADMISSION"},
        "installation":{"const":"NO_INSTALL_OR_AUTO_UPGRADE"},
        "live_external_invocation":{"const":"UNCHANGED_OPEN_OWNER_DEFERRED_NOT_RUN"},
        "current_admission":{"const":"NOT_ADMITTED"}
      }
    },
    "claim_ceiling": {"const":"Task150 Step09 proves only a bounded environment-admission policy and observation that the current host already has the pinned provider/runtime. It does not require or perform installation, establish a Current capability, authorize a provider, silently substitute another provider, change Agent Reach, admit authentication, resolve the Step04 Delta-shell blocker, establish architecture truth, prove external truth or complete live external invocation."}
  },
  "$defs": {
    "case": {
      "type":"object",
      "additionalProperties":false,
      "required":["id","provider_present","node_present","result","system_install"],
      "properties": {
        "id":{"type":"string"},
        "provider_present":{"type":"boolean"},
        "node_present":{"type":"boolean"},
        "result":{"enum":["RUN_BOUNDED_READ_ONLY","PROVIDER_UNAVAILABLE_IN_CURRENT_ENVIRONMENT"]},
        "system_install":{"const":false}
      }
    }
  }
}
