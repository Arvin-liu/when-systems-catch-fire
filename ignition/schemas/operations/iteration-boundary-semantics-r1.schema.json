{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://when-systems-catch-fire.invalid/schemas/operations/iteration-boundary-semantics-r1.schema.json",
  "title": "Iteration Boundary Semantics R1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "semantic_status", "field_order", "fields", "compatibility_policy", "separation", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "iteration-boundary-semantics-r1"},
    "contract_id": {"const": "ITERATION_BOUNDARY_SEMANTICS_INVARIANT"},
    "semantic_status": {"const": "CURRENT"},
    "field_order": {
      "type": "array",
      "const": [
        "current_formal_task_id",
        "current_formal_task_ordinal",
        "latest_architecture_changing_task_id",
        "latest_architecture_task_ordinal",
        "current_method_version",
        "current_iteration_boundary"
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_formal_task_id",
        "current_formal_task_ordinal",
        "latest_architecture_changing_task_id",
        "latest_architecture_task_ordinal",
        "current_method_version",
        "current_iteration_boundary"
      ],
      "properties": {
        "current_formal_task_id": {"$ref": "#/$defs/field"},
        "current_formal_task_ordinal": {"$ref": "#/$defs/field"},
        "latest_architecture_changing_task_id": {"$ref": "#/$defs/field"},
        "latest_architecture_task_ordinal": {"$ref": "#/$defs/field"},
        "current_method_version": {"$ref": "#/$defs/field"},
        "current_iteration_boundary": {"$ref": "#/$defs/field"}
      }
    },
    "compatibility_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_iteration_boundary"],
      "properties": {
        "current_iteration_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "alias_of", "current_source", "historical_records", "new_consumers"],
          "properties": {
            "status": {"const": "DEPRECATED_COMPATIBILITY_ALIAS"},
            "alias_of": {"const": "current_formal_task_ordinal"},
            "current_source": {"const": "iteration-boundary-semantics-r1"},
            "historical_records": {"type": "string", "minLength": 1},
            "new_consumers": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "separation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal_and_architecture_ordinals_are_independent", "equality_required", "valid_example", "invalid_rule"],
      "properties": {
        "formal_and_architecture_ordinals_are_independent": {"const": true},
        "equality_required": {"const": false},
        "valid_example": {
          "type": "object",
          "additionalProperties": false,
          "required": ["current_formal_task_id", "current_formal_task_ordinal", "latest_architecture_changing_task_id", "latest_architecture_task_ordinal", "current_iteration_boundary"],
          "properties": {
            "current_formal_task_id": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]+$"},
            "current_formal_task_ordinal": {"type": "integer", "minimum": 1},
            "latest_architecture_changing_task_id": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]+$"},
            "latest_architecture_task_ordinal": {"type": "integer", "minimum": 1},
            "current_iteration_boundary": {"type": "integer", "minimum": 1}
          }
        },
        "invalid_rule": {"type": "string", "minLength": 1}
      }
    },
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "authority_class"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "json_pointer": {"type": "string", "pattern": "^(|/.*)$"},
        "marker": {"type": "string", "minLength": 1},
        "authority_class": {"type": "string", "minLength": 1}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "value_type", "derivation", "lifecycle", "compatibility"],
      "properties": {
        "definition": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "source_role": {"type": "string", "minLength": 1},
        "value_type": {"enum": ["task_id", "integer", "version"]},
        "derivation": {"type": "string", "minLength": 1},
        "lifecycle": {"type": "string", "minLength": 1},
        "compatibility": {"type": "string", "minLength": 1},
        "status": {"enum": ["DEPRECATED_COMPATIBILITY_ALIAS"]},
        "deprecated": {"const": true},
        "must_equal": {"type": "string", "minLength": 1}
      }
    }
  }
}
