{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/current-snapshot-r1.schema.json",
  "title": "Ignition deterministic Current Surface snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "source_policy", "generated_from_source_digest", "identity", "current_method_version", "current_operating_method", "current_task", "task_identity", "iteration_identity", "latest_architecture_changing_task", "map", "engineering_status", "task_lineage", "formal_task_lifecycle", "open_obligations", "release_lifecycle", "active_architecture_overlays", "live_external_ceiling", "live_state_dimensions", "live_attempt_projection", "architecture_counts", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "current-snapshot-r1"},
    "contract_id": {"const": "CURRENT_SURFACE_NO_SPLIT_BRAIN_INVARIANT"},
    "source_policy": {"type": "object", "additionalProperties": false, "required": ["kind", "commit_sha_policy", "registry_path"], "properties": {"kind": {"const": "DETERMINISTIC_CANONICAL_SOURCE_PROJECTION"}, "commit_sha_policy": {"type": "string", "minLength": 1}, "registry_path": {"type": "string", "minLength": 1}}},
    "generated_from_source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {"$ref": "#/$defs/identity"},
    "current_method_version": {"type": "string", "minLength": 1},
    "current_operating_method": {"$ref": "#/$defs/operatingMethod"},
    "current_task": {"$ref": "#/$defs/task"},
    "task_identity": {"$ref": "#/$defs/taskIdentity"},
    "iteration_identity": {"$ref": "#/$defs/iterationIdentity"},
    "latest_architecture_changing_task": {"type": "string", "pattern": "^IGNITION-[0-9A-Z-]+$"},
    "map": {"$ref": "#/$defs/map"},
    "engineering_status": {"$ref": "#/$defs/status"},
    "task_lineage": {"$ref": "#/$defs/lineage"},
    "formal_task_lifecycle": {"$ref": "#/$defs/formalTaskLifecycle"},
    "open_obligations": {"$ref": "#/$defs/openObligations"},
    "active_architecture_overlays": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/overlay"}},
    "live_external_ceiling": {"type": "string", "minLength": 1},
    "live_state_dimensions": {"$ref": "#/$defs/liveStateDimensions"},
    "live_attempt_projection": {"$ref": "#/$defs/liveAttemptProjection"},
    "architecture_counts": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["string", "integer", "number"]}},
    "release_lifecycle": {"type": "object", "additionalProperties": false, "required": ["task_id", "content_phase", "required_publication_ref", "publication_authority", "embedded_publication_assertion", "post_publication_check_required"], "properties": {"task_id": {"type": "string", "pattern": "^IGNITION-[0-9A-Z-]+$"}, "content_phase": {"type": "string", "minLength": 1}, "required_publication_ref": {"const": "refs/heads/main"}, "publication_authority": {"const": "REMOTE_REF_OBSERVATION"}, "embedded_publication_assertion": {"const": "NONE"}, "post_publication_check_required": {"const": true}}},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "identity": {"type": "object", "additionalProperties": false, "required": ["epoch", "system_role", "driver_role", "external_executor_role", "reference_executor_role"], "properties": {"epoch": {"type": "string", "minLength": 1}, "system_role": {"type": "string", "minLength": 1}, "driver_role": {"type": "string", "minLength": 1}, "external_executor_role": {"type": "string", "minLength": 1}, "reference_executor_role": {"type": "string", "minLength": 1}}},
    "operatingMethod": {"type": "object", "additionalProperties": false, "required": ["identity", "version", "status", "source_path"], "properties": {"identity": {"const": "IGNITION_OPERATING_METHOD_R1"}, "version": {"const": "1.0.0"}, "status": {"const": "CURRENT_CANDIDATE_ON_DRAFT"}, "source_path": {"const": "ignition/OPERATING-METHOD.md"}}},
    "task": {"type": "object", "additionalProperties": false, "required": ["task_id", "scope", "execution_status", "terminal", "identity_impact"], "properties": {"task_id": {"type": "string", "pattern": "^IGNITION-[0-9A-Z-]+$"}, "scope": {"type": "string", "minLength": 1}, "execution_status": {"type": "string", "minLength": 1}, "terminal": {"type": "boolean"}, "identity_impact": {"type": "string", "minLength": 1}}},
    "map": {"type": "object", "additionalProperties": false, "required": ["current_version", "historical_versions", "source_path", "projection_status"], "properties": {"current_version": {"type": "string", "minLength": 1}, "historical_versions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "source_path": {"type": "string", "minLength": 1}, "projection_status": {"type": "string", "minLength": 1}}},
    "status": {"type": "object", "additionalProperties": false, "required": ["current_state_status", "epistemically_accepted"], "properties": {"current_state_status": {"type": "string", "minLength": 1}, "epistemically_accepted": {"const": 0}}},
    "lineage": {"type": "object", "additionalProperties": false, "required": ["current_task_id", "current_task_status", "predecessor_status", "predecessor_requirement_lineage", "successor_status", "claim_ceiling"], "properties": {"current_task_id": {"type": "string", "pattern": "^IGNITION-[0-9A-Z-]+$"}, "current_task_status": {"type": "string", "minLength": 1}, "predecessor_status": {"type": "string", "minLength": 1}, "predecessor_requirement_lineage": {"type": "string", "minLength": 1}, "successor_status": {"type": "string", "minLength": 1}, "claim_ceiling": {"type": "string", "minLength": 1}}},
    "formalTaskLifecycle": {"type": "object", "additionalProperties": false, "required": ["authority", "source_path", "current_task_id", "current_task_status", "current_task_terminal", "scope_complete", "open_obligation_ids", "terminal_task_history"], "properties": {"authority": {"const": "FORMAL_TASK_LIFECYCLE"}, "source_path": {"type": "string", "minLength": 1}, "current_task_id": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"}, "current_task_status": {"type": "string", "minLength": 1}, "current_task_terminal": {"type": "boolean"}, "scope_complete": {"type": "boolean"}, "open_obligation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "terminal_task_history": {"type": "array", "items": {"$ref": "#/$defs/terminalTask"}, "uniqueItems": true}}},
    "terminalTask": {"type": "object", "additionalProperties": false, "required": ["task_id", "execution_status", "terminal"], "properties": {"task_id": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"}, "execution_status": {"type": "string", "minLength": 1}, "terminal": {"const": true}}},
    "openObligations": {"type": "object", "additionalProperties": false, "required": ["authority", "source_path", "current_task_id", "open_count", "open_obligation_ids", "next_eligible_actions"], "properties": {"authority": {"const": "OPEN_OBLIGATION_REGISTRY"}, "source_path": {"type": "string", "minLength": 1}, "current_task_id": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"}, "open_count": {"type": "integer", "minimum": 0}, "open_obligation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "next_eligible_actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}},
    "taskIdentity": {"type": "object", "additionalProperties": false, "required": ["current_formal_task", "latest_architecture_changing_task", "release_candidate_task", "publication_witness_task", "previous_canonical_current_task", "previous_formal_task"], "properties": {"current_formal_task": {"type": "string", "pattern": "^IGNITION-[0-9A-Z-]+$"}, "latest_architecture_changing_task": {"type": "string", "pattern": "^IGNITION-[0-9A-Z-]+$"}, "release_candidate_task": {"type": "string", "pattern": "^IGNITION-[0-9A-Z-]+$"}, "publication_witness_task": {"type": "string", "pattern": "^IGNITION-[0-9A-Z-]+$"}, "previous_canonical_current_task": {"type": "string", "pattern": "^IGNITION-[0-9A-Z-]+$"}, "previous_formal_task": {"type": "string", "pattern": "^IGNITION-[0-9A-Z-]+$"}}},
    "iterationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_formal_task_id", "current_formal_task_ordinal", "latest_architecture_changing_task_id", "latest_architecture_task_ordinal", "current_method_version", "current_iteration_boundary", "current_iteration_boundary_semantics"],
      "properties": {
        "current_formal_task_id": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"},
        "current_formal_task_ordinal": {"type": "integer", "minimum": 1},
        "latest_architecture_changing_task_id": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"},
        "latest_architecture_task_ordinal": {"type": "integer", "minimum": 1},
        "current_method_version": {"type": "string", "minLength": 1},
        "current_iteration_boundary": {"type": "integer", "minimum": 1},
        "current_iteration_boundary_semantics": {"const": "DEPRECATED_COMPATIBILITY_ALIAS_OF_CURRENT_FORMAL_TASK_ORDINAL"}
      }
    },
    "overlay": {"type": "object", "additionalProperties": false, "required": ["overlay_id", "label", "source_paths", "authority", "status"], "properties": {"overlay_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}, "label": {"type": "string", "minLength": 1}, "source_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "authority": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}}},
    "liveStateDimensions": {"type": "object", "additionalProperties": false, "required": ["schema_version", "live_dispatch_observation_status", "live_process_observation_status", "inference_observation_status", "validated_completion_status", "reconciliation_blocker_status", "next_eligible_action"], "properties": {"schema_version": {"const": "live-state-dimensions-r1"}, "live_dispatch_observation_status": {"type": "string", "minLength": 1}, "live_process_observation_status": {"type": "string", "minLength": 1}, "inference_observation_status": {"type": "string", "minLength": 1}, "validated_completion_status": {"type": "string", "minLength": 1}, "reconciliation_blocker_status": {"type": "string", "minLength": 1}, "next_eligible_action": {"type": "string", "minLength": 1}}},
    "liveAttemptProjection": {
      "type": "object", "additionalProperties": false,
      "required": ["source_path", "projection_digest", "total_attempts", "validated_completion_count", "unreconciled_count", "observation_incomplete_count", "current_live_ceiling", "obligation_state", "unreconciled_attempt_ids", "next_action_status", "next_action"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "projection_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "total_attempts": {"type": "integer", "minimum": 0},
        "validated_completion_count": {"type": "integer", "minimum": 0},
        "unreconciled_count": {"type": "integer", "minimum": 0},
        "observation_incomplete_count": {"type": "integer", "minimum": 0},
        "current_live_ceiling": {"type": "string", "minLength": 1},
        "obligation_state": {"enum": ["OPEN", "CLOSED"]},
        "unreconciled_attempt_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "next_action_status": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1}
      }
    }
  }
}
