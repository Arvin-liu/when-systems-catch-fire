    "boundaries": {"type": "object", "additionalProperties": false, "required": ["provider_local_policy_inherited", "provider_output_is_external_truth", "provider_is_global_internet_authority", "provider_capability_is_permission", "current_integration", "production_readiness", "authenticated_channel_admission", "live_external_invocation"], "properties": {"provider_local_policy_inherited": {"const": false}, "provider_output_is_external_truth": {"const": false}, "provider_is_global_internet_authority": {"const": false}, "provider_capability_is_permission": {"const": false}, "current_integration": {"const": "NOT_CURRENT_INTEGRATION"}, "production_readiness": {"const": "NOT_PRODUCTION_READY"}, "authenticated_channel_admission": {"const": "NO_AUTHENTICATED_CHANNEL_ADMISSION"}, "live_external_invocation": {"const": "LIVE_EXTERNAL_INVOCATION_UNCHANGED"}}},
