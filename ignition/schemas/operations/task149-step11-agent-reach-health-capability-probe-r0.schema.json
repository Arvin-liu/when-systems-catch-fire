{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/task149-step11-agent-reach-health-capability-probe-r0.schema.json",
  "title": "Task149 Step11 Agent Reach health and capability probe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "step", "status", "observed_at", "formal_previous_commit", "source_matrix_sha256", "provider_id", "provider_class", "doctor_evidence", "health_semantics", "channel_health", "capability_detection", "safety_evidence", "boundaries", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "ignition-149-step11-agent-reach-health-capability-probe-r0"},
    "task_id": {"const": "IGNITION-20260831-149"},
    "step": {"const": "11"},
    "status": {"const": "HEALTH_CAPABILITY_PROBED"},
    "observed_at": {"type": "string", "minLength": 1},
    "formal_previous_commit": {"$ref": "#/$defs/sha"},
    "source_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "provider_id": {"const": "agent-reach"},
    "provider_class": {"const": "READ_ONLY_SOURCE_ACQUISITION_PROVIDER"},
    "doctor_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "exit_code", "result_sha256", "runtime_version", "result_shape", "observed_channel_count", "pinned_source_status", "doctor_success_is_not_acquisition_success", "isolated_runtime_file_count_after"],
      "properties": {
        "command": {"const": "agent-reach doctor --json"}, "exit_code": {"const": 0}, "result_sha256": {"$ref": "#/$defs/sha256"}, "runtime_version": {"const": "1.5.0"}, "result_shape": {"const": "TOP_LEVEL_CHANNEL_MAP"}, "observed_channel_count": {"const": 15}, "pinned_source_status": {"const": "BLOCKED_DEPENDENCY"}, "doctor_success_is_not_acquisition_success": {"const": true}, "isolated_runtime_file_count_after": {"const": 0}
      }
    },
    "health_semantics": {
      "type": "object", "additionalProperties": false,
      "required": ["ok", "warn", "off", "active_backend_is_not_permission", "detected_backend_is_not_invocation_success", "provider_local_routing_is_not_ignition_policy"],
      "properties": {
        "ok": {"type": "string", "minLength": 1}, "warn": {"type": "string", "minLength": 1}, "off": {"type": "string", "minLength": 1}, "active_backend_is_not_permission": {"const": true}, "detected_backend_is_not_invocation_success": {"const": true}, "provider_local_routing_is_not_ignition_policy": {"const": true}
      }
    },
    "channel_health": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/channel"}},
    "capability_detection": {"type": "array", "minItems": 17, "maxItems": 17, "items": {"$ref": "#/$defs/capability"}},
    "safety_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_is_task_local_ephemeral", "home_xdg_file_count_after", "credential_content_access", "cookie_or_session_access", "system_install", "system_configuration_change", "persistent_provider_config_written", "external_write"],
      "properties": {"runtime_is_task_local_ephemeral": {"const": true}, "home_xdg_file_count_after": {"const": 0}, "credential_content_access": {"const": "NONE"}, "cookie_or_session_access": {"const": false}, "system_install": {"const": false}, "system_configuration_change": {"const": false}, "persistent_provider_config_written": {"const": false}, "external_write": {"const": false}}
    },
    "boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_local_policy_inherited", "provider_capability_is_permission", "provider_output_is_external_truth", "provider_is_global_internet_authority", "current_integration", "production_readiness", "authenticated_channel_admission", "live_external_invocation"],
      "properties": {"provider_local_policy_inherited": {"const": false}, "provider_capability_is_permission": {"const": false}, "provider_output_is_external_truth": {"const": false}, "provider_is_global_internet_authority": {"const": false}, "current_integration": {"const": "NOT_CURRENT_INTEGRATION"}, "production_readiness": {"const": "NOT_PRODUCTION_READY"}, "authenticated_channel_admission": {"const": "NO_AUTHENTICATED_CHANNEL_ADMISSION"}, "live_external_invocation": {"const": "LIVE_EXTERNAL_INVOCATION_UNCHANGED"}}
    },
    "claim_ceiling": {"type": "string", "minLength": 1, "pattern": "\\S"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "channel": {
      "type": "object", "additionalProperties": false,
      "required": ["channel", "declared_backends", "detected_backends", "active_backend", "doctor_status", "environment_availability", "acquisition_status", "authentication_requirement", "reason", "side_effects", "testability", "capability_ids", "provider_local_policy_inherited"],
      "properties": {
        "channel": {"type": "string", "minLength": 1}, "declared_backends": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "detected_backends": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "active_backend": {"type": ["string", "null"]}, "doctor_status": {"enum": ["ok", "warn", "off"]}, "environment_availability": {"enum": ["AVAILABLE_READ_ONLY", "ENVIRONMENT_MISSING", "AUTH_REQUIRED", "OWNER_APPROVAL_REQUIRED", "UNAVAILABLE"]}, "acquisition_status": {"enum": ["AVAILABLE_READ_ONLY", "ENVIRONMENT_MISSING", "AUTH_REQUIRED", "OWNER_APPROVAL_REQUIRED", "UNAVAILABLE"]}, "authentication_requirement": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "side_effects": {"type": "string", "minLength": 1}, "testability": {"type": "string", "minLength": 1}, "capability_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "provider_local_policy_inherited": {"const": false}
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "channel", "scope", "status", "health_basis"],
      "properties": {"capability_id": {"type": "string", "minLength": 1}, "channel": {"type": "string", "minLength": 1}, "scope": {"enum": ["PUBLIC_NO_AUTH_CANDIDATE", "AUTHENTICATED_SESSION_BEARING"]}, "status": {"enum": ["AVAILABLE_READ_ONLY", "ENVIRONMENT_MISSING", "AUTH_REQUIRED", "OWNER_APPROVAL_REQUIRED", "UNAVAILABLE"]}, "health_basis": {"type": "string", "minLength": 1}}
    }
  }
}
