{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/task142-pre-live-gate-r1.schema.json",
  "title": "Task142 pre-live admission gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "step", "status", "decision", "live_authorized", "observed_at", "checks", "missing_conditions", "historical_live_counts", "attempt_policy", "safety", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "task142-pre-live-gate-r1"},
    "task_id": {"const": "IGNITION-20260827-142"},
    "step": {"const": "12"},
    "status": {"const": "PASS_FAIL_CLOSED"},
    "decision": {"const": "SKIPPED_UNSAFE_OR_UNAVAILABLE"},
    "live_authorized": {"const": false},
    "observed_at": {"type": "string", "format": "date-time"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task141_terminality", "obligation_carry_forward", "admission_contract", "offline_conformance", "fresh_census", "public_auth_and_billing", "synthetic_fixture", "workspace_and_runtime_domains", "no_effect_scope", "durable_capture", "exact_validator", "blind_retry_policy"],
      "properties": {
        "task141_terminality": {"const": "PASS"},
        "obligation_carry_forward": {"const": "PASS"},
        "admission_contract": {"const": "PASS"},
        "offline_conformance": {"const": "PASS"},
        "fresh_census": {"const": "PASS"},
        "public_auth_and_billing": {"enum": ["NOT_APPLICABLE_NO_SELECTED_FAMILY", "PASS"]},
        "synthetic_fixture": {"enum": ["NOT_CREATED_NO_SELECTED_FAMILY", "PASS"]},
        "workspace_and_runtime_domains": {"enum": ["NOT_APPLICABLE_NO_SELECTED_FAMILY", "PASS"]},
        "no_effect_scope": {"const": "PASS"},
        "durable_capture": {"enum": ["NOT_APPLICABLE_NO_SELECTED_FAMILY", "PASS"]},
        "exact_validator": {"const": "PASS"},
        "blind_retry_policy": {"const": "PASS"}
      }
    },
    "missing_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "historical_live_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "validated_completion", "unreconciled", "observation_incomplete"],
      "properties": {"attempts": {"const": 6}, "validated_completion": {"const": 0}, "unreconciled": {"const": 0}, "observation_incomplete": {"const": 2}}
    },
    "attempt_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_total", "max_per_family", "stop_on_first_validated", "child_spawn", "attempt_a_started", "attempt_b_started"],
      "properties": {
        "max_total": {"const": 2},
        "max_per_family": {"const": 1},
        "stop_on_first_validated": {"const": true},
        "child_spawn": {"const": "DENY"},
        "attempt_a_started": {"const": false},
        "attempt_b_started": {"const": false}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_content_read", "auth_content_copied", "configuration_changed", "billing_changed", "install_or_upgrade_performed", "live_process_started", "live_inference_started", "workspace_modified", "ui_action_performed"],
      "properties": {
        "secret_content_read": {"const": false},
        "auth_content_copied": {"const": false},
        "configuration_changed": {"const": false},
        "billing_changed": {"const": false},
        "install_or_upgrade_performed": {"const": false},
        "live_process_started": {"const": false},
        "live_inference_started": {"const": false},
        "workspace_modified": {"const": false},
        "ui_action_performed": {"const": false}
      }
    },
    "claim_ceiling": {"type": "string", "minLength": 1, "pattern": "\\S"}
  }
}
