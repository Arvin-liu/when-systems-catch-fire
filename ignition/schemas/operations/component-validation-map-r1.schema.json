{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/component-validation-map-r1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purpose", "claim_ceiling", "targets", "components"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "purpose": {"$ref": "#/$defs/nonblank"},
    "claim_ceiling": {"$ref": "#/$defs/nonblank"},
    "targets": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/target"}
    },
    "components": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "domain": {"enum": ["R", "O", "G"]},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "domain", "modules", "evidence"],
      "properties": {
        "target_id": {"$ref": "#/$defs/id"},
        "domain": {"$ref": "#/$defs/domain"},
        "modules": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)+$"}
        },
        "import_roots": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(/[A-Za-z_][A-Za-z0-9_]*)*$"}
        },
        "command_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "evidence": {"$ref": "#/$defs/nonblank"}
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "domains", "validation_targets", "change_classifications", "evidence"],
      "properties": {
        "component_id": {"$ref": "#/$defs/id"},
        "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/domain"}},
        "validation_targets": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "change_classifications": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["CAPABILITY_ADDITION", "EVIDENCE_UPDATE", "GOVERNANCE_CHANGE", "HISTORICAL_ONLY", "INTERFACE_CHANGE", "OPERATIONS_METHOD", "RELEASE_OR_CURRENT_STATE_SYNC"]}
        },
        "evidence": {"$ref": "#/$defs/nonblank"},
        "requires_full_regression": {"type": "boolean"}
      }
    }
  }
}
