{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolbox-noaa-sf6-annual-growth-lookup-input-r0.schema.json",
  "title": "NOAA SF6 annual growth lookup input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "start_year",
    "end_year"
  ],
  "properties": {
    "schema_version": {
      "const": "toolbox-noaa-sf6-annual-growth-lookup-input-r0"
    },
    "start_year": {
      "type": "integer",
      "minimum": 1998,
      "maximum": 2100
    },
    "end_year": {
      "type": "integer",
      "minimum": 1998,
      "maximum": 2100
    }
  },
  "description": "The inclusive range must be ascending and contain at most 50 years. The CLI rejects invalid values before network access."
}
