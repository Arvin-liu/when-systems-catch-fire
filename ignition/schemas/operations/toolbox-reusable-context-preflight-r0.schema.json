{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ignition:toolbox-reusable-context-preflight-r0",
  "title": "Cross-task reusable context preflight request R0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "current_sources", "cached_cards"],
  "properties": {
    "schema_version": {"const": "toolbox-reusable-context-preflight-r0"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "raw_source_required", "max_context_bytes", "max_source_bytes"],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "raw_source_required": {"type": "boolean"},
        "max_context_bytes": {"type": "integer", "minimum": 1, "maximum": 16384},
        "max_source_bytes": {"type": "integer", "minimum": 1, "maximum": 5000000}
      }
    },
    "current_sources": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/currentSource"}},
    "cached_cards": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/cachedCard"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repoPath": {"type": "string", "maxLength": 500, "pattern": "^ignition/(?!\\.\\.?(/|$))(?!.*(/\\.\\.?(/|$)))[A-Za-z0-9._/-]+$"},
    "currentSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "version", "sha256", "access_scope_id", "access_state", "authorized"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/repoPath"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "sha256": {"$ref": "#/$defs/digest"},
        "access_scope_id": {"$ref": "#/$defs/id"},
        "access_state": {"enum": ["ACTIVE", "REVOKED", "UNREADABLE", "MISSING"]},
        "authorized": {"type": "boolean"}
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "version", "sha256", "access_scope_id"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/repoPath"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "sha256": {"$ref": "#/$defs/digest"},
        "access_scope_id": {"$ref": "#/$defs/id"}
      }
    },
    "cachedCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "source_bindings", "derived_context"],
      "properties": {
        "card_id": {"$ref": "#/$defs/id"},
        "source_bindings": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/sourceBinding"}},
        "derived_context": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    }
  }
}
