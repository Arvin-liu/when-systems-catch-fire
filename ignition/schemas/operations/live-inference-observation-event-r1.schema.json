{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pointfire.local/schemas/live-inference-observation-event-r1.schema.json",
  "title": "Pointfire public inference observation correction event R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "sequence", "event_type", "task_id", "dispatch_id", "attempt_id",
    "prior_record_hash", "inference_observation_status", "marker_observed", "marker_source",
    "evidence_scope", "previous_event_hash", "event_hash", "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "live-inference-observation-event-r1"},
    "sequence": {"type": "integer", "minimum": 0},
    "event_type": {"const": "INFERENCE_OBSERVATION_CORRECTION_RECORDED"},
    "task_id": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]+$"},
    "dispatch_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "prior_record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inference_observation_status": {"enum": ["OBSERVED", "NOT_OBSERVED", "UNKNOWN", "NOT_APPLICABLE_PRE_PROCESS"]},
    "marker_observed": {"type": "boolean"},
    "marker_source": {"type": "string", "minLength": 1},
    "evidence_scope": {"type": "string", "minLength": 1},
    "previous_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
