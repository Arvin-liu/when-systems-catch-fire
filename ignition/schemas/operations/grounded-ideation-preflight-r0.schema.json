{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ignition:grounded-ideation-preflight-r0",
  "title": "Grounded Research Ideation Preflight R0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "sources", "anchors", "gap", "mechanism_transfer", "proposal"],
  "properties": {
    "schema_version": {"const": "grounded-ideation-preflight-r0"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "cutoff_date"],
      "properties": {
        "question": {"type": "string", "minLength": 1, "maxLength": 4096},
        "cutoff_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "citation", "revision", "usage", "publication_date", "excerpt"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
          "citation": {"type": "string", "minLength": 1, "maxLength": 4096},
          "revision": {"type": "string", "minLength": 1, "maxLength": 4096},
          "usage": {"enum": ["USED", "ATTACHED"]},
          "publication_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "excerpt": {"type": "string", "maxLength": 16384}
        }
      }
    },
    "anchors": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_id", "source_id", "locator", "quote", "interpretation", "role"],
        "properties": {
          "anchor_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
          "source_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
          "locator": {"type": "string", "minLength": 1, "maxLength": 4096},
          "quote": {"type": "string", "minLength": 1, "maxLength": 2048},
          "interpretation": {"type": "string", "minLength": 1, "maxLength": 4096},
          "role": {"enum": ["gap_support", "counterevidence", "mechanism", "proposal_context"]}
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "support_anchor_ids", "contrary_anchor_ids", "limitations", "abstention_rule"],
      "properties": {
        "candidate": {"type": "string", "minLength": 1, "maxLength": 4096},
        "support_anchor_ids": {"$ref": "#/$defs/ids"},
        "contrary_anchor_ids": {"$ref": "#/$defs/ids"},
        "limitations": {"$ref": "#/$defs/texts"},
        "abstention_rule": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "mechanism_transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_domain", "target_domain", "failure_structure", "mappings", "necessary_conditions", "boundaries", "closest_in_domain_alternative"],
      "properties": {
        "source_domain": {"type": "string", "minLength": 1, "maxLength": 4096},
        "target_domain": {"type": "string", "minLength": 1, "maxLength": 4096},
        "failure_structure": {"type": "string", "minLength": 1, "maxLength": 4096},
        "mappings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_relation", "target_relation_candidate", "anchor_ids", "assumptions"],
            "properties": {
              "source_relation": {"type": "string", "minLength": 1, "maxLength": 4096},
              "target_relation_candidate": {"type": "string", "minLength": 1, "maxLength": 4096},
              "anchor_ids": {"$ref": "#/$defs/ids"},
              "assumptions": {"$ref": "#/$defs/texts"}
            }
          }
        },
        "necessary_conditions": {"$ref": "#/$defs/texts"},
        "boundaries": {"$ref": "#/$defs/texts"},
        "closest_in_domain_alternative": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis", "minimum_experiment", "controls", "falsifiers", "uncertainties", "evidence_anchor_ids"],
      "properties": {
        "hypothesis": {"type": "string", "minLength": 1, "maxLength": 4096},
        "minimum_experiment": {"type": "string", "minLength": 1, "maxLength": 4096},
        "controls": {"$ref": "#/$defs/texts"},
        "falsifiers": {"$ref": "#/$defs/texts"},
        "uncertainties": {"$ref": "#/$defs/texts"},
        "evidence_anchor_ids": {"$ref": "#/$defs/ids"}
      }
    }
  },
  "$defs": {
    "ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"}},
    "texts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
  }
}
