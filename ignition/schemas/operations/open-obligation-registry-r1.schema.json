{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/open-obligation-registry-r1.schema.json",
  "title": "Ignition independent open-obligation registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "authority", "current_task_id", "obligations", "last_adjudication", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "open-obligation-registry-r1"},
    "contract_id": {"const": "OBLIGATION_CARRY_FORWARD_WITHOUT_TASK_LIVENESS"},
    "authority": {"const": "OPEN_OBLIGATION_REGISTRY"},
    "current_task_id": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"},
    "obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/obligation"}},
    "last_adjudication": {"$ref": "#/$defs/adjudication"},
    "claim_ceiling": {"$ref": "#/$defs/nonblank"}
  },
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "taskId": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"},
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "kind", "opened_by_task", "current_status", "current_owner_plane", "blocker", "next_eligible_action", "inherited_by_task", "terminal_condition", "evidence_refs"],
      "properties": {
        "obligation_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "kind": {"$ref": "#/$defs/nonblank"},
        "opened_by_task": {"$ref": "#/$defs/taskId"},
        "current_status": {"enum": ["OPEN", "CLOSED"]},
        "current_owner_plane": {"$ref": "#/$defs/nonblank"},
        "operational_state": {"enum": ["ACTIVE", "OWNER_DEFERRED"]},
        "owner_deferral": {"$ref": "#/$defs/ownerDeferral"},
        "blocker": {"$ref": "#/$defs/nonblank"},
        "next_eligible_action": {"$ref": "#/$defs/nonblank"},
        "inherited_by_task": {"$ref": "#/$defs/taskId"},
        "carry_forward_tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/taskId"}, "uniqueItems": true},
        "terminal_condition": {"$ref": "#/$defs/nonblank"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true}
      }
    },
    "ownerDeferral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authority", "deferred_is_not_failed", "no_automatic_resume", "resume_prerequisites", "source_task_id", "historical_next_action", "decision_source"],
      "properties": {
        "status": {"const": "OWNER_DEFERRED"},
        "authority": {"const": "OWNER_EXPLICIT_SCOPE_OVERRIDE"},
        "deferred_is_not_failed": {"const": true},
        "no_automatic_resume": {"const": true},
        "resume_prerequisites": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
        "source_task_id": {"$ref": "#/$defs/taskId"},
        "historical_next_action": {"$ref": "#/$defs/nonblank"},
        "decision_source": {"$ref": "#/$defs/nonblank"}
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "decision", "previous_status", "current_status", "validated_completion_count", "live_attempt_started", "new_obligation_ids", "reason", "evidence_refs"],
      "properties": {
        "task_id": {"$ref": "#/$defs/taskId"},
        "decision": {"enum": ["OPEN_RETAINED", "CLOSED_WITH_NEW_OBLIGATIONS"]},
        "previous_status": {"enum": ["OPEN", "CLOSED"]},
        "current_status": {"enum": ["OPEN", "CLOSED"]},
        "validated_completion_count": {"type": "integer", "minimum": 0},
        "live_attempt_started": {"type": "boolean"},
        "new_obligation_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}, "uniqueItems": true},
        "reason": {"$ref": "#/$defs/nonblank"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true}
      }
    }
  }
}
