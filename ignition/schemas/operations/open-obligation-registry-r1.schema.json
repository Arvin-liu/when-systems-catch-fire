{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/open-obligation-registry-r1.schema.json",
  "title": "Ignition independent open-obligation registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "authority", "current_task_id", "obligations", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "open-obligation-registry-r1"},
    "contract_id": {"const": "OBLIGATION_CARRY_FORWARD_WITHOUT_TASK_LIVENESS"},
    "authority": {"const": "OPEN_OBLIGATION_REGISTRY"},
    "current_task_id": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"},
    "obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/obligation"}},
    "claim_ceiling": {"$ref": "#/$defs/nonblank"}
  },
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "taskId": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"},
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "kind", "opened_by_task", "current_status", "current_owner_plane", "blocker", "next_eligible_action", "inherited_by_task", "terminal_condition", "evidence_refs"],
      "properties": {
        "obligation_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "kind": {"$ref": "#/$defs/nonblank"},
        "opened_by_task": {"$ref": "#/$defs/taskId"},
        "current_status": {"enum": ["OPEN", "CLOSED"]},
        "current_owner_plane": {"$ref": "#/$defs/nonblank"},
        "blocker": {"$ref": "#/$defs/nonblank"},
        "next_eligible_action": {"$ref": "#/$defs/nonblank"},
        "inherited_by_task": {"$ref": "#/$defs/taskId"},
        "carry_forward_tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/taskId"}, "uniqueItems": true},
        "terminal_condition": {"$ref": "#/$defs/nonblank"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true}
      }
    }
  }
}
