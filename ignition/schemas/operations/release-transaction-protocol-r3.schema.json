{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/release-transaction-protocol-r3.schema.json",
  "title": "Release transaction protocol R3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_id", "governance_task_id", "type", "status",
    "formal_repository", "receipt_repository", "supersedes_contract_id",
    "effective_policy_before_activation", "activation", "preserved_hard_gates",
    "identity_binding", "source_evidence_fields", "prepublication", "merge_method",
    "postpublication", "independent_witness", "failure_states", "claim_ceiling",
    "canonical_suite_window"
  ],
  "properties": {
    "schema_version": {"const": "release-transaction-protocol-r3"},
    "contract_id": {"const": "RELEASE_TRANSACTION_PROTOCOL_R3"},
    "governance_task_id": {"const": "IGNITION_20261018_R3_PROTECTED_PR_MERGE_CONTRACT"},
    "type": {"const": "GOVERNANCE"},
    "status": {"const": "CANDIDATE_NOT_EFFECTIVE"},
    "formal_repository": {"const": "Arvin-liu/when-systems-catch-fire"},
    "receipt_repository": {"const": "Arvin-liu/1111"},
    "supersedes_contract_id": {"const": "RELEASE_TRANSACTION_PROTOCOL_R2"},
    "effective_policy_before_activation": {"const": "RELEASE_TRANSACTION_PROTOCOL_R2"},
    "activation": {"$ref": "#/$defs/activation"},
    "preserved_hard_gates": {"$ref": "#/$defs/preservedHardGates"},
    "identity_binding": {"$ref": "#/$defs/identityBinding"},
    "source_evidence_fields": {
      "type": "array", "uniqueItems": true, "minItems": 15,
      "items": {"type": "string", "minLength": 1}
    },
    "prepublication": {"$ref": "#/$defs/prepublication"},
    "merge_method": {"$ref": "#/$defs/mergeMethod"},
    "postpublication": {"$ref": "#/$defs/postpublication"},
    "independent_witness": {"$ref": "#/$defs/independentWitness"},
    "failure_states": {
      "type": "array", "uniqueItems": true, "minItems": 3,
      "items": {"enum": ["MERGED_PENDING_POSTPUBLICATION_VALIDATION", "PUBLISHED_UNVERIFIED", "RELEASE_CLOSURE_BLOCKED"]}
    },
    "claim_ceiling": {"type": "string", "minLength": 1},
    "canonical_suite_window": {"$ref": "#/$defs/canonicalSuiteWindow"}
  },
  "$defs": {
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_can_self_authorize", "requires_independent_1111_transition_receipt", "requires_exact_remote_main_sha_observation", "requires_fresh_main_checkout", "requires_explicit_owner_transition_approval", "required_receipt_status", "required_migration_scope", "r2_remains_current_if_receipt_missing_or_invalid"],
      "properties": {
        "candidate_can_self_authorize": {"const": false},
        "requires_independent_1111_transition_receipt": {"const": true},
        "requires_exact_remote_main_sha_observation": {"const": true},
        "requires_fresh_main_checkout": {"const": true},
        "requires_explicit_owner_transition_approval": {"const": true},
        "required_receipt_status": {"const": "PUBLISHED_AND_VERIFIED"},
        "required_migration_scope": {"const": "ONE_TIME_R3_BOOTSTRAP_ONLY"},
        "r2_remains_current_if_receipt_missing_or_invalid": {"const": true}
      }
    },
    "preservedHardGates": {
      "type": "object", "additionalProperties": false,
      "required": ["source_contract", "required_gate_ids", "fail_closed", "canonical_full_suite"],
      "properties": {
        "source_contract": {"const": "ignition/data/operations/release-transaction-protocol-r2.json"},
        "required_gate_ids": {
          "type": "array", "uniqueItems": true, "minItems": 8,
          "items": {"enum": ["deterministic_projection_preflight", "current_path_manifest_exact", "residual_non_growth", "current_semantic_gates", "canonical_full_suite", "exact_candidate_sha_binding", "no_post_suite_tracked_mutation", "task_ordinal_binding"]}
        },
        "fail_closed": {"const": true},
        "canonical_full_suite": {"$ref": "#/$defs/canonicalFullSuite"}
      }
    },
    "canonicalFullSuite": {
      "type": "object", "additionalProperties": false,
      "required": ["required_runs", "minimum_natural_window_seconds", "zero_failures_errors_skips", "clean_before_after", "exact_candidate_sha", "no_watchdog"],
      "properties": {
        "required_runs": {"const": 2},
        "minimum_natural_window_seconds": {"const": 14400},
        "zero_failures_errors_skips": {"const": true},
        "clean_before_after": {"const": true},
        "exact_candidate_sha": {"const": true},
        "no_watchdog": {"const": true}
      }
    },
    "identityBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["current_task_source_path", "task_identity_model_path", "formal_ordinal_source", "bind_source_digests", "reject_historical_task_receipt_replay", "never_infer_task_ordinal_from_this_protocol"],
      "properties": {
        "current_task_source_path": {"const": "ignition/data/operations/current-task-lineage-status.json"},
        "task_identity_model_path": {"const": "ignition/data/operations/task-identity-model-r1.json"},
        "formal_ordinal_source": {"type": "string", "minLength": 1},
        "bind_source_digests": {"const": true},
        "reject_historical_task_receipt_replay": {"const": true},
        "never_infer_task_ordinal_from_this_protocol": {"const": true}
      }
    },
    "prepublication": {
      "type": "object", "additionalProperties": false,
      "required": ["required_merge_method", "required_merge_preview_parent_order", "require_preview_tree_equal_candidate_tree", "require_base_and_head_stable_since_tests", "require_pull_request_workflow_evidence_for_exact_head_base", "required_workflow_names", "require_reviewed_paths_equal_observed_paths", "require_verified_branch_protection", "record_live_review_and_status_rules_without_strengthening_them", "code_review_requirement_follows_verified_github_branch_rules", "owner_transition_authorization_is_not_a_github_review", "if_base_head_preview_or_tree_changes"],
      "properties": {
        "required_merge_method": {"const": "MERGE_COMMIT"},
        "required_merge_preview_parent_order": {"const": ["base_main_sha", "candidate_head_sha"]},
        "require_preview_tree_equal_candidate_tree": {"const": true},
        "require_base_and_head_stable_since_tests": {"const": true},
        "require_pull_request_workflow_evidence_for_exact_head_base": {"const": true},
        "required_workflow_names": {"const": ["release-transaction-protocol-validation", "foundation-validation", "repository-path-accounting-preflight"]},
        "require_reviewed_paths_equal_observed_paths": {"const": true},
        "require_verified_branch_protection": {"const": true},
        "record_live_review_and_status_rules_without_strengthening_them": {"const": true},
        "code_review_requirement_follows_verified_github_branch_rules": {"const": true},
        "owner_transition_authorization_is_not_a_github_review": {"const": true},
        "if_base_head_preview_or_tree_changes": {"const": "refresh_preview_and_rerun_affected_admission_checks"}
      }
    },
    "mergeMethod": {
      "type": "object", "additionalProperties": false,
      "required": ["supported_methods", "required_final_parent_order", "rebase_supported", "squash_supported", "changes_repository_merge_settings", "unknown_branch_protection_blocks_admission"],
      "properties": {
        "supported_methods": {"const": ["MERGE_COMMIT"]},
        "required_final_parent_order": {"const": ["base_main_sha", "candidate_head_sha"]},
        "rebase_supported": {"const": false},
        "squash_supported": {"const": false},
        "changes_repository_merge_settings": {"const": false},
        "unknown_branch_protection_blocks_admission": {"const": true}
      }
    },
    "postpublication": {
      "type": "object", "additionalProperties": false,
      "required": ["verify_remote_ref", "verify_pr_merged", "verify_final_commit_parents_and_tree", "require_final_parents_equal_preview_parent_order", "require_final_tree_equal_tested_preview_tree", "allow_final_sha_to_differ_from_preview_sha", "require_observed_remote_sha_equal_actual_final_main_sha", "require_fresh_clone_head_equal_actual_final_main_sha", "run_postpublication_checks_on_actual_final_main_sha", "require_projection_check_source_sha_equal_actual_final_main_sha", "nonempty_unexpected_generated_paths_fail_closed", "mismatch_state", "required_workflow_names"],
      "properties": {
        "verify_remote_ref": {"const": "refs/heads/main"},
        "verify_pr_merged": {"const": true},
        "verify_final_commit_parents_and_tree": {"const": true},
        "require_final_parents_equal_preview_parent_order": {"const": true},
        "require_final_tree_equal_tested_preview_tree": {"const": true},
        "allow_final_sha_to_differ_from_preview_sha": {"const": true},
        "require_observed_remote_sha_equal_actual_final_main_sha": {"const": true},
        "require_fresh_clone_head_equal_actual_final_main_sha": {"const": true},
        "run_postpublication_checks_on_actual_final_main_sha": {"const": true},
        "require_projection_check_source_sha_equal_actual_final_main_sha": {"const": true},
        "nonempty_unexpected_generated_paths_fail_closed": {"const": true},
        "mismatch_state": {"const": "PUBLISHED_UNVERIFIED"},
        "required_workflow_names": {"const": ["release-transaction-protocol-validation", "foundation-validation"]}
      }
    },
    "independentWitness": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "branch", "path", "must_bind", "pending_status", "success_status", "receipt_must_not_create_formal_commit"],
      "properties": {
        "repository": {"const": "Arvin-liu/1111"},
        "branch": {"const": "main"},
        "path": {"const": "reports/operations/IGNITION-2026-10-18-R3-PUBLISHED-AND-VERIFIED-R0.json"},
        "must_bind": {"type": "array", "uniqueItems": true, "minItems": 16, "items": {"type": "string"}},
        "pending_status": {"const": "MERGED_PENDING_POSTPUBLICATION_VALIDATION"},
        "success_status": {"const": "PUBLISHED_AND_VERIFIED"},
        "receipt_must_not_create_formal_commit": {"const": true}
      }
    },
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonicalSuiteWindow": {
      "type": "object", "additionalProperties": false,
      "required": ["configured_window_seconds", "elapsed_duration_semantics", "natural_early_completion_allowed", "natural_process_exit_required", "watchdog_termination_fails", "preserved_r2_gate_value_source"],
      "properties": {
        "configured_window_seconds": {"const": 14400},
        "elapsed_duration_semantics": {"const": "MAXIMUM_TIME_BUDGET_BEFORE_WATCHDOG"},
        "natural_early_completion_allowed": {"const": true},
        "natural_process_exit_required": {"const": true},
        "watchdog_termination_fails": {"const": true},
        "preserved_r2_gate_value_source": {"const": "ignition/data/operations/release-transaction-protocol-r2.json#/pre_publication_hard_gates/canonical_full_suite/minimum_natural_window_seconds"}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha", "conclusion", "completed_at", "workflow_run_id", "event"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha": {"$ref": "#/$defs/sha1"},
        "conclusion": {"enum": ["success", "failure", "cancelled", "timed_out", "skipped", "neutral", "action_required", "in_progress", "queued"]},
        "completed_at": {"type": "string", "format": "date-time"},
        "check_url": {"type": "string", "format": "uri"},
        "workflow_run_id": {"type": "string", "minLength": 1},
        "event": {"const": "push"}
      }
    },
    "prWorkflowCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_name", "workflow_run_id", "event", "pull_request_number", "base_sha", "head_sha", "check_run_name", "check_run_sha", "checkout_ref", "checkout_sha", "conclusion", "check_run_id", "check_run_url"],
      "properties": {
        "workflow_name": {"type": "string", "minLength": 1},
        "workflow_run_id": {"type": "string", "minLength": 1},
        "event": {"const": "pull_request"},
        "pull_request_number": {"type": "integer", "minimum": 1},
        "base_sha": {"$ref": "#/$defs/sha1"},
        "head_sha": {"$ref": "#/$defs/sha1"},
        "check_run_name": {"type": "string", "minLength": 1},
        "check_run_sha": {"$ref": "#/$defs/sha1"},
        "checkout_ref": {"type": "string", "minLength": 1},
        "checkout_sha": {"$ref": "#/$defs/sha1"},
        "conclusion": {"const": "success"},
        "check_run_id": {"type": "integer", "minimum": 1},
        "check_run_url": {"type": "string", "format": "uri"}
      }
    },
    "pullRequestReview": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "state", "commit_sha", "submitted_at", "review_url"],
      "properties": {
        "actor_id": {"type": "integer", "minimum": 1},
        "state": {"enum": ["APPROVED", "CHANGES_REQUESTED", "COMMENTED", "DISMISSED"]},
        "commit_sha": {"$ref": "#/$defs/sha1"},
        "submitted_at": {"type": "string", "format": "date-time"},
        "review_url": {"type": "string", "format": "uri"}
      }
    },
    "branchProtectionObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "target_branch", "protected", "required_review", "required_status_checks", "admin_enforcement_enabled", "force_push_allowed", "deletions_allowed", "push_restrictions_enabled", "required_check_names", "rules_sha256", "observed_at", "ruleset_count", "ruleset_sha256"],
      "properties": {
        "status": {"const": "VERIFIED"},
        "target_branch": {"const": "main"},
        "protected": {"const": true},
        "required_review": {"type": "boolean"},
        "required_status_checks": {"type": "boolean"},
        "admin_enforcement_enabled": {"type": "boolean"},
        "force_push_allowed": {"type": "boolean"},
        "deletions_allowed": {"type": "boolean"},
        "push_restrictions_enabled": {"type": "boolean"},
        "required_check_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rules_sha256": {"$ref": "#/$defs/sha256"},
        "observed_at": {"type": "string", "format": "date-time"},
        "ruleset_count": {"type": "integer", "minimum": 0},
        "ruleset_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ownerAuthorization": {
      "type": "object", "additionalProperties": false,
      "required": ["approved", "owner_actor_id", "approved_pr_number", "approved_head_sha", "approved_base_sha", "r3_protocol_blob_sha", "scope", "authorization_repository", "authorization_path", "authorization_commit_sha", "authorization_committed_at", "authorization_file_sha256", "approved_at"],
      "properties": {
        "approved": {"const": true},
        "owner_actor_id": {"type": "integer", "minimum": 1},
        "approved_pr_number": {"type": "integer", "minimum": 1},
        "approved_head_sha": {"$ref": "#/$defs/sha1"},
        "approved_base_sha": {"$ref": "#/$defs/sha1"},
        "r3_protocol_blob_sha": {"$ref": "#/$defs/sha1"},
        "scope": {"const": "ONE_TIME_R3_BOOTSTRAP_ONLY"},
        "authorization_repository": {"const": "Arvin-liu/1111"},
        "authorization_path": {"const": "instructions/goal-mode/IGNITION-2026-10-18-R3-ONE-TIME-TRANSITION-AUTHORIZATION-R0.json"},
        "authorization_commit_sha": {"$ref": "#/$defs/sha1"},
        "authorization_committed_at": {"type": "string", "format": "date-time"},
        "authorization_file_sha256": {"$ref": "#/$defs/sha256"},
        "approved_at": {"type": "string", "format": "date-time"}
      }
    },
    "ownerAuthorizationStatement": {
      "type": "object", "additionalProperties": false,
      "required": ["approved", "owner_actor_id", "approved_pr_number", "approved_head_sha", "approved_base_sha", "r3_protocol_blob_sha", "scope", "approved_at"],
      "properties": {
        "approved": {"const": true},
        "owner_actor_id": {"type": "integer", "minimum": 1},
        "approved_pr_number": {"type": "integer", "minimum": 1},
        "approved_head_sha": {"$ref": "#/$defs/sha1"},
        "approved_base_sha": {"$ref": "#/$defs/sha1"},
        "r3_protocol_blob_sha": {"$ref": "#/$defs/sha1"},
        "scope": {"const": "ONE_TIME_R3_BOOTSTRAP_ONLY"},
        "approved_at": {"type": "string", "format": "date-time"}
      }
    },
    "suiteReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "task_id", "task_branch", "sha", "inventory_sha256", "test_count", "environment_sha256", "window_seconds", "duration_seconds", "started_at", "finished_at", "process_exit_code", "termination_reason", "failures", "errors", "skips", "clean_before", "clean_after", "watchdog_used", "conclusion", "source_url"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "task_branch": {"type": "string", "minLength": 1},
        "sha": {"$ref": "#/$defs/sha1"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "test_count": {"type": "integer", "minimum": 1},
        "environment_sha256": {"$ref": "#/$defs/sha256"},
        "duration_seconds": {"type": "integer", "minimum": 0, "maximum": 14400},
        "window_seconds": {"const": 14400},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "process_exit_code": {"const": 0},
        "termination_reason": {"const": "NATURAL_PROCESS_EXIT"},
        "failures": {"const": 0},
        "errors": {"const": 0},
        "skips": {"const": 0},
        "clean_before": {"const": true},
        "clean_after": {"const": true},
        "watchdog_used": {"const": false},
        "conclusion": {"const": "success"},
        "source_url": {"type": "string", "format": "uri"}
      }
    },
    "transactionRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["task_identity", "pull_request", "refs", "changed_paths", "required_check_names", "pull_request_workflow_checks", "pull_request_reviews", "canonical_full_suite_receipts", "merge_method", "branch_protection", "owner_approval", "publication"],
      "properties": {
        "task_identity": {
          "type": "object", "additionalProperties": false,
          "required": ["task_id", "formal_ordinal", "task_branch", "current_task_source_sha256", "task_identity_model_sha256", "execution_contract_sha256"],
          "properties": {
            "task_id": {"type": "string", "minLength": 1},
            "formal_ordinal": {"type": "integer", "minimum": 1},
            "task_branch": {"type": "string", "minLength": 1},
            "current_task_source_sha256": {"$ref": "#/$defs/sha256"},
            "task_identity_model_sha256": {"$ref": "#/$defs/sha256"},
            "execution_contract_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "pull_request": {
          "type": "object", "additionalProperties": false,
          "required": ["number", "url", "base_branch", "head_branch", "state", "draft", "head_sha", "author_id"],
          "properties": {
            "number": {"type": "integer", "minimum": 1},
            "url": {"type": "string", "format": "uri"},
            "base_branch": {"const": "main"},
            "head_branch": {"type": "string", "minLength": 1},
            "state": {"enum": ["OPEN", "MERGED"]},
            "draft": {"const": false},
            "head_sha": {"$ref": "#/$defs/sha1"},
            "author_id": {"type": "integer", "minimum": 1}
          }
        },
        "refs": {
          "type": "object", "additionalProperties": false,
          "required": ["base_main_sha", "candidate_tree_sha", "merge_preview_sha", "merge_preview_tree_sha", "merge_preview_parents"],
          "properties": {
            "base_main_sha": {"$ref": "#/$defs/sha1"},
            "candidate_tree_sha": {"$ref": "#/$defs/sha1"},
            "merge_preview_sha": {"$ref": "#/$defs/sha1"},
            "merge_preview_tree_sha": {"$ref": "#/$defs/sha1"},
            "merge_preview_parents": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/sha1"}}
          }
        },
        "changed_paths": {
          "type": "object", "additionalProperties": false,
          "required": ["reviewed_paths", "observed_paths"],
          "properties": {
            "reviewed_paths": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "observed_paths": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "required_check_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "pull_request_workflow_checks": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/prWorkflowCheck"}},
        "pull_request_reviews": {"type": "array", "items": {"$ref": "#/$defs/pullRequestReview"}},
        "canonical_full_suite_receipts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/suiteReceipt"}},
        "merge_method": {"const": "MERGE_COMMIT"},
        "branch_protection": {"$ref": "#/$defs/branchProtectionObservation"},
        "owner_approval": {"$ref": "#/$defs/ownerAuthorization"},
        "publication": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "actual_final_main_sha", "actual_final_main_tree_sha", "actual_final_main_parents", "observed_remote_main_sha", "fresh_main_checkout_sha", "postpublication_checks", "projection_check"],
          "properties": {
            "status": {"enum": ["NOT_MERGED", "MERGED_PENDING_POSTPUBLICATION_VALIDATION", "PUBLISHED_UNVERIFIED", "PUBLISHED_AND_VERIFIED"]},
            "actual_final_main_sha": {"oneOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]},
            "actual_final_main_tree_sha": {"oneOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]},
            "actual_final_main_parents": {"oneOf": [{"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/sha1"}}, {"type": "null"}]},
            "observed_remote_main_sha": {"oneOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]},
            "fresh_main_checkout_sha": {"oneOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]},
            "postpublication_checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
            "projection_check": {
              "oneOf": [
                {"type": "null"},
                {"type": "object", "additionalProperties": false, "required": ["status", "source_sha", "unexpected_changed_paths"], "properties": {"status": {"const": "PASS"}, "source_sha": {"$ref": "#/$defs/sha1"}, "unexpected_changed_paths": {"type": "array", "items": {"type": "string"}}}}
              ]
            }
          }
        }
      }
    },
    "activationReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "migration_scope", "r3_protocol_blob_sha", "prepublication_record_sha256", "prepublication_validation_status", "pr_number", "pr_url", "pr_base_branch", "pr_head_ref", "task_branch", "pr_merged", "pr_merged_at", "pr_merge_commit_sha", "base_main_sha", "candidate_head_sha", "candidate_tree_sha", "merge_preview_sha", "merge_preview_tree_sha", "merge_preview_parents", "actual_final_main_sha", "actual_final_main_tree_sha", "actual_final_main_parents", "observed_remote_main_sha", "fresh_main_clone_head_sha", "merge_method", "branch_protection_verified", "branch_protection_rules_sha256", "owner_approved_before_merge", "owner_approval", "postpublication_checks", "published_at"],
      "properties": {
        "status": {"const": "PUBLISHED_AND_VERIFIED"},
        "migration_scope": {"const": "ONE_TIME_R3_BOOTSTRAP_ONLY"},
        "r3_protocol_blob_sha": {"$ref": "#/$defs/sha1"},
        "prepublication_record_sha256": {"$ref": "#/$defs/sha256"},
