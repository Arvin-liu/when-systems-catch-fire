{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/task142-class-separation-r1.schema.json",
  "title": "Task142 executor class separation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "step", "status", "observed_at", "candidates", "rule", "safety", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "task142-class-separation-r1"},
    "task_id": {"const": "IGNITION-20260827-142"},
    "step": {"const": "10"},
    "status": {"const": "PASS"},
    "observed_at": {"type": "string", "format": "date-time"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executor_id", "family", "installed", "probe", "live_eligibility", "validated_completion_eligible", "blocker"],
        "properties": {
          "executor_id": {"type": "string", "minLength": 1},
          "family": {"enum": ["REASONER_RUNTIME", "TOOL", "UI_SURFACE"]},
          "installed": {"type": "boolean"},
          "probe": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path_ref", "version", "version_code", "help_code", "binary_sha256", "help_sha256"],
            "properties": {
              "path_ref": {"type": ["string", "null"]},
              "version": {"type": ["string", "null"]},
              "version_code": {"type": ["integer", "null"]},
              "help_code": {"type": ["integer", "null"]},
              "binary_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "help_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "live_eligibility": {"const": "NOT_APPLICABLE"},
          "validated_completion_eligible": {"const": false},
          "blocker": {"type": "string", "minLength": 1}
        }
      }
    },
    "rule": {"const": "ONLY_AGENTIC_EXECUTOR_CAN_PRODUCE_LIVE_READONLY_VALIDATED_COMPLETION;_REASONER_RUNTIME_TOOL_AND_UI_SURFACE_ARE_NOT_SUBSTITUTES"},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_content_read", "configuration_changed", "billing_changed", "install_or_upgrade_performed", "live_process_started", "live_inference_started", "ui_action_performed"],
      "properties": {
        "secret_content_read": {"const": false},
        "configuration_changed": {"const": false},
        "billing_changed": {"const": false},
        "install_or_upgrade_performed": {"const": false},
        "live_process_started": {"const": false},
        "live_inference_started": {"const": false},
        "ui_action_performed": {"const": false}
      }
    },
    "claim_ceiling": {"type": "string", "minLength": 1, "pattern": "\\S"}
  }
}
