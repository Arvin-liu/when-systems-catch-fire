{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/current-volatile-fact-registry-r1.schema.json",
  "title": "Current volatile fact registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "registry_role", "facts", "surfaces", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "current-volatile-fact-registry-r1"},
    "contract_id": {"const": "CURRENT_VOLATILE_FACT_SINGLE_SOURCE_INVARIANT"},
    "registry_role": {"type": "string", "minLength": 1},
    "source_resolution": {"type": "string", "minLength": 1},
    "facts": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/fact"}},
    "surfaces": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/surface"}},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "canonical_source", "value_type", "extractor", "allowed_current_renderings", "allowed_historical_usage", "required_current_surfaces", "freshness_rule", "null_behavior", "authority", "claim_ceiling"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "canonical_source": {"$ref": "#/$defs/source"},
        "value_type": {"type": "string", "minLength": 1},
        "extractor": {"type": "string", "minLength": 1},
        "allowed_current_renderings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "allowed_historical_usage": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_current_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "freshness_rule": {"type": "string", "minLength": 1},
        "null_behavior": {"enum": ["FAIL", "UNKNOWN"]},
        "authority": {"type": "string", "minLength": 1},
        "claim_ceiling": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "json_pointer", "source_kind"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "json_pointer": {"type": "string", "pattern": "^/|^$"},
        "source_kind": {"type": "string", "minLength": 1}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "path", "profile"],
      "properties": {
        "surface_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "path": {"type": "string", "minLength": 1},
        "profile": {"enum": ["human", "ai", "machine"]}
      }
    }
  }
}
