{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-decomposition-solvability-input-r0",
  "title": "Caller-declared task decomposition solvability comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_revision",
    "task_input_types",
    "required_output_types",
    "resource_budget",
    "capability_contracts",
    "validator_contracts",
    "alternatives"
  ],
  "properties": {
    "schema_version": {"const": "task-decomposition-solvability-input-r0"},
    "task_id": {"$ref": "#/$defs/id"},
    "task_revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "task_input_types": {"$ref": "#/$defs/typeListEmptyOk"},
    "required_output_types": {"$ref": "#/$defs/typeList"},
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_action_count", "max_wall_clock_seconds", "max_output_bytes"],
      "properties": {
        "max_action_count": {"type": "integer", "minimum": 0, "maximum": 99999999999999999999999999999999},
        "max_wall_clock_seconds": {"type": "number", "minimum": 0, "maximum": 99999999999999999999999999999999},
        "max_output_bytes": {"type": "integer", "minimum": 0, "maximum": 99999999999999999999999999999999}
      }
    },
    "capability_contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "availability", "accepted_input_types", "produced_output_types"],
        "properties": {
          "capability_id": {"$ref": "#/$defs/id"},
          "availability": {"enum": ["AVAILABLE", "UNAVAILABLE", "UNKNOWN"]},
          "accepted_input_types": {"$ref": "#/$defs/typeListEmptyOk"},
          "produced_output_types": {"$ref": "#/$defs/typeList"}
        }
      }
    },
    "validator_contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["validator_id", "availability", "accepted_input_types", "validated_output_types"],
        "properties": {
          "validator_id": {"$ref": "#/$defs/id"},
          "availability": {"enum": ["AVAILABLE", "UNAVAILABLE", "UNKNOWN"]},
          "accepted_input_types": {"$ref": "#/$defs/typeListEmptyOk"},
          "validated_output_types": {"$ref": "#/$defs/typeList"}
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alternative_id", "work_units"],
        "properties": {
          "alternative_id": {"$ref": "#/$defs/id"},
          "work_units": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit_id",
                "depends_on",
                "required_input_types",
                "produced_output_types",
                "capability_id",
                "validator_ids",
                "estimated_cost"
              ],
              "properties": {
                "unit_id": {"$ref": "#/$defs/id"},
                "depends_on": {"$ref": "#/$defs/idListEmptyOk"},
                "required_input_types": {"$ref": "#/$defs/typeListEmptyOk"},
                "produced_output_types": {"$ref": "#/$defs/typeList"},
                "capability_id": {"$ref": "#/$defs/id"},
                "validator_ids": {"$ref": "#/$defs/idListEmptyOk"},
                "estimated_cost": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action_count", "wall_clock_seconds", "output_bytes"],
                  "properties": {
                    "action_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 99999999999999999999999999999999},
                    "wall_clock_seconds": {"type": ["number", "null"], "minimum": 0, "maximum": 99999999999999999999999999999999},
                    "output_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 99999999999999999999999999999999}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$"},
    "idListEmptyOk": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "typeList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "typeListEmptyOk": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    }
  }
}
