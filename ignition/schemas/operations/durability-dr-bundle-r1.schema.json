{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/schemas/operations/durability-dr-bundle-r1.schema.json",
  "type": "object",
  "required": ["schema_version", "bundle_epoch", "required_chunks", "manifest_fields", "restore_rules", "negative_cases", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "ignition-durability-dr-bundle-r1"},
    "bundle_epoch": {"const": "dr-bundle-epoch-1"},
    "required_chunks": {"const": ["trusted-snapshot", "tail-event-lineage", "schema-migration", "namespace-registry", "pack-lifecycle", "executor-admission", "capability-revocation", "accounting", "reconciliation", "memory-integrity", "soft-governance", "operator-checkpoint"]},
    "manifest_fields": {"const": ["namespace_id", "schema_epoch", "source_ledger_head_hash", "chunks", "unresolved_reconciliation_refs", "external_reexecution", "manifest_sha256"]},
    "restore_rules": {"const": "VERIFY_HASHES_NAMESPACE_SCHEMA_AND_MANIFEST_BEFORE_LOCAL_RESTORE_NO_EXTERNAL_RERUN"},
    "negative_cases": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}},
    "claim_ceiling": {"const": "DISPOSABLE_LOCAL_RECOVERY_EVIDENCE_ONLY_NO_AUTOMATIC_EXTERNAL_SIDE_EFFECT_REEXECUTION"}
  },
  "additionalProperties": false
}
