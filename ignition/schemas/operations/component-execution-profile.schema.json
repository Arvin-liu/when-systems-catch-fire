{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "authority", "execution_kind", "execution_capability", "validation_capability", "execution_cwd", "authoritative_inputs", "generated_outputs", "input_fingerprint_policy", "output_fingerprint_policy", "claim_ceiling"],
        "properties": {
          "component_id": {"type": "string"},
          "authority": {"type": "string"},
          "execution_kind": {"enum": ["automatic", "manual", "attestation", "validation_only"]},
          "execution_capability": {"enum": ["automatic", "manual", "external_attestation", "validation_only"]},
          "validation_capability": {"enum": ["local_automatic_validation", "local_validation_only", "manual_review", "external_attestation"]},
          "execution_cwd": {"const": "."},
          "authoritative_inputs": {"type": "array", "items": {"type": "string"}},
          "generated_outputs": {"type": "array", "items": {"type": "string"}},
          "input_fingerprint_policy": {"type": "object"},
          "output_fingerprint_policy": {"type": "object"},
          "producer_argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "validator_argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "validation_authority": {"type": "object", "required": ["authority", "required_evidence", "evidence_boundary"]},
          "claim_ceiling": {"type": "string"}
        },
        "allOf": [
          {"if": {"properties": {"execution_capability": {"const": "automatic"}}}, "then": {"required": ["producer_argv", "validator_argv"], "properties": {"validation_capability": {"const": "local_automatic_validation"}, "generated_outputs": {"minItems": 1}}}},
          {"if": {"properties": {"execution_capability": {"const": "validation_only"}}}, "then": {"required": ["validator_argv"], "properties": {"validation_capability": {"const": "local_validation_only"}}, "not": {"required": ["producer_argv"]}}},
          {"if": {"properties": {"execution_capability": {"const": "manual"}}}, "then": {"required": ["validation_authority"], "properties": {"validation_capability": {"const": "manual_review"}}, "not": {"anyOf": [{"required": ["producer_argv"]}, {"required": ["validator_argv"]}]}}},
          {"if": {"properties": {"execution_capability": {"const": "external_attestation"}}}, "then": {"required": ["validation_authority"], "properties": {"validation_capability": {"const": "external_attestation"}}, "not": {"anyOf": [{"required": ["producer_argv"]}, {"required": ["validator_argv"]}]}}}
        ]
      }
    }
  }
}
