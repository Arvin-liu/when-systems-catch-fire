{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pointfire.local/schemas/live-reconciliation-event-r1.schema.json",
  "title": "Ignition Live Reconciliation Event R1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "event_type", "task_id", "dispatch_id", "attempt_id", "executor_id", "prior_record_hash", "reconciliation_state", "previous_event_hash", "event_hash", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "live-reconciliation-event-r1"},
    "sequence": {"type": "integer", "minimum": 0},
    "event_type": {"const": "RECONCILIATION_STATE_RECORDED"},
    "task_id": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]+$"},
    "dispatch_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$", "minLength": 1},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$", "minLength": 1},
    "executor_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$", "minLength": 1},
    "prior_record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reconciliation_state": {"type": "object"},
    "previous_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
