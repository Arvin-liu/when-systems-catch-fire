{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ignition.local/schemas/operations/toolbox-structural-analogy-search-input-r0.schema.json",
  "title": "Bounded structural analogy search input R0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "source_structure", "relation_mappings", "target_candidates"],
  "properties": {
    "schema_version": {"const": "toolbox-structural-analogy-search-input-r0"},
    "task_id": {"$ref": "#/$defs/id"},
    "source_structure": {"$ref": "#/$defs/sourceGraph"},
    "relation_mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/relationMapping"}
    },
    "target_candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/targetGraph"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,63}$"},
    "role": {"enum": ["ACTOR", "ACTION", "CONDITION", "CONSTRAINT", "MEASURE", "OUTCOME", "RESOURCE", "STATE", "OTHER"]},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "role_class"],
      "properties": {"node_id": {"$ref": "#/$defs/id"}, "role_class": {"$ref": "#/$defs/role"}}
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "subject_id", "relation_type", "object_id"],
      "properties": {
        "relation_id": {"$ref": "#/$defs/id"},
        "subject_id": {"$ref": "#/$defs/id"},
        "relation_type": {"$ref": "#/$defs/id"},
        "object_id": {"$ref": "#/$defs/id"}
      }
    },
    "sourceGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure_id", "domain_id", "nodes", "relations"],
      "properties": {
        "structure_id": {"$ref": "#/$defs/id"},
        "domain_id": {"$ref": "#/$defs/id"},
        "nodes": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/node"}},
        "relations": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/$defs/relation"}}
      }
    },
    "targetGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "structure_id", "domain_id", "nodes", "relations"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "structure_id": {"$ref": "#/$defs/id"},
        "domain_id": {"$ref": "#/$defs/id"},
        "nodes": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/node"}},
        "relations": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/$defs/relation"}}
      }
    },
    "relationMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_relation_type", "target_relation_type"],
      "properties": {
        "source_relation_type": {"$ref": "#/$defs/id"},
        "target_relation_type": {"$ref": "#/$defs/id"}
      }
    }
  }
}
