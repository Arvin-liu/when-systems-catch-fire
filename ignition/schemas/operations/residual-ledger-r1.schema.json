{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/residual-ledger-r1.schema.json",
  "title": "Current Residual Ledger R1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "baseline_ref", "residuals", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "residual-ledger-r1"},
    "task_id": {"const": "IGNITION-20260822-134"},
    "baseline_ref": {"type": "object", "additionalProperties": false, "required": ["repository", "ref", "sha"], "properties": {
      "repository": {"const": "Arvin-liu/when-systems-catch-fire"},
      "ref": {"const": "refs/heads/main"},
      "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
    }},
    "residuals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/residual"}},
    "claim_ceiling": {"type": "string", "minLength": 1, "pattern": "\\S"}
  },
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "residual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "residual_id", "origin_task", "classification", "status",
        "baseline_fingerprint", "current_fingerprint", "baseline_count", "current_count",
        "baseline_objects", "current_objects", "baseline_failure_dimensions", "current_failure_dimensions",
        "baseline_source_command", "current_source_command", "validator", "provenance_paths",
        "allowed_persistence_rule", "release_impact"
      ],
      "properties": {
        "residual_id": {"$ref": "#/$defs/nonblank"},
        "origin_task": {"$ref": "#/$defs/nonblank"},
        "classification": {"$ref": "#/$defs/nonblank"},
        "status": {"enum": ["OPEN_INHERITED", "SEALED_HISTORICAL", "ENVIRONMENTAL", "RESOLVED_CURRENT", "PARTIALLY_RESOLVED", "NEW_REGRESSION", "NEW_RESIDUAL_REQUIRES_CLASSIFICATION"]},
        "baseline_fingerprint": {"$ref": "#/$defs/sha256"},
        "current_fingerprint": {"$ref": "#/$defs/sha256"},
        "baseline_count": {"type": "integer", "minimum": 0},
        "current_count": {"type": "integer", "minimum": 0},
        "baseline_objects": {"type": "array", "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
        "current_objects": {"type": "array", "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
        "baseline_failure_dimensions": {"type": "array", "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
        "current_failure_dimensions": {"type": "array", "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
        "baseline_source_command": {"$ref": "#/$defs/nonblank"},
        "current_source_command": {"$ref": "#/$defs/nonblank"},
        "validator": {"$ref": "#/$defs/nonblank"},
        "provenance_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
        "allowed_persistence_rule": {"$ref": "#/$defs/nonblank"},
        "release_impact": {"enum": ["NON_BLOCKING_IF_UNCHANGED", "NON_BLOCKING_RESOLVED", "RELEASE_BLOCKING", "HISTORICAL_ONLY", "ENVIRONMENTAL_ONLY"]},
        "migration": {"type": "object", "additionalProperties": false, "required": ["task_id", "reason", "from_source_command", "to_source_command"], "properties": {
          "task_id": {"$ref": "#/$defs/nonblank"},
          "reason": {"$ref": "#/$defs/nonblank"},
          "from_source_command": {"$ref": "#/$defs/nonblank"},
          "to_source_command": {"$ref": "#/$defs/nonblank"}
        }}
      }
    }
  }
}
