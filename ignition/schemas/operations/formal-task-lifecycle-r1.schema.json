{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/formal-task-lifecycle-r1.schema.json",
  "title": "Ignition independent formal task lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "authority", "current_task_id", "tasks", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "formal-task-lifecycle-r1"},
    "contract_id": {"const": "FORMAL_TASK_TERMINALITY_INDEPENDENT_OF_OPEN_OBLIGATION"},
    "authority": {"const": "FORMAL_TASK_LIFECYCLE"},
    "current_task_id": {"$ref": "#/$defs/taskId"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    },
    "claim_ceiling": {"$ref": "#/$defs/nonblank"}
  },
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "taskId": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "execution_status", "terminal", "scope_complete", "identity_impact", "terminal_basis", "open_obligation_ids", "evidence_refs", "claim_ceiling"],
      "properties": {
        "task_id": {"$ref": "#/$defs/taskId"},
        "execution_status": {"enum": ["IN_PROGRESS", "COMPLETED_WITH_CLASSIFIED_RESIDUALS", "COMPLETED_WITH_OPEN_OBLIGATIONS"]},
        "terminal": {"type": "boolean"},
        "scope_complete": {"type": "boolean"},
        "identity_impact": {"enum": ["NONE", "PRESENTATION_ONLY", "ARCHITECTURE_CHANGED"]},
        "terminal_basis": {"$ref": "#/$defs/nonblank"},
        "open_obligation_ids": {"type": "array", "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
        "claim_ceiling": {"$ref": "#/$defs/nonblank"}
      }
    }
  }
}
