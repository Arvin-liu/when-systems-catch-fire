{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pointfire.local/schemas/architecture-impact-classification-r1.schema.json",
  "title": "Ignition semantic architecture-impact classification R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "classification", "legacy_identity_impact",
    "semantic_changes", "architecture_markers", "behavioral_control_plane_markers",
    "changed_paths", "evidence", "current_identity_sync_required", "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "architecture-impact-classification-r1"},
    "classification": {"enum": ["NONE", "ARCHITECTURE_CHANGING", "BEHAVIORAL_CONTROL_PLANE_CHANGE", "PRESENTATION_ONLY", "RELEASE_ONLY", "DATA_REFRESH_ONLY"]},
    "legacy_identity_impact": {"enum": ["NONE", "PRESENTATION_ONLY", "ARCHITECTURE_CHANGED"]},
    "semantic_changes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "architecture_markers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "behavioral_control_plane_markers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "changed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "current_identity_sync_required": {"type": "boolean"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
