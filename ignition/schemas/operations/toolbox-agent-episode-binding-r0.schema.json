{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ignition:toolbox-agent-episode-binding-plan-r0",
  "title": "Optional Agent Episode Binding Plan R0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "binding_version",
    "episode_permission_ceiling",
    "contexts",
    "roles",
    "feedback_edges",
    "write_domain_bindings",
    "work_units",
    "aggregation_policy"
  ],
  "properties": {
    "episode_id": {"$ref": "#/$defs/id"},
    "binding_version": {"const": "r0"},
    "episode_permission_ceiling": {"$ref": "#/$defs/permissionCeiling"},
    "contexts": {
      "type": "array",
      "items": {"$ref": "#/$defs/context"}
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/role"}
    },
    "feedback_edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/feedbackEdge"}
    },
    "write_domain_bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/writeDomainBinding"}
    },
    "work_units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/workUnit"}
    },
    "aggregation_policy": {"$ref": "#/$defs/nonblank"}
  },
  "$defs": {
    "nonblank": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "textList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonblank"}
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "permissionCeiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_tool_ids", "allowed_read_domains", "allowed_write_domains"],
      "properties": {
        "allowed_tool_ids": {"$ref": "#/$defs/idList"},
        "allowed_read_domains": {"$ref": "#/$defs/idList"},
        "allowed_write_domains": {"$ref": "#/$defs/idList"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "sha256", "visibility", "owner_role_id", "authorized_role_ids"],
      "properties": {
        "context_id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "visibility": {"enum": ["ROLE_PRIVATE", "SHARED_DECLARED"]},
        "owner_role_id": {"$ref": "#/$defs/id"},
        "authorized_role_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "role_class",
        "responsibility",
        "allowed_inputs",
        "allowed_outputs",
        "allowed_tool_ids",
        "allowed_read_domains",
        "allowed_write_domains",
        "context_ids",
        "validation_obligations",
        "can_change_future_inputs",
        "can_signal_hard_stop",
        "can_request_owner_review",
        "claim_ceiling"
      ],
      "properties": {
        "role_id": {"$ref": "#/$defs/id"},
        "role_class": {"enum": ["EXECUTOR", "VALIDATOR", "AUDITOR", "SYNTHESIZER", "COORDINATOR"]},
        "responsibility": {"$ref": "#/$defs/nonblank"},
        "allowed_inputs": {"$ref": "#/$defs/textList"},
        "allowed_outputs": {"$ref": "#/$defs/textList"},
        "allowed_tool_ids": {"$ref": "#/$defs/idList"},
        "allowed_read_domains": {"$ref": "#/$defs/idList"},
        "allowed_write_domains": {"$ref": "#/$defs/idList"},
        "context_ids": {"$ref": "#/$defs/idList"},
        "validation_obligations": {"$ref": "#/$defs/textList"},
        "can_change_future_inputs": {"type": "boolean"},
        "can_signal_hard_stop": {"type": "boolean"},
        "can_request_owner_review": {"type": "boolean"},
        "claim_ceiling": {"$ref": "#/$defs/nonblank"}
      }
    },
    "feedbackEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "source_role_id",
        "target_role_id",
        "channel_class",
        "allowed_message_kinds",
        "can_change_future_inputs",
        "can_stop_future_work",
        "can_request_owner_review",
        "informational_only",
        "hard_stop_policy_ref"
      ],
      "properties": {
        "channel_id": {"$ref": "#/$defs/id"},
        "source_role_id": {"$ref": "#/$defs/id"},
        "target_role_id": {"$ref": "#/$defs/id"},
        "channel_class": {
          "enum": ["NO_CHANNEL", "ONE_WAY_OBSERVATION", "VALIDATION_ONLY", "HARD_STOP_ONLY", "BIDIRECTIONAL_COORDINATION"]
        },
        "allowed_message_kinds": {"$ref": "#/$defs/idList"},
        "can_change_future_inputs": {"type": "boolean"},
        "can_stop_future_work": {"type": "boolean"},
        "can_request_owner_review": {"type": "boolean"},
        "informational_only": {"type": "boolean"},
        "hard_stop_policy_ref": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nonblank"}
          ]
        }
      }
    },
    "writeDomainBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "role_id", "write_domain", "exclusivity", "effect_class", "resource_intent_id"],
      "properties": {
        "binding_id": {"$ref": "#/$defs/id"},
        "role_id": {"$ref": "#/$defs/id"},
        "write_domain": {"$ref": "#/$defs/id"},
        "exclusivity": {"enum": ["READ_SHARED", "WRITE_EXCLUSIVE"]},
        "effect_class": {"enum": ["READ_ONLY", "LOCAL_WRITE", "EXTERNAL_EFFECT", "UNKNOWN_EFFECT"]},
        "resource_intent_id": {"$ref": "#/$defs/id"}
      }
    },
    "workUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_unit_id",
        "role_id",
        "depends_on",
        "context_ids",
        "input_types",
        "output_types",
        "effect_class",
        "write_binding_ids"
      ],
      "properties": {
        "work_unit_id": {"$ref": "#/$defs/id"},
        "role_id": {"$ref": "#/$defs/id"},
        "depends_on": {"$ref": "#/$defs/idList"},
        "context_ids": {"$ref": "#/$defs/idList"},
        "input_types": {"$ref": "#/$defs/textList"},
        "output_types": {"$ref": "#/$defs/textList"},
        "effect_class": {"enum": ["READ_ONLY", "LOCAL_WRITE", "EXTERNAL_EFFECT", "UNKNOWN_EFFECT"]},
        "write_binding_ids": {"$ref": "#/$defs/idList"}
      }
    }
  }
}
