{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/task150-step20-functional-versus-aesthetic-boundary-r1.schema.json",
  "title": "Task150 Step20 functional visual admission versus aesthetic endorsement",
  "description": "Independent functional and aesthetic boundaries for the provider-neutral bounded visualization operation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "step",
    "record_type",
    "status",
    "formal_previous_commit",
    "owner_decision",
    "operation",
    "boundary_matrix",
    "forbidden_claim_labels",
    "scope_boundaries",
    "validation_contract",
    "result",
    "next_step",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "ignition-150-step20-functional-versus-aesthetic-boundary-r1"},
    "task_id": {"const": "IGNITION-20260901-150"},
    "step": {"const": "20"},
    "record_type": {"const": "FUNCTIONAL_VERSUS_AESTHETIC_BOUNDARY"},
    "status": {"const": "BOUNDARY_DEFINED_AND_VALIDATED"},
    "formal_previous_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "owner_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "functional_visual_admission", "owner_aesthetic_endorsement", "aesthetic_endorsement_not_required_for_operation_scope", "owner_rejected_visual", "owner_visual_accepted"],
      "properties": {
        "decision": {"const": "REOPEN_TASK150_WITH_SCOPE_SPLIT"},
        "functional_visual_admission": {"const": "ALLOWED_TO_PROCEED"},
        "owner_aesthetic_endorsement": {"const": "NOT_GRANTED"},
        "aesthetic_endorsement_not_required_for_operation_scope": {"const": true},
        "owner_rejected_visual": {"const": false},
        "owner_visual_accepted": {"const": false}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "operation_definition_is_provider_neutral", "ownership", "functional_boundary", "aesthetic_boundary"],
      "properties": {
        "operation_id": {"const": "visualization.render_derived_system_view"},
        "operation_definition_is_provider_neutral": {"const": true},
        "ownership": {"const": "IGNITION"},
        "functional_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "admission_state", "current_status", "criteria", "required_evidence_step", "claim_ceiling", "does_not_imply"],
          "properties": {
            "decision": {"const": "ALLOWED_TO_PROCEED"},
            "admission_state": {"const": "PROCEED_TO_FRESH_STANDALONE_EVIDENCE"},
            "current_status": {"const": "NOT_ADMITTED_PENDING_STEP21"},
            "criteria": {
              "type": "array",
              "minItems": 7,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "class", "status"],
                "properties": {
                  "id": {"type": "string"},
                  "class": {"const": "FUNCTIONAL"},
                  "status": {"const": "REQUIRES_STEP21_EVIDENCE"}
                }
              }
            },
            "required_evidence_step": {"const": "21"},
            "claim_ceiling": {"type": "string"},
            "does_not_imply": {"type": "array", "items": {"type": "string"}}
          }
        },
        "aesthetic_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "claimed", "required_for_current_technical_scope", "criteria", "future_use_requires_separate_gate", "future_use_gate_scope", "claim_ceiling"],
          "properties": {
            "decision": {"const": "NOT_GRANTED"},
            "claimed": {"const": false},
            "required_for_current_technical_scope": {"const": false},
            "criteria": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "class", "status"],
                "properties": {
                  "id": {"type": "string"},
                  "class": {"const": "AESTHETIC"},
                  "status": {"type": "string"}
                }
              }
            },
            "future_use_requires_separate_gate": {"const": true},
            "future_use_gate_scope": {"const": ["HOMEPAGE", "PUBLICATION_HERO", "BRANDED_ASSET"]},
            "claim_ceiling": {"type": "string"}
          }
        }
      }
    },
    "boundary_matrix": {
      "type": "array",
      "const": [
        {
          "case": "functional_evidence_not_yet_proven_aesthetic_endorsement_absent",
          "functional_result": "NOT_ADMITTED",
          "aesthetic_result": "NOT_GRANTED",
          "permitted_use": "NO_CURRENT_OR_PUBLIC_USE"
        },
        {
          "case": "functional_evidence_passes_aesthetic_endorsement_absent",
          "functional_result": "CURRENT_BOUNDED_CANDIDATE_ELIGIBLE",
          "aesthetic_result": "NOT_GRANTED",
          "permitted_use": "DECLARED_TECHNICAL_BOUNDED_USE_ONLY"
        },
        {
          "case": "aesthetic_endorsement_present_without_functional_evidence",
          "functional_result": "NOT_ADMITTED",
          "aesthetic_result": "SEPARATE_ENDORSEMENT_ONLY",
          "permitted_use": "NO_FUNCTIONAL_ADMISSION"
        },
        {
          "case": "future_publication_or_branded_use",
          "functional_result": "RELEVANT_FUNCTIONAL_GATE_REQUIRED",
          "aesthetic_result": "SEPARATE_GATE_REQUIRED",
          "permitted_use": "NOT_AVAILABLE_IN_STEP20"
        }
      ]
    },
    "forbidden_claim_labels": {
      "const": ["OWNER_REJECTED_VISUAL", "OWNER_VISUAL_ACCEPTED"]
    },
    "scope_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture_delta", "delta_viewport_gate", "current_registry_operation_count", "registry_write", "default_renderer", "archify_architecture_authority", "agent_reach", "authenticated_channel_admission", "live_external_invocation", "task151"],
      "properties": {
        "architecture_delta": {"const": "EXPERIMENTAL_EXTENSION_DEFERRED"},
        "delta_viewport_gate": {"const": "FAIL_DEFERRED"},
        "current_registry_operation_count": {"const": 19},
        "registry_write": {"const": false},
        "default_renderer": {"const": "NOT_SELECTED"},
        "archify_architecture_authority": {"const": false},
        "agent_reach": {"const": "NO_CHANGE"},
        "authenticated_channel_admission": {"const": "NO_CHANGE"},
        "live_external_invocation": {"const": "UNCHANGED_OPEN_OWNER_DEFERRED_NOT_RUN"},
        "task151": {"const": "FORBIDDEN"}
      }
    },
    "validation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functional_and_aesthetic_are_independent", "functional_pass_without_aesthetic_does_not_create_aesthetic_claim", "aesthetic_endorsement_without_functional_evidence_does_not_create_functional_admission", "future_public_or_branded_use_requires_separate_aesthetic_gate", "step20_does_not_claim_fresh_visual_evidence", "step20_does_not_claim_current_integration"],
      "properties": {
        "functional_and_aesthetic_are_independent": {"const": true},
        "functional_pass_without_aesthetic_does_not_create_aesthetic_claim": {"const": true},
        "aesthetic_endorsement_without_functional_evidence_does_not_create_functional_admission": {"const": true},
        "future_public_or_branded_use_requires_separate_aesthetic_gate": {"const": true},
        "step20_does_not_claim_fresh_visual_evidence": {"const": true},
        "step20_does_not_claim_current_integration": {"const": true}
      }
    },
    "result": {"const": "TASK150_STEP20_FUNCTIONAL_VERSUS_AESTHETIC_BOUNDARY_PASS"},
    "next_step": {"const": "TASK150_STEP21_FRESH_STANDALONE_EVIDENCE"},
    "claim_ceiling": {"type": "string"}
  }
}
