{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/generator-source-contract.schema.json",
  "title": "Generator source contract",
  "description": "Explicit source and output boundary for a deterministic repository generator. This contract does not grant execution, truth, Owner, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "purpose", "generators"],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "purpose": {"type": "string", "minLength": 1},
    "generators": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/generator"}
    }
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator_id", "canonical_tool", "source_authorities", "output_paths", "freshness_mode", "claim_ceiling"],
      "properties": {
        "generator_id": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
        "canonical_tool": {"$ref": "#/$defs/path"},
        "source_authorities": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/path"},
          "uniqueItems": true
        },
        "output_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/path"},
          "uniqueItems": true
        },
        "freshness_mode": {"enum": ["byte_level_recompute", "semantic_diff"]},
        "claim_ceiling": {"type": "string", "minLength": 1}
      }
    }
  }
}
