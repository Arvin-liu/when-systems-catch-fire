{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "profile_contract",
    "parent_profile_sha256",
    "parent_entry_count",
    "entry_count",
    "extension_entries"
  ],
  "properties": {
    "schema_version": {"const": "state-changelog-profile-r2"},
    "profile_contract": {"const": "R1_PREFIX_PLUS_ONE_APPEND"},
    "parent_profile_sha256": {"const": "8a431819d3ad59702cd0cf24e324f9082400c3b84828cbf3c06fe9fb0ce5c96c"},
    "parent_entry_count": {"const": 56},
    "entry_count": {"const": 57},
    "extension_entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["ordinal", "date", "label", "profile", "section_sha256"],
        "properties": {
          "ordinal": {"const": 57},
          "date": {"type": "string", "format": "date"},
          "label": {"type": "string", "minLength": 1},
          "profile": {"const": "current-project-identity-r1"},
          "section_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
