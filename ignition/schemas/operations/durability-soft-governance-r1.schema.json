{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/schemas/operations/durability-soft-governance-r1.schema.json",
  "type": "object",
  "required": ["schema_version", "state_id", "format_epoch", "status", "claim_ceiling", "transition_grammar_version", "structural_surface_version", "projection_versions", "soft_exposure_receipt_ref", "experiment_protocol_state", "authority_effects"],
  "properties": {
    "schema_version": {"const": "ignition-durability-soft-governance-r1"},
    "state_id": {"type": "string", "minLength": 1},
    "format_epoch": {"type": "integer", "minimum": 1, "maximum": 2},
    "status": {"enum": ["CANDIDATE_ESI_SIGNAL", "READY_NOT_RUN", "NOT_RUN_LIVE_EXTERNAL", "ADVISORY_ONLY", "WITHDRAWN"]},
    "claim_ceiling": {"type": "string", "minLength": 20},
    "transition_grammar_version": {"type": "string", "minLength": 1},
    "structural_surface_version": {"type": "string", "minLength": 1},
    "projection_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "soft_exposure_receipt_ref": {"type": "string", "minLength": 1},
    "experiment_protocol_state": {"type": "string", "minLength": 1},
    "authority_effects": {"type": "object", "required": ["capability_delta", "permission_delta", "authorization_delta", "truth_status_delta", "owner_status_delta", "epistemic_acceptance_delta", "safety_delta"], "additionalProperties": false, "properties": {
      "capability_delta": {"const": "NONE"}, "permission_delta": {"const": "NONE"}, "authorization_delta": {"const": "NONE"}, "truth_status_delta": {"const": "NONE"}, "owner_status_delta": {"const": "NONE"}, "epistemic_acceptance_delta": {"const": "NONE"}, "safety_delta": {"const": "NONE"}
    }},
    "withdrawal_reason": {"type": "string"}
  },
  "additionalProperties": false
}
