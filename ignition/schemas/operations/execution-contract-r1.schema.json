{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/execution-contract-r1.schema.json",
  "title": "Ignition formal execution contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "task_id", "control_source", "formal_baseline", "identity_impact", "expected_task_branch", "expected_receipt_branch", "required_release_ref", "no_owner_intermediate", "identity_expectations", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "execution-contract-r1"},
    "contract_id": {"const": "IGNITION_EXECUTION_CONTRACT_R1"},
    "task_id": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"},
    "control_source": {"$ref": "#/$defs/controlSource"},
    "formal_baseline": {"$ref": "#/$defs/formalBaseline"},
    "identity_impact": {"enum": ["NONE", "PRESENTATION_ONLY", "ARCHITECTURE_CHANGED"]},
    "expected_task_branch": {"$ref": "#/$defs/nonblank"},
    "expected_receipt_branch": {"$ref": "#/$defs/nonblank"},
    "draft_pr_only": {"const": true},
    "owner_authorization_required_for_ready_merge_or_close": {"const": true},
    "required_release_ref": {"const": "refs/heads/main"},
    "no_owner_intermediate": {"const": true},
    "identity_expectations": {"$ref": "#/$defs/identityExpectations"},
    "claim_ceiling": {"type": "string", "minLength": 1, "pattern": "\\S"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "controlSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "command_path"],
      "properties": {
        "repository": {"const": "Arvin-liu/1111"},
        "ref": {"const": "origin/relay/current"},
        "commit": {"$ref": "#/$defs/sha"},
        "command_path": {"type": "string", "pattern": "^agent-commands/IGNITION-[0-9]{8}-[0-9]{3}-.+\\.md$"},
        "command_record_commit": {"$ref": "#/$defs/sha"}
      }
    },
    "formalBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "sha"],
      "properties": {
        "repository": {"const": "Arvin-liu/when-systems-catch-fire"},
        "ref": {"const": "refs/heads/main"},
        "sha": {"$ref": "#/$defs/sha"}
      }
    },
    "identityExpectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_formal_task", "latest_architecture_changing_task", "previous_canonical_current_task", "previous_formal_task", "release_candidate_task", "publication_witness_task"],
      "properties": {
        "current_formal_task": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"},
        "latest_architecture_changing_task": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"},
        "previous_canonical_current_task": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"},
        "previous_formal_task": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"},
        "release_candidate_task": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"},
        "publication_witness_task": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"}
      }
    }
  }
}
