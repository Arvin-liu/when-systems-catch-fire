      ],
      "properties": {
        "path": {
          "const": "data/operations/state-changelog-profile-r3.json"
        },
        "schema_version": {
          "const": "state-changelog-profile-r3"
        },
        "sha256": {
          "const": "b52f2c3886f09b91fcf677c18ca1d9dc8ae658e2d233bcad357965cb649e4d2d"
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": [
        "owner",
        "repository",
        "commit",
        "path",
        "blob_sha1",
        "append_profile"
      ],
      "properties": {
        "owner": {
          "const": "Arvin-liu"
        },
        "repository": {
          "const": "Arvin-liu/1111"
        },
        "commit": {
          "const": "ea631933be075684ef8de663e202db2ea9523221"
        },
        "path": {
          "const": "instructions/goal-mode/IGNITION-2026-10-30-ONE-TIME-R3-V1-CLOSEOUT-EXECUTION-DELEGATION-R0.json"
        },
        "blob_sha1": {
          "const": "e93a53eabe7007a2447c9677f9a8d7b7f2428646"
        },
        "append_profile": {
          "const": "task20-v1-homepage-r1"
        }
      },
