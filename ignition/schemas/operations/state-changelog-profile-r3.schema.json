      "properties": {
        "path": {
          "const": "data/operations/state-changelog-profile-r2.json"
        },
        "schema_version": {
          "const": "state-changelog-profile-r2"
        },
        "sha256": {
          "const": "5b866d55e04ffc0fae8e89b19552084f04846df96b310eccbc24ffe7a2acd235"
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": [
        "owner",
        "repository",
        "commit",
        "path",
        "blob_sha1",
        "append_profile"
      ],
      "properties": {
        "owner": {
          "const": "Arvin-liu"
        },
        "repository": {
          "const": "Arvin-liu/1111"
        },
        "commit": {
          "const": "44de013f09b63535fe16b1e38cab7eff4d68ae66"
        },
        "path": {
          "const": "instructions/goal-mode/IGNITION-2026-10-24-SIGNED-OWNER-WEB-MERGE-REGISTRATION-COMPATIBILITY-R0.md"
        },
        "blob_sha1": {
          "const": "6a5d36cb6c40170c1b85440047eaceda097cee8b"
        },
        "append_profile": {
          "const": "task20-current-lineage-r1"
        }
      },
