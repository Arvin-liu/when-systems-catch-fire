{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "profile_contract",
    "parent_profile",
    "authorization",
    "entry_count",
    "active_current_ordinals",
    "historical_entry_count",
    "legacy_profile_count",
    "profiles",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "state-changelog-profile-r3"
