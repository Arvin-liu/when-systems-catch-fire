{
  "$defs": {
    "completionState": {
      "additionalProperties": false,
      "properties": {
        "external_synchronization_attested": {
          "type": "boolean"
        },
        "external_synchronization_required": {
          "type": "boolean"
        },
        "implementation_complete": {
          "type": "boolean"
        },
        "project_synchronization_complete": {
          "type": "boolean"
        },
        "repository_synchronization_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "implementation_complete",
        "repository_synchronization_complete",
        "external_synchronization_required",
        "external_synchronization_attested",
        "project_synchronization_complete"
      ],
      "type": "object"
    },
    "evidenceReference": {
      "pattern": "^([^:\\s][^\\s]*|repo:[^\\s]+|external:(pr_body|1111_receipt|live_refetch|github_actions):[^\\s]+)$",
      "type": "string"
    },
    "externalAttestation": {
      "additionalProperties": false,
      "properties": {
        "historical_note": {
          "type": "string"
        },
        "historical_reference": {
          "const": true
        },
        "authority": {
          "const": "pull_request_body_and_1111_receipt"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/evidenceReference"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "live_state_locally_verifiable": {
          "const": false
        },
        "stage": {
          "enum": [
            "pre_merge",
            "post_merge"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "attested"
          ]
        },
        "surface_id": {
          "$ref": "#/$defs/nonblankString"
        }
      },
      "required": [
        "surface_id",
        "stage",
        "status",
        "authority",
        "evidence_refs",
        "live_state_locally_verifiable"
      ],
      "type": "object"
    },
    "externalAttestationPolicy": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "pull_request_body_and_1111_receipt"
        },
        "live_refetch_before_acceptance_or_merge": {
          "const": true
        },
        "required": {
          "const": true
        },
        "required_workflows": {
          "items": {
            "enum": [
              "foundation-validation",
              "function-os-ci"
            ]
          },
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "required",
        "authority",
        "required_workflows",
        "live_refetch_before_acceptance_or_merge"
      ],
      "type": "object"
    },
    "historicalValidationItem": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "$ref": "#/$defs/nonblankString"
        },
        "evidence": {
          "$ref": "#/$defs/nonblankString"
        },
        "evidence_scope": {
          "const": "historical_subject_head_only"
        },
        "name": {
          "$ref": "#/$defs/nonblankString"
        },
        "run_id": {
          "$ref": "#/$defs/positiveRunId"
        },
        "status": {
          "$ref": "#/$defs/nonblankString"
        },
        "subject_head": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "name",
        "status",
        "evidence",
        "evidence_scope",
        "subject_head",
        "run_id",
        "conclusion"
      ],
      "type": "object"
    },
    "nonblankString": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "nonblankStringArray": {
      "items": {
        "$ref": "#/$defs/nonblankString"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "positiveRunId": {
      "minimum": 1,
      "type": "integer"
    },
    "propagationClosureBinding": {
      "additionalProperties": false,
      "properties": {
        "base_identity": {
          "$ref": "#/$defs/sha"
        },
        "closure_complete": {
          "type": "boolean"
        },
        "closure_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "closure_path": {
          "$ref": "#/$defs/nonblankString"
        },
        "component_decisions": {
          "items": {
            "$ref": "#/$defs/propagationDecision"
          },
          "minItems": 1,
          "type": "array"
        },
        "head_identity": {
          "$ref": "#/$defs/nonblankString"
        },
        "impact_report_path": {
          "$ref": "#/$defs/nonblankString"
        },
        "registry_derived_surfaces": {
          "$ref": "#/$defs/nonblankStringArray"
        },
        "request_path": {
          "$ref": "#/$defs/nonblankString"
        },
        "residue_path": {
          "$ref": "#/$defs/nonblankString"
        },
        "resolved_components": {
          "$ref": "#/$defs/nonblankStringArray"
        },
        "seed_components": {
          "$ref": "#/$defs/nonblankStringArray"
        },
        "seed_paths": {
          "$ref": "#/$defs/nonblankStringArray"
        },
        "surface_decisions": {
          "items": {
            "$ref": "#/$defs/propagationDecision"
          },
          "minItems": 1,
          "type": "array"
        },
        "system_map_delta_path": {
          "$ref": "#/$defs/nonblankString"
        },
        "system_map_impact": {
          "additionalProperties": false,
          "properties": {
            "decision": {
              "enum": [
                "CHANGE",
                "NO_CHANGE_WITH_REASON"
              ]
            },
            "delta_path": {
              "$ref": "#/$defs/nonblankString"
            },
            "reason": {
              "$ref": "#/$defs/nonblankString"
            }
          },
          "required": [
            "decision",
            "reason",
            "delta_path"
          ],
          "type": "object"
        },
        "typed_path_ids": {
          "items": {
            "$ref": "#/$defs/nonblankString"
          },
          "type": "array",
          "uniqueItems": true
        },
        "unresolved_residue": {
          "items": {
            "$ref": "#/$defs/nonblankString"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "request_path",
        "closure_path",
        "impact_report_path",
        "system_map_delta_path",
        "residue_path",
        "closure_hash",
        "base_identity",
        "head_identity",
        "seed_paths",
        "seed_components",
        "resolved_components",
        "typed_path_ids",
        "component_decisions",
        "surface_decisions",
        "registry_derived_surfaces",
        "system_map_impact",
        "unresolved_residue",
        "closure_complete"
      ],
      "type": "object"
    },
    "propagationDecision": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "CHANGE",
            "NO_CHANGE_WITH_REASON",
            "NOT_APPLICABLE"
          ]
        },
        "item_id": {
          "$ref": "#/$defs/nonblankString"
        },
        "reason": {
          "$ref": "#/$defs/nonblankString"
        }
      },
      "required": [
        "item_id",
        "decision",
        "reason"
      ],
      "type": "object"
    },
    "sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "stateTransition": {
      "additionalProperties": false,
      "properties": {
        "changed_dimensions": {
          "items": {
            "enum": [
              "capability",
              "identity",
              "usage",
              "handoff",
              "lifecycle_current_state",
              "governance",
              "deployment_rendering",
              "operations_method"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "maximum_claim_boundary": {
          "$ref": "#/$defs/nonblankString"
        },
        "prior_state": {
          "$ref": "#/$defs/nonblankString"
        },
        "proposed_state": {
          "$ref": "#/$defs/nonblankString"
        },
        "source_refs": {
          "$ref": "#/$defs/nonblankStringArray"
        },
        "subjects": {
          "$ref": "#/$defs/nonblankStringArray"
        }
      },
      "required": [
        "subjects",
        "prior_state",
        "proposed_state",
        "changed_dimensions",
        "source_refs",
        "maximum_claim_boundary"
      ],
      "type": "object"
    },
    "surfaceDecision": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "CHANGE",
            "NO_CHANGE_WITH_REASON",
            "NOT_APPLICABLE"
          ]
        },
        "derived_from": {
          "items": {
            "$ref": "#/$defs/nonblankString"
          },
          "type": "array",
          "uniqueItems": true
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/evidenceReference"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "reason": {
          "$ref": "#/$defs/nonblankString"
        },
        "surface_id": {
          "$ref": "#/$defs/nonblankString"
        },
        "validation_mode": {
          "$ref": "#/$defs/nonblankString"
        }
      },
      "required": [
        "surface_id",
        "decision",
        "reason",
        "evidence_refs",
        "validation_mode"
      ],
      "type": "object"
    },
    "synchronizationClosure": {
      "additionalProperties": false,
      "properties": {
        "external_attestations": {
          "items": {
            "$ref": "#/$defs/externalAttestation"
          },
          "type": "array"
        },
        "external_verification_policy": {
          "$ref": "#/$defs/nonblankString"
        },
      "live_external_surfaces_verified": {
        "type": "boolean"
        },
        "registry_path": {
          "const": "data/operations/synchronization-surfaces.json"
        },
        "registry_version": {
          "$ref": "#/$defs/nonblankString"
        },
        "surface_decisions": {
          "items": {
            "$ref": "#/$defs/surfaceDecision"
          },
          "minItems": 1,
          "type": "array"
        },
        "unresolved_residue": {
          "items": {
            "type": "object"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "registry_path",
        "registry_version",
        "surface_decisions",
        "external_attestations",
        "unresolved_residue",
        "external_verification_policy",
        "live_external_surfaces_verified"
      ],
      "type": "object"
    },
    "validationItem": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "$ref": "#/$defs/nonblankString"
        },
        "evidence": {
          "$ref": "#/$defs/nonblankString"
        },
        "head": {
          "$ref": "#/$defs/sha"
        },
        "name": {
          "$ref": "#/$defs/nonblankString"
        },
        "run_id": {
          "$ref": "#/$defs/positiveRunId"
        },
        "status": {
          "$ref": "#/$defs/nonblankString"
        }
      },
      "required": [
        "name",
        "status",
        "evidence"
      ],
      "type": "object"
    }
  },
  "$id": "https://example.invalid/ignition/operations/iteration-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "method_version": {
            "enum": [
              "1.1.0",
              "1.2.0",
              "1.3.0"
            ]
          }
        },
        "required": [
          "method_version"
        ]
      },
      "then": {
        "required": [
          "completion_seal_path",
          "state_transition",
          "synchronization_closure",
          "completion_state"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method_version": {
            "enum": [
              "1.2.0",
              "1.3.0"
            ]
          }
        },
        "required": [
          "method_version"
        ]
      },
      "then": {
        "required": [
          "propagation_closure"
        ]
      }
    }
  ],
  "properties": {
    "branch_pr": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/nonblankString"
        },
        "base_head": {
          "$ref": "#/$defs/sha"
        },
        "branch": {
          "$ref": "#/$defs/nonblankString"
        },
        "draft": {
          "type": "boolean"
        },
        "merge_commit": {
          "$ref": "#/$defs/sha"
        },
        "merged": {
          "type": "boolean"
        },
        "pr_number": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "branch",
        "pr_number",
        "base",
        "base_head",
        "draft",
        "merged"
      ],
      "type": "object"
    },
    "change_classification": {
      "items": {
        "enum": [
          "REPAIR",
          "CAPABILITY_ADDITION",
          "INTERFACE_CHANGE",
          "EVIDENCE_UPDATE",
          "GOVERNANCE_CHANGE",
          "RELEASE_OR_CURRENT_STATE_SYNC",
          "HISTORICAL_ONLY",
          "OPERATIONS_METHOD"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "changed_surfaces": {
      "$ref": "#/$defs/nonblankStringArray"
    },
    "claim_ceiling": {
      "$ref": "#/$defs/nonblankString"
    },
    "commit_chain": {
      "items": {
        "type": "object"
      },
      "minItems": 9,
      "type": "array"
    },
    "completion_seal_path": {
      "$ref": "#/$defs/nonblankString"
    },
    "completion_state": {
      "$ref": "#/$defs/completionState"
    },
    "contamination_scan": {
      "type": "object"
    },
    "current_method_version": {
      "const": "1.3.0"
    },
    "explicitly_unaffected_surfaces": {
      "$ref": "#/$defs/nonblankStringArray"
    },
    "gap": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/nonblankStringArray"
        },
        "smallest_material_action": {
          "$ref": "#/$defs/nonblankString"
        },
        "summary": {
          "$ref": "#/$defs/nonblankString"
        }
      },
      "required": [
        "summary",
        "evidence",
        "smallest_material_action"
      ],
      "type": "object"
    },
    "head_binding": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "pull_request_body_and_1111_receipt"
        },
        "embedded_exact_current_head": {
          "const": false
        },
        "explanation": {
          "$ref": "#/$defs/nonblankString"
        },
        "live_refetch_required": {
          "const": true
        },
        "mode": {
          "const": "external_exact_head_attestation"
        },
        "pr_number": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "receipt_path": {
          "$ref": "#/$defs/nonblankString"
        },
        "accepted_candidate_head": {
          "$ref": "#/$defs/sha"
        },
        "review_receipt_commit": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "mode",
        "pr_number",
        "authority",
        "receipt_path",
        "embedded_exact_current_head",
        "live_refetch_required",
        "explanation"
      ],
      "type": "object"
    },
    "impact_matrix": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "enum": [
              "CHANGE",
              "NO_CHANGE_WITH_REASON",
              "NOT_APPLICABLE"
            ]
          },
          "reason": {
            "$ref": "#/$defs/nonblankString"
          },
          "surface": {
            "$ref": "#/$defs/nonblankString"
          }
        },
        "required": [
          "surface",
          "decision",
          "reason"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "method_version": {
      "$ref": "#/$defs/nonblankString"
    },
    "phase_d_evidence": {
      "type": "object"
    },
    "phase_e_assets": {
      "type": "object"
    },
    "propagation_closure": {
      "$ref": "#/$defs/propagationClosureBinding"
    },
    "q29r": {
      "type": "object"
    },
    "receipt_location": {
      "$ref": "#/$defs/nonblankString"
    },
    "remaining_limitations": {
      "$ref": "#/$defs/nonblankStringArray"
    },
    "required_synchronization_decisions": {
      "$ref": "#/$defs/nonblankStringArray"
    },
    "rollback_strategy": {
      "$ref": "#/$defs/nonblankString"
    },
    "schema_tools_tests_workflows_reports_changed": {
      "$ref": "#/$defs/nonblankStringArray"
    },
    "self_hosting": {
      "type": "object"
    },
    "state_transition": {
      "$ref": "#/$defs/stateTransition"
    },
    "status": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "candidate": {
          "type": "boolean"
        },
        "current": {
          "type": "boolean"
        },
        "merged": {
          "type": "boolean"
        },
        "ready_for_gpt_verification": {
          "type": "boolean"
        }
      },
      "required": [
        "candidate",
        "ready_for_gpt_verification",
        "accepted",
        "merged",
        "current"
      ],
      "type": "object"
    },
    "synchronization_closure": {
      "$ref": "#/$defs/synchronizationClosure"
    },
    "task_id": {
      "pattern": "^[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "validation": {
      "additionalProperties": false,
      "properties": {
        "external_exact_head_policy": {
          "$ref": "#/$defs/externalAttestationPolicy"
        },
        "local": {
          "items": {
            "$ref": "#/$defs/validationItem"
          },
          "minItems": 1,
          "type": "array"
        },
        "remote": {
          "items": {
            "$ref": "#/$defs/historicalValidationItem"
          },
          "type": "array"
        }
      },
      "required": [
        "local",
        "remote",
        "external_exact_head_policy"
      ],
      "type": "object"
    },
    "verified_start": {
      "additionalProperties": false,
      "properties": {
        "main_head": {
          "$ref": "#/$defs/sha"
        },
        "source": {
          "$ref": "#/$defs/nonblankString"
        },
        "verified_at": {
          "$ref": "#/$defs/nonblankString"
        }
      },
      "required": [
        "main_head",
        "source",
        "verified_at"
      ],
      "type": "object"
    }
  },
  "required": [
    "method_version",
    "task_id",
    "change_classification",
    "verified_start",
    "branch_pr",
    "head_binding",
    "gap",
    "claim_ceiling",
    "status",
    "impact_matrix",
    "changed_surfaces",
    "validation",
    "rollback_strategy",
    "remaining_limitations",
    "receipt_location"
  ],
  "title": "Ignition Iteration Manifest",
  "type": "object"
}
