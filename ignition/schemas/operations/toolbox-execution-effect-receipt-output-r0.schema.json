{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ignition:toolbox-execution-effect-receipt-output-r0",
  "title": "Toolbox Execution Effect Receipt Output R0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "tool_id", "tool_version", "task_ref", "outcome_status", "execution_status", "run_id",
    "bound_observation_ids", "effect_states", "failure_preservation_declared", "findings", "warnings",
    "repository_effect_status", "repository_state_observations", "repository_bytes_read",
    "source_authentication", "referenced_bytes_read", "observer_independence", "repository_state_observer",
    "causal_attribution", "outcome_truth", "execution_authorized", "claim_ceiling", "input_sha256",
    "tool_source_sha256"
  ],
  "properties": {
    "schema_version": {"const": "toolbox-execution-effect-receipt-output-r0"},
    "tool_id": {"const": "maintenance.preflight_execution_effect_receipt"},
    "tool_version": {"const": "0.1.0"},
    "task_ref": {"type": "string", "minLength": 1},
    "outcome_status": {
      "enum": [
        "NO_RUN_RECORDED", "EXECUTION_UNKNOWN", "RUN_STARTED_OUTCOME_NOT_AVAILABLE",
        "BINDING_OR_COMPLETENESS_FINDINGS", "OUTCOME_RECORDED_CALLER_DECLARATION",
        "OUTCOME_WITH_UNRESOLVED_OBSERVATION", "OUTCOME_UNKNOWN"
      ]
    },
    "execution_status": {"enum": ["NOT_RUN", "STARTED", "COMPLETED", "UNKNOWN"]},
    "run_id": {"type": ["string", "null"]},
    "bound_observation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "effect_states": {"type": "array", "uniqueItems": true, "items": {"enum": ["EFFECT_PRESENT", "NO_EFFECT_OBSERVED", "UNKNOWN"]}},
    "failure_preservation_declared": {"type": "boolean"},
    "repository_effect_status": {
      "enum": [
        "NOT_REQUESTED", "INCOMPLETE", "DIFFERENCE_FROM_DECLARED_BASELINE_OBSERVED",
        "NO_DIFFERENCE_FROM_DECLARED_BASELINE_OBSERVED"
      ]
    },
    "repository_state_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "state", "sha256", "matches_baseline", "change", "bytes_read", "baseline_state", "baseline_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "state": {"enum": ["PRESENT", "MISSING", "SYMLINK", "NOT_REGULAR_FILE", "TOO_LARGE", "READ_ERROR", "PATH_REJECTED"]},
          "sha256": {"$ref": "#/$defs/sha256OrNull"},
          "matches_baseline": {"type": ["boolean", "null"]},
          "change": {"enum": ["ADDED", "REMOVED", "CHANGED", "UNCHANGED", "UNKNOWN"]},
          "bytes_read": {"type": "integer", "minimum": 0, "maximum": 1048576},
          "baseline_state": {"enum": ["PRESENT", "MISSING"]},
          "baseline_sha256": {"$ref": "#/$defs/sha256OrNull"}
        }
      }
    },
    "repository_bytes_read": {"type": "integer", "minimum": 0, "maximum": 4194304},
    "findings": {"$ref": "#/$defs/diagnostics"},
    "warnings": {"$ref": "#/$defs/diagnostics"},
    "source_authentication": {"const": "NOT_PERFORMED"},
    "referenced_bytes_read": {"const": false},
    "observer_independence": {"const": "ACTOR_REF_COMPARISON_ONLY"},
    "repository_state_observer": {"const": "LOCAL_READ_ONLY_RECHECK_OF_IGNITION_PATHS"},
    "causal_attribution": {"const": "NOT_ESTABLISHED"},
    "outcome_truth": {"const": "NOT_ESTABLISHED"},
    "execution_authorized": {"const": false},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "tool_source_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
