{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ignition:declared-permission-delta-r0",
  "title": "Declared Permission Delta Preflight R0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline", "candidate"],
  "properties": {
    "schema_version": {"const": "declared-permission-delta-r0"},
    "baseline": {"$ref": "#/$defs/snapshot"},
    "candidate": {"$ref": "#/$defs/snapshot"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "capability": {
      "enum": [
        "filesystem.read",
        "filesystem.write",
        "network.connect",
        "process.execute",
        "secrets.read",
        "billing.use",
        "external_action.invoke",
        "syscalls.use"
      ]
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "scope"],
      "properties": {
        "capability": {"$ref": "#/$defs/capability"},
        "scope": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "policy_id", "policy_revision", "subject_id", "grants"],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/identifier"},
        "policy_id": {"$ref": "#/$defs/identifier"},
        "policy_revision": {"$ref": "#/$defs/identifier"},
        "subject_id": {"$ref": "#/$defs/identifier"},
        "grants": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/grant"}
        }
      }
    }
  }
}
