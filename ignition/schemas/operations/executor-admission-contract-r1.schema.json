{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/executor-admission-contract-r1.schema.json",
  "title": "Provider-neutral executor admission contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "authority", "candidate_taxonomy", "required_gates", "result_binding", "live_policy", "candidates", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "executor-admission-contract-r1"},
    "contract_id": {"const": "EXECUTOR_ADMISSION_PROVIDER_NEUTRAL_R1"},
    "authority": {"const": "OS_EXECUTOR_ADMISSION"},
    "candidate_taxonomy": {"const": ["AGENTIC_EXECUTOR", "REASONER_RUNTIME", "TOOL", "UI_SURFACE"]},
    "required_gates": {"const": ["public_auth", "auth_separation", "argv_contract", "structured_result", "workspace", "capture", "validator_binding", "cleanup", "permission_ceiling", "exact_binding", "no_effect_scope"]},
    "result_binding": {"$ref": "#/$defs/resultBinding"},
    "live_policy": {"$ref": "#/$defs/livePolicy"},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "claim_ceiling": {"$ref": "#/$defs/nonblank"}
  },
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "status": {"enum": ["PASS", "FAIL", "PROVEN", "UNPROVEN", "STRICT", "REJECTED", "NOT_APPLICABLE", "NOT_OBSERVED", "NOT_RUN"]},
    "resultBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "validator_rule", "mismatch_policy"],
      "properties": {
        "required_fields": {"const": ["task_id", "dispatch_id", "attempt_id", "executor_id", "family", "lease_id", "workspace_digest_before", "workspace_digest_after", "capture_ref", "structured_result_ref", "validator_ref"]},
        "validator_rule": {"const": "ALL_REQUIRED_FIELDS_MUST_MATCH_ONE_DISPATCH_ATTEMPT_AND_EXACT_VALIDATOR_INPUT"},
        "mismatch_policy": {"const": "REJECT_COMPLETION_AND_DO_NOT_INFER_MISSING_FACTS"}
      }
    },
    "livePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_families", "max_attempts_total", "max_attempts_per_family", "stop_on_first_validated_completion", "child_spawn", "side_effect_scope", "workspace_mode"],
      "properties": {
        "eligible_families": {"const": ["AGENTIC_EXECUTOR"]},
        "max_attempts_total": {"const": 2},
        "max_attempts_per_family": {"const": 1},
        "stop_on_first_validated_completion": {"const": true},
        "child_spawn": {"const": "DENY"},
        "side_effect_scope": {"const": "SYNTHETIC_READ_ONLY_NO_CHANNEL_BROWSER_REMOTE_GIT_CONFIG_OR_BILLING"},
        "workspace_mode": {"const": "DISPOSABLE_READ_ONLY_FIXTURE"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor_id", "family", "provider_neutral_family", "observed_version", "public_auth", "auth_separation", "argv_contract", "structured_result", "workspace", "capture", "validator_binding", "cleanup", "permission_ceiling", "exact_binding", "no_effect_scope", "live_eligibility", "blockers", "evidence_refs", "class_separation", "claim_ceiling"],
      "properties": {
        "executor_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
        "family": {"enum": ["AGENTIC_EXECUTOR", "REASONER_RUNTIME", "TOOL", "UI_SURFACE"]},
        "provider_neutral_family": {"$ref": "#/$defs/nonblank"},
        "observed_version": {"$ref": "#/$defs/nonblank"},
        "public_auth": {"$ref": "#/$defs/status"},
        "auth_separation": {"$ref": "#/$defs/status"},
        "argv_contract": {"$ref": "#/$defs/status"},
        "structured_result": {"$ref": "#/$defs/status"},
        "workspace": {"$ref": "#/$defs/status"},
        "capture": {"$ref": "#/$defs/status"},
        "validator_binding": {"$ref": "#/$defs/status"},
        "cleanup": {"$ref": "#/$defs/status"},
        "permission_ceiling": {"$ref": "#/$defs/status"},
        "exact_binding": {"$ref": "#/$defs/status"},
        "no_effect_scope": {"$ref": "#/$defs/status"},
        "live_eligibility": {"enum": ["ELIGIBLE_FOR_LIVE_READONLY", "BLOCKED", "NOT_APPLICABLE", "NOT_OBSERVED"]},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
        "class_separation": {"enum": ["AGENTIC_EXECUTOR", "REASONER_RUNTIME", "TOOL", "UI_SURFACE"]},
        "claim_ceiling": {"$ref": "#/$defs/nonblank"}
      }
    }
  }
}
