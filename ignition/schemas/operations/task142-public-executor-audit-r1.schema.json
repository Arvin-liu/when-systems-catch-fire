{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/task142-public-executor-audit-r1.schema.json",
  "title": "Task142 public executor audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "step", "status", "observed_at", "executor_id", "family", "observation_policy", "public_probe", "auth", "gates", "admission", "adapter", "safety", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "task142-public-executor-audit-r1"},
    "task_id": {"const": "IGNITION-20260827-142"},
    "step": {"enum": ["06", "07", "08", "09"]},
    "status": {"const": "PASS"},
    "observed_at": {"type": "string", "format": "date-time"},
    "executor_id": {"type": "string", "pattern": "^external\\.[a-z0-9.-]+$"},
    "family": {"const": "AGENTIC_EXECUTOR"},
    "observation_policy": {"const": "PATH_VERSION_HELP_PUBLIC_AUTH_PRESENCE_ONLY_NO_SECRET_NO_INFERENCE"},
    "public_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_ref", "version", "version_code", "help_code", "binary_sha256", "help_sha256", "relevant_flags"],
      "properties": {
        "path_ref": {"type": "string", "pattern": "^PATH_ENTRY:[a-z0-9.-]+$"},
        "version": {"type": "string", "minLength": 1},
        "version_code": {"const": 0},
        "help_code": {"const": 0},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "help_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "relevant_flags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_status", "public_status_exit", "presence_ref", "present", "content_read"],
      "properties": {
        "public_status": {"enum": ["PASS", "FAIL", "NOT_OBSERVED"]},
        "public_status_exit": {"type": ["integer", "null"]},
        "presence_ref": {"type": "string", "pattern": "^AUTH_STATE_PRESENCE:external\\.[a-z0-9.-]+$"},
        "present": {"type": "boolean"},
        "content_read": {"const": false}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_auth", "auth_separation", "argv_contract", "structured_result", "workspace", "capture", "validator_binding", "cleanup", "permission_ceiling", "exact_binding", "no_effect_scope"],
      "properties": {
        "public_auth": {"enum": ["PASS", "FAIL", "NOT_OBSERVED"]},
        "auth_separation": {"enum": ["PROVEN", "UNPROVEN"]},
        "argv_contract": {"enum": ["STRICT", "REJECTED"]},
        "structured_result": {"enum": ["STRICT", "UNPROVEN", "REJECTED"]},
        "workspace": {"enum": ["PROVEN", "UNPROVEN"]},
        "capture": {"enum": ["PROVEN", "UNPROVEN"]},
        "validator_binding": {"enum": ["PROVEN", "UNPROVEN"]},
        "cleanup": {"enum": ["PROVEN", "UNPROVEN"]},
        "permission_ceiling": {"enum": ["PROVEN", "UNPROVEN"]},
        "exact_binding": {"enum": ["PROVEN", "UNPROVEN"]},
        "no_effect_scope": {"enum": ["PROVEN", "UNPROVEN"]}
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical_status", "live_eligibility", "blockers", "policy_blockers", "why_executor"],
      "properties": {
        "technical_status": {"enum": ["ADMITTED", "BLOCKED"]},
        "live_eligibility": {"enum": ["ELIGIBLE_FOR_LIVE_READONLY", "BLOCKED"]},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "policy_blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "why_executor": {"type": "string", "minLength": 1}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "translation_only", "agent_loop_added"],
      "properties": {
        "status": {"enum": ["ATTESTED", "NOT_ATTESTED"]},
        "adapter_ref": {"type": ["string", "null"]},
        "translation_only": {"const": true},
        "agent_loop_added": {"const": false}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_content_read", "auth_content_copied", "configuration_changed", "billing_changed", "install_or_upgrade_performed", "live_process_started", "live_inference_started", "workspace_modified", "ui_action_performed"],
      "properties": {
        "secret_content_read": {"const": false},
        "auth_content_copied": {"const": false},
        "configuration_changed": {"const": false},
        "billing_changed": {"const": false},
        "install_or_upgrade_performed": {"const": false},
        "live_process_started": {"const": false},
        "live_inference_started": {"const": false},
        "workspace_modified": {"const": false},
        "ui_action_performed": {"const": false}
      }
    },
    "claim_ceiling": {"type": "string", "minLength": 1, "pattern": "\\S"}
  }
}
