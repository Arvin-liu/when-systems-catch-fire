{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/schemas/operations/driver-recovery-surface-r2.schema.json",
  "type": "object",
  "required": ["schema_version", "projection_rule", "required_views", "soft_governance_rule", "human_first_rule", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "ignition-driver-recovery-surface-r2"},
    "projection_rule": {"const": "HUMAN_READABLE_PROJECTION_NOT_SECOND_CANONICAL_STATE"},
    "required_views": {"const": ["os_identity_schema_epoch", "trusted_snapshot_ledger_tail", "last_known_good", "episodes", "active_packs", "executor_admission_health_revocation", "budget_quota_pressure", "unresolved_recovery", "namespace_delegation", "soft_governance_esi", "recommended_actions", "technical_refs"]},
    "soft_governance_rule": {"const": "EXPLICIT_ADVISORY_OR_CANDIDATE_NO_TRUTH_PERMISSION_SAFETY_OWNER_OR_EPISTEMIC_ESCALATION"},
    "human_first_rule": {"const": "PLAIN_LANGUAGE_SUMMARY_PRECEDES_TECHNICAL_RECORD_LINKS"},
    "claim_ceiling": {"const": "OPERATOR_PROJECTION_ONLY_NO_EXTERNAL_COMPLETION_PRODUCTION_READINESS_OWNER_ACCEPTANCE_OR_EPISTEMIC_ACCEPTANCE"}
  },
  "additionalProperties": false
}
