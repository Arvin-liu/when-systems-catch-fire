{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/current-path-manifest-contract-r1.schema.json",
  "title": "Current path classification manifest contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "manifest_path", "source_kind", "validator_path", "historical_policy", "required_gates", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "current-path-manifest-contract-r1"},
    "contract_id": {"const": "CURRENT_PATH_MANIFEST_IS_CURRENT_INVARIANT"},
    "manifest_path": {"const": "ignition/data/foundation/repository-path-classification/classification-manifest.jsonl"},
    "source_kind": {"const": "CURRENT_GENERATED_SNAPSHOT_OF_LIVE_ENGINE_OUTPUT"},
    "validator_path": {"const": "ignition/tools/foundation/validate_repository_path_classification.py"},
    "historical_policy": {"const": "GIT_HISTORY_AND_TASK_RECEIPTS_PRESERVE_HISTORICAL_OBSERVATIONS;_CURRENT_MANIFEST_IS_REGENERATED"},
    "required_gates": {"type": "array", "const": ["tracked_set_equal_manifest_set", "unresolved_zero", "stale_zero", "duplicate_zero", "category_drift_zero", "anti_backflow_zero"]},
    "claim_ceiling": {"type": "string", "minLength": 1, "pattern": "\\S"}
  }
}
