{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/executor-qualification-campaign-r1.schema.json",
  "title": "IGNITION-143 executor qualification campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "task_id", "campaign_status", "qualification_scope", "policy", "families", "safety", "evidence_refs", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "executor-qualification-campaign-r1"},
    "campaign_id": {"type": "string", "pattern": "^ignition-143-qualification-r1$"},
    "task_id": {"const": "IGNITION-20260827-143"},
    "campaign_status": {"enum": ["QUALIFICATION_OPEN", "LIVE_EXECUTION_IN_PROGRESS", "TERMINAL"]},
    "qualification_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "policy": {"$ref": "#/$defs/policy"},
    "families": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/family"}},
    "safety": {"$ref": "#/$defs/safety"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_families", "max_attempts_per_family", "stop_on_first_validated_completion", "no_blind_retry", "codex_same_family_retry"],
      "properties": {
        "max_families": {"const": 3},
        "max_attempts_per_family": {"const": 1},
        "stop_on_first_validated_completion": {"const": true},
        "no_blind_retry": {"const": true},
        "codex_same_family_retry": {"const": "FORBIDDEN_UNLESS_NEW_ROOT_CAUSE_EVIDENCE"}
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor_id", "family", "installed", "version", "state", "blockers", "blocker_fingerprint", "evidence_refs", "attempt_count"],
      "properties": {
        "executor_id": {"type": "string", "pattern": "^external\\.[a-z0-9-]+$"},
        "family": {"$ref": "#/$defs/nonblank"},
        "installed": {"type": "boolean"},
        "version": {"type": ["string", "null"]},
        "state": {"enum": ["NOT_INSTALLED", "BLOCKED", "QUALIFYING", "LIVE_SELECTABLE", "ATTEMPTED", "VALIDATED", "TERMINAL_BLOCKED"]},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
        "blocker_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
        "attempt_count": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_content_read", "auth_content_copied", "configuration_changed", "billing_changed", "executor_installed_or_upgraded", "live_inference_started", "channel_or_browser_used", "task_workspace_modified"],
      "properties": {
        "secret_content_read": {"const": false},
        "auth_content_copied": {"const": false},
        "configuration_changed": {"const": false},
        "billing_changed": {"const": false},
        "executor_installed_or_upgraded": {"const": false},
        "live_inference_started": {"const": false},
        "channel_or_browser_used": {"const": false},
        "task_workspace_modified": {"const": false}
      }
    }
  }
}
