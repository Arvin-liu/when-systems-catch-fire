{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/iteration-ordinal-adversarial-matrix-r1.schema.json",
  "title": "Task133 iteration ordinal adversarial matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "cases", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "iteration-ordinal-adversarial-matrix-r1"},
    "task_id": {"const": "IGNITION-20260822-133"},
    "cases": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/case"}},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "description", "mutation", "expected"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "mutation": {"type": "string", "minLength": 1},
        "expected": {"enum": ["PASS", "FAIL"]}
      }
    }
  }
}
