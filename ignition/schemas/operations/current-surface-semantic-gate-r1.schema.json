{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/operations/current-surface-semantic-gate-r1.schema.json",
  "title": "Ignition Current Surface typed semantic gate report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "result", "issue_count", "surfaces", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "current-surface-semantic-gate-r1"},
    "task_id": {"const": "IGNITION-20260822-134"},
    "result": {"enum": ["VALID", "INVALID"]},
    "issue_count": {"type": "integer", "minimum": 0},
    "snapshot_source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface_id", "path", "profile", "generated_block_count", "issue_count"],
        "properties": {
          "surface_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "profile": {"enum": ["human", "ai", "machine"]},
          "generated_block_count": {"type": "integer", "minimum": 0},
          "issue_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "issues": {"type": "array"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}
