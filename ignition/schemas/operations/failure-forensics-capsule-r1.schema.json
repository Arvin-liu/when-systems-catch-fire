{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pointfire.local/schemas/failure-forensics-capsule-r1.schema.json",
  "title": "Pointfire sanitized FailureForensicsCapsule R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "dispatch_id", "attempt_id", "executor_id", "adapter_id",
    "executor_version", "interface_digest", "argv_public_shape", "process", "streams", "parser",
    "schema", "structured_output", "diagnostic_class", "redaction", "runtime_boundary",
    "inference_observation_status", "raw_spool", "knowledge", "claim_ceiling", "capsule_digest"
  ],
  "properties": {
    "schema_version": {"const": "failure-forensics-capsule-r1"},
    "task_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "executor_id": {"type": "string", "minLength": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "executor_version": {"type": "string", "minLength": 1},
    "interface_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "argv_public_shape": {"type": "object"},
    "process": {"type": "object"},
    "streams": {"type": "object"},
    "parser": {"type": "object"},
    "schema": {"type": "object"},
    "structured_output": {"type": "object"},
    "diagnostic_class": {"type": "string", "minLength": 1},
    "redaction": {"type": "object"},
    "runtime_boundary": {"type": "object"},
    "inference_observation_status": {"type": "string", "minLength": 1},
    "raw_spool": {"type": "object"},
    "knowledge": {"type": "object"},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "capsule_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
