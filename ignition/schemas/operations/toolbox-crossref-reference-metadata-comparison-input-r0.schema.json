{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ignition:toolbox-crossref-reference-metadata-comparison-input-r0",
  "title": "Crossref Reference Metadata Comparison Input R0",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_work_doi", "references"],
  "properties": {
    "source_work_doi": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^10\\.[0-9]{4,9}/[-._;()/:A-Za-z0-9]+$"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "doi"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "doi": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^10\\.[0-9]{4,9}/[-._;()/:A-Za-z0-9]+$"
          },
          "article_title": {"$ref": "#/$defs/citationText"},
          "year": {"type": "integer", "minimum": 1000, "maximum": 2200},
          "journal_title": {"$ref": "#/$defs/citationText"},
          "volume": {"$ref": "#/$defs/citationText"},
          "issue": {"$ref": "#/$defs/citationText"},
          "first_page": {"$ref": "#/$defs/citationText"}
        }
      }
    }
  },
  "$defs": {
    "citationText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "allOf": [
        {"pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
        {"pattern": "^[^\\x00-\\x1f]*$"}
      ]
    }
  }
}
