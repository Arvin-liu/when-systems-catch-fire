{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/architecture/current-system-identity.schema.json",
  "title": "Ignition current system identity contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "identity_epoch",
    "current_formal_task_id",
    "current_formal_task_ordinal",
    "latest_architecture_changing_task_id",
    "latest_architecture_task_ordinal",
    "current_iteration_boundary",
    "current_iteration_boundary_semantics",
    "current_state_status",
    "epistemically_accepted",
    "current_architecture_identity",
    "current_map",
    "current_method",
    "current_operating_method",
    "current_facts_projection",
    "current_task_lineage",
    "derived_metrics",
    "known_open_obligations",
    "authority_ceilings",
    "architecture_impact_handshake",
    "required_sync_surfaces",
    "concept_requirements"
  ],
  "properties": {
    "schema_version": {"const": "current-system-identity-r1"},
    "contract_id": {"const": "CURRENT_STATE_SYNC_INVARIANT"},
    "identity_epoch": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "current_formal_task_id": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"},
    "current_formal_task_ordinal": {"type": "integer", "minimum": 1},
    "latest_architecture_changing_task_id": {"type": "string", "pattern": "^IGNITION-[0-9]{8}-[0-9]{3}$"},
    "latest_architecture_task_ordinal": {"type": "integer", "minimum": 1},
    "current_iteration_boundary": {"type": "integer", "minimum": 1},
    "current_iteration_boundary_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "status", "alias_of", "source_path"],
      "properties": {
        "contract_id": {"const": "ITERATION_BOUNDARY_SEMANTICS_INVARIANT"},
        "status": {"const": "DEPRECATED_COMPATIBILITY_ALIAS"},
        "alias_of": {"const": "current_formal_task_ordinal"},
        "source_path": {"const": "ignition/data/operations/iteration-boundary-semantics-r1.json"}
      }
    },
    "current_state_status": {"const": "CURRENT_WITH_OPEN_OBLIGATIONS"},
    "epistemically_accepted": {"const": 0},
    "current_architecture_identity": {"$ref": "#/$defs/identity"},
    "current_map": {"$ref": "#/$defs/mapRef"},
    "current_method": {"$ref": "#/$defs/methodRef"},
    "current_operating_method": {"$ref": "#/$defs/operatingMethodRef"},
    "current_facts_projection": {"$ref": "#/$defs/factsProjection"},
    "current_task_lineage": {"$ref": "#/$defs/taskLineageRef"},
    "derived_metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "known_open_obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/obligation"}},
    "authority_ceilings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
    "architecture_impact_handshake": {"$ref": "#/$defs/handshake"},
    "required_sync_surfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surface"}},
    "concept_requirements": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/concept"}}
  },
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "stringArray": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank"}, "uniqueItems": true},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_role", "driver_role", "internal_control_spine", "control_plane_role", "external_executor_role", "knowledge_role", "reference_executor_role", "identity_boundary", "authority_ceiling"],
      "properties": {
        "system_role": {"$ref": "#/$defs/nonblank"},
        "driver_role": {"$ref": "#/$defs/nonblank"},
        "internal_control_spine": {"$ref": "#/$defs/stringArray"},
        "control_plane_role": {"$ref": "#/$defs/nonblank"},
        "external_executor_role": {"$ref": "#/$defs/nonblank"},
        "knowledge_role": {"$ref": "#/$defs/nonblank"},
        "reference_executor_role": {"$ref": "#/$defs/nonblank"},
        "identity_boundary": {"$ref": "#/$defs/nonblank"},
        "authority_ceiling": {"$ref": "#/$defs/nonblank"}
      }
    },
    "mapRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "json_pointer", "historical_map_version_source_path", "historical_map_version_json_pointer"],
      "properties": {
        "source_path": {"$ref": "#/$defs/nonblank"},
        "json_pointer": {"pattern": "^/"},
        "historical_map_version_source_path": {"$ref": "#/$defs/nonblank"},
        "historical_map_version_json_pointer": {"pattern": "^/"}
      }
    },
    "methodRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "required_marker", "status"],
      "properties": {"source_path": {"$ref": "#/$defs/nonblank"}, "required_marker": {"$ref": "#/$defs/nonblank"}, "status": {"const": "Current"}}
    },
    "operatingMethodRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "required_marker", "identity_marker", "status"],
      "properties": {
        "source_path": {"const": "ignition/OPERATING-METHOD.md"},
        "required_marker": {"const": "Current: `1.0.0`"},
        "identity_marker": {"const": "Identity: `IGNITION_OPERATING_METHOD_R1`"},
        "status": {"const": "CURRENT"}
      }
    },
    "factsProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_path", "markdown_path", "schema_path", "generator_path", "schema_version"],
      "properties": {
        "json_path": {"$ref": "#/$defs/nonblank"},
        "markdown_path": {"$ref": "#/$defs/nonblank"},
        "schema_path": {"$ref": "#/$defs/nonblank"},
        "generator_path": {"$ref": "#/$defs/nonblank"},
        "schema_version": {"const": "current-facts-r1"}
      }
    },
    "taskLineageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "schema_path", "validator_path", "contract_id"],
      "properties": {
        "source_path": {"$ref": "#/$defs/nonblank"},
        "schema_path": {"$ref": "#/$defs/nonblank"},
        "validator_path": {"$ref": "#/$defs/nonblank"},
        "contract_id": {"const": "CURRENT_TASK_LINEAGE_STATUS"}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "source_path", "json_pointer", "operation"],
      "properties": {
        "metric_id": {"pattern": "^[a-z][a-z0-9_]+$"},
        "source_path": {"$ref": "#/$defs/nonblank"},
        "json_pointer": {"pattern": "^/"},
        "operation": {"enum": ["value", "length", "count_where"]},
        "where": {"type": "object", "additionalProperties": false, "required": ["json_pointer", "equals"], "properties": {"json_pointer": {"pattern": "^/"}, "equals": {"type": ["string", "number", "integer", "boolean", "null"]}}}
      },
      "allOf": [{"if": {"properties": {"operation": {"const": "count_where"}}}, "then": {"required": ["where"]}}]
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "statement", "source_paths"],
      "properties": {"obligation_id": {"pattern": "^[A-Z0-9_]+$"}, "statement": {"$ref": "#/$defs/nonblank"}, "source_paths": {"$ref": "#/$defs/stringArray"}}
    },
    "handshake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "allowed_values", "architecture_changed_requires", "presentation_only_rule", "no_self_referential_commit_sha"],
      "properties": {
        "field": {"const": "architecture_identity_impact"},
        "allowed_values": {"const": ["NONE", "PRESENTATION_ONLY", "ARCHITECTURE_CHANGED"]},
        "architecture_changed_requires": {"$ref": "#/$defs/stringArray"},
        "presentation_only_rule": {"$ref": "#/$defs/nonblank"},
        "no_self_referential_commit_sha": {"$ref": "#/$defs/nonblank"}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "path", "concepts"],
      "properties": {"surface_id": {"pattern": "^[a-z][a-z0-9-]+$"}, "path": {"$ref": "#/$defs/nonblank"}, "concepts": {"$ref": "#/$defs/stringArray"}}
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_of_any_group"],
      "properties": {"all_of_any_group": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stringArray"}}}
    }
  }
}
