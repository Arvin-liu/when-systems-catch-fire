{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/schemas/architecture/hypothesis-distribution.schema.json",
  "title": "Hypothesis Distribution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "question",
    "sample_refs",
    "candidates",
    "sensitivity_summary",
    "claim_boundary"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^HDIST-[A-Z0-9-]+$" },
    "question": { "type": "string", "minLength": 1 },
    "sample_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis", "ranking", "support", "counterevidence", "unresolved"],
        "properties": {
          "hypothesis": { "type": "string", "minLength": 1 },
          "ranking": { "type": "integer", "minimum": 1 },
          "support": { "type": "array", "items": { "type": "string" } },
          "counterevidence": { "type": "array", "items": { "type": "string" } },
          "unresolved": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "sensitivity_summary": { "type": "string", "minLength": 1 },
    "claim_boundary": { "type": "string", "minLength": 1 }
  }
}
