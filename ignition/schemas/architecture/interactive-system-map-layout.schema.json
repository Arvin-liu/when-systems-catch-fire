{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/architecture/interactive-system-map-layout.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["layout_version", "current_map_version", "historical_map_version", "title", "subtitle", "repository_url", "geometry", "groups", "node_order"],
  "properties": {
    "layout_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "current_map_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "historical_map_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string", "minLength": 1},
    "repository_url": {"type": "string", "pattern": "^https://github.com/"},
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "group_gap", "group_header_height", "group_width", "node_gap", "node_height", "outer_padding", "packing_algorithm", "top_offset", "vertical_gap"],
      "properties": {
        "columns": {"type": "integer", "minimum": 1},
        "group_gap": {"type": "integer", "minimum": 0},
        "group_header_height": {"type": "integer", "minimum": 1},
        "group_width": {"type": "integer", "minimum": 1},
        "node_gap": {"type": "integer", "minimum": 0},
        "node_height": {"type": "integer", "minimum": 1},
        "outer_padding": {"type": "integer", "minimum": 0},
        "packing_algorithm": {"const": "deterministic-scc-ranked-column-packing-r1"},
        "top_offset": {"type": "integer", "minimum": 0},
        "vertical_gap": {"type": "integer", "minimum": 0}
      }
    },
    "groups": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "label", "description", "column", "row", "color"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "description": {"type": "string"}, "column": {"type": "integer", "minimum": 0}, "row": {"type": "integer", "minimum": 0}, "color": {"type": "string"}}}},
    "node_order": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}
  }
}
