{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adaptive-relational-runtime:schema:source",
  "title": "ARR Source record",
  "description": "Plane 1 typed reference to an external material (bytes/object identity, not observation or interpretation).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "record_kind",
    "schema_version",
    "scope",
    "provenance",
    "explicitness",
    "claim_ceiling",
    "uncertainty",
    "alternatives",
    "lifecycle",
    "time",
    "extensions",
    "source_type",
    "content_hash",
    "locator",
    "tier",
    "rights_boundary"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[a-z]{2,4}_[0-9a-f]{32}$"
    },
    "record_kind": {
      "const": "Source"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^arr-r[0-9]+\\.[0-9]+$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "context_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "explicitness": {
      "type": "string",
      "enum": [
        "EXPLICIT",
        "UNKNOWN"
      ]
    },
    "claim_ceiling": {
      "type": "string",
      "enum": [
        "PRIMARY_VERIFIED",
        "SECONDARY",
        "UNKNOWN"
      ]
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "OBSERVED",
            "PROVISIONAL",
            "CANDIDATE",
            "SUPPORTED",
            "CONTESTED",
            "SUPERSEDED",
            "ARCHIVED",
            "REACTIVATED",
            "REJECTED",
            "UNKNOWN"
          ]
        },
        "entered_at_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "transition_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_time",
        "publication_time_status",
        "ingestion_time",
        "ingestion_time_status"
      ],
      "properties": {
        "publication_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_time_status": {
          "type": "string",
          "enum": [
            "OK",
            "ABSENT",
            "MALFORMED"
          ]
        },
        "ingestion_time": {
          "type": "string"
        },
        "ingestion_time_status": {
          "type": "string",
          "enum": [
            "OK",
            "ABSENT",
            "MALFORMED"
          ]
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "pattern": "^x_[a-z0-9_]+$"
      },
      "patternProperties": {
        "^x_[a-z0-9_]+$": {}
      }
    },
    "source_type": {
      "type": "string",
      "enum": [
        "text",
        "audio",
        "image",
        "video",
        "code",
        "git_commit",
        "git_pr",
        "ci_run",
        "structured_data",
        "runtime_receipt",
        "institution",
        "declared_event"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_type",
        "ref_value"
      ],
      "properties": {
        "ref_type": {
          "type": "string",
          "enum": [
            "git_commit",
            "git_blob",
            "url",
            "doi",
            "repo_path",
            "external_ref"
          ]
        },
        "ref_value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tier": {
      "type": "string",
      "enum": [
        "PRIMARY",
        "SECONDARY_DERIVED",
        "DERIVED_COMPUTED"
      ]
    },
    "rights_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "republication"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "private_corpus",
            "copyrighted_excerpt",
            "internal_only"
          ]
        },
        "republication": {
          "type": "string",
          "enum": [
            "allowed",
            "hash_only",
            "paraphrase_only",
            "prohibited"
          ]
        },
        "paraphrase": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 280
        },
        "attribution_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "rights_boundary": {
            "properties": {
              "classification": {
                "const": "private_corpus"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "rights_boundary": {
            "properties": {
              "republication": {
                "enum": [
                  "hash_only",
                  "paraphrase_only"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rights_boundary": {
            "properties": {
              "republication": {
                "const": "paraphrase_only"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "rights_boundary"
        ],
        "properties": {
          "rights_boundary": {
            "required": [
              "paraphrase"
            ]
          }
        }
      }
    }
  ],
  "$comment": "SPDX-License-Identifier: Apache-2.0"
}
