{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adaptive-relational-runtime:schema:relation",
  "title": "ARR Relation record",
  "description": "Plane 2 typed relation connecting >=2 endpoints; carries no causal/truth/value conclusion. No repetition_count/centrality/similarity_score fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "record_kind",
    "schema_version",
    "scope",
    "provenance",
    "explicitness",
    "claim_ceiling",
    "uncertainty",
    "alternatives",
    "lifecycle",
    "time",
    "extensions",
    "relation_type",
    "endpoints",
    "directionality",
    "temporal_scope",
    "causal_handoff_ref"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[a-z]{2,4}_[0-9a-f]{32}$"
    },
    "record_kind": {
      "const": "Relation"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^arr-r[0-9]+\\.[0-9]+$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "context_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "explicitness": {
      "type": "string",
      "enum": [
        "EXPLICIT",
        "STRONGLY_IMPLIED",
        "PLAUSIBLE_ASSUMPTION",
        "INTERPRETER_RECONSTRUCTION",
        "UNKNOWN"
      ]
    },
    "claim_ceiling": {
      "type": "string",
      "enum": [
        "PRIMARY_VERIFIED",
        "SECONDARY",
        "UNKNOWN"
      ]
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "OBSERVED",
            "PROVISIONAL",
            "CANDIDATE",
            "SUPPORTED",
            "CONTESTED",
            "SUPERSEDED",
            "ARCHIVED",
            "REACTIVATED",
            "REJECTED",
            "UNKNOWN"
          ]
        },
        "entered_at_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "transition_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingestion_time",
        "ingestion_time_status"
      ],
      "properties": {
        "ingestion_time": {
          "type": "string"
        },
        "ingestion_time_status": {
          "type": "string",
          "enum": [
            "OK",
            "ABSENT",
            "MALFORMED"
          ]
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "pattern": "^x_[a-z0-9_]+$"
      },
      "patternProperties": {
        "^x_[a-z0-9_]+$": {}
      }
    },
    "relation_type": {
      "type": "string",
      "minLength": 1
    },
    "endpoints": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "ref"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "directionality": {
      "type": "string",
      "enum": [
        "directed",
        "undirected",
        "bidirectional",
        "unknown"
      ]
    },
    "temporal_scope": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "interval",
        "activation_ref"
      ],
      "properties": {
        "interval": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "start",
            "start_inclusive",
            "end",
            "end_inclusive"
          ],
          "properties": {
            "start": {
              "type": [
                "string",
                "null"
              ]
            },
            "start_inclusive": {
              "type": "boolean"
            },
            "end": {
              "type": [
                "string",
                "null"
              ]
            },
            "end_inclusive": {
              "type": "boolean"
            }
          }
        },
        "activation_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "causal_handoff_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$comment": "SPDX-License-Identifier: Apache-2.0"
}
