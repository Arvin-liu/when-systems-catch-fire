{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Q44-I1 Coaching / Commitment Subcapability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "capability_id",
    "parent_binding",
    "evidence_registry",
    "records",
    "facts",
    "rule_assertions",
    "conclusion"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "const": "Q44-I1"
    },
    "capability_id": {
      "const": "coaching_commitment_subcapability"
    },
    "parent_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "exact_head"
      ],
      "properties": {
        "task_id": {
          "const": "Q43-I1"
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "evidence_registry": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "records": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "record_type",
          "user_declared_goal",
          "informed_commitment",
          "plan_checkpoints",
          "deviations",
          "support_options",
          "revise_pause_stop",
          "non_manipulation_constraint",
          "multi_perspective_narrative",
          "autonomy_consent",
          "outcome_process_separation",
          "escalation",
          "claim_ceiling"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "record_type": {
            "enum": [
              "USER_LED_COMMITMENT",
              "PAUSE_OR_REVISE_PATH"
            ]
          },
          "user_declared_goal": {
            "$ref": "#/$defs/boundedField"
          },
          "informed_commitment": {
            "$ref": "#/$defs/boundedField"
          },
          "plan_checkpoints": {
            "$ref": "#/$defs/boundedField"
          },
          "deviations": {
            "$ref": "#/$defs/boundedField"
          },
          "support_options": {
            "$ref": "#/$defs/boundedField"
          },
          "revise_pause_stop": {
            "$ref": "#/$defs/boundedField"
          },
          "non_manipulation_constraint": {
            "$ref": "#/$defs/boundedField"
          },
          "multi_perspective_narrative": {
            "$ref": "#/$defs/boundedField"
          },
          "autonomy_consent": {
            "$ref": "#/$defs/boundedField"
          },
          "outcome_process_separation": {
            "$ref": "#/$defs/boundedField"
          },
          "escalation": {
            "$ref": "#/$defs/boundedField"
          },
          "claim_ceiling": {
            "$ref": "#/$defs/boundedField"
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_user_declared",
        "commitment_informed",
        "consent_reversible",
        "no_goal_substitution",
        "no_shame_pressure",
        "multiple_narratives_preserved",
        "process_outcome_separate",
        "support_not_control",
        "escalation_boundary_enforced"
      ],
      "properties": {
        "goal_user_declared": {
          "type": "boolean"
        },
        "commitment_informed": {
          "type": "boolean"
        },
        "consent_reversible": {
          "type": "boolean"
        },
        "no_goal_substitution": {
          "type": "boolean"
        },
        "no_shame_pressure": {
          "type": "boolean"
        },
        "multiple_narratives_preserved": {
          "type": "boolean"
        },
        "process_outcome_separate": {
          "type": "boolean"
        },
        "support_not_control": {
          "type": "boolean"
        },
        "escalation_boundary_enforced": {
          "type": "boolean"
        }
      }
    },
    "rule_assertions": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "status",
          "evidence_refs",
          "effect"
        ],
        "properties": {
          "rule_id": {
            "enum": [
              "goal_user_declared",
              "commitment_informed",
              "consent_reversible",
              "no_goal_substitution",
              "no_shame_pressure",
              "multiple_narratives_preserved",
              "process_outcome_separate",
              "support_not_control",
              "escalation_boundary_enforced"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "effect": {
            "enum": [
              "ALLOW_WITHIN_CEILING",
              "BLOCK",
              "DOWNGRADE"
            ]
          }
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "claim_ceiling",
        "history_preserved",
        "external_action_performed"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "history_preserved": {
          "type": "boolean"
        },
        "external_action_performed": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "boundedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "const": "RECORDED"
        },
        "value": {
          "type": [
            "string",
            "boolean",
            "number",
            "array",
            "object",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "evidence_id",
        "artifact",
        "exact_head",
        "artifact_digest",
        "rights_status"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "exact_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rights_status": {
          "enum": [
            "REPOSITORY_INTERNAL",
            "PUBLIC_METADATA_ONLY"
          ]
        }
      }
    }
  }
}
