{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/agent-runtime/reasoner-gateway-request-r1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "request_digest", "phase", "run_id", "goal_summary", "environment_summary", "capability_catalog", "context_capsule", "available_packs", "memory_summaries", "previous_summaries"],
  "properties": {
    "schema_version": {"const": "reasoner-gateway-r1"},
    "request_id": {"type": "string", "minLength": 1},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phase": {"enum": ["FRAME", "PLAN"]},
    "run_id": {"type": "string", "minLength": 1},
    "goal_summary": {"type": "string", "minLength": 1},
    "environment_summary": {"type": "string", "minLength": 1},
    "capability_catalog": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "context_capsule": {"type": "array", "items": {"type": "string"}},
    "available_packs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "memory_summaries": {"type": "array", "items": {"type": "string"}},
    "previous_summaries": {"type": "array", "items": {"type": "string"}}
  }
}
