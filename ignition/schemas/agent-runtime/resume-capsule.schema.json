{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ignition/agent-runtime/resume-capsule.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["capsule_id", "run_id", "checkpoint_id", "state_ref", "state_sha256", "pending_action_ids", "required_capabilities", "created_by", "handoff"],
  "properties": {
    "capsule_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "state_ref": {"type": "string", "minLength": 1},
    "state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pending_action_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "created_by": {"type": "string", "minLength": 1},
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_executor_id", "to_executor_id", "reason_summary", "resume_ref"],
      "properties": {
        "from_executor_id": {"type": "string", "minLength": 1},
        "to_executor_id": {"type": "string", "minLength": 1},
        "reason_summary": {"type": "string", "minLength": 1},
        "resume_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
