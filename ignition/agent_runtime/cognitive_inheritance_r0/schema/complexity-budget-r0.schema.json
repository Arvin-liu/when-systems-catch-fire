{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/ignition/agent_runtime/cognitive_inheritance_r0/schema/complexity-budget-r0.schema.json",
  "title": "Cognitive Inheritance Complexity Budget R0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "budget_id", "task_id", "budget_units", "entries", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "complexity-budget-r0"},
    "budget_id": {"const": "cognitive-inheritance-complexity-r0"},
    "task_id": {"const": "IGNITION-20260916-179"},
    "budget_units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new_schema_families", "new_runtime_dependencies", "new_persistent_authorities", "new_provider_bindings"],
      "properties": {
        "new_schema_families": {"type": "integer", "minimum": 0, "maximum": 6},
        "new_runtime_dependencies": {"type": "integer", "minimum": 0, "maximum": 0},
        "new_persistent_authorities": {"type": "integer", "minimum": 0, "maximum": 0},
        "new_provider_bindings": {"type": "integer", "minimum": 0, "maximum": 0}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "budget_entry_id",
          "consumer",
          "why_needed",
          "replaces_or_absorbs",
          "downgrade_merge_delete_conditions",
          "replay_validation",
          "owner_or_retirement_condition",
          "status"
        ],
        "properties": {
          "budget_entry_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "consumer": {"type": "string", "minLength": 3},
          "why_needed": {"type": "string", "minLength": 20},
          "replaces_or_absorbs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "downgrade_merge_delete_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
          "replay_validation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
          "owner_or_retirement_condition": {"type": "string", "minLength": 20},
          "status": {"enum": ["R0_BOUNDED", "R0_OPTIONAL", "RETIRED", "UNRESOLVED"]}
        }
      }
    },
    "claim_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "text"],
      "properties": {
        "status": {"const": "COMPLEXITY_ACCOUNTING_ONLY"},
        "text": {"type": "string", "minLength": 30}
      }
    }
  }
}
