{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/ignition/agent_runtime/cognitive_inheritance_r0/schema/independent-evaluation-package-r0.schema.json",
  "title": "Independent Evaluation Package R0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "task_id",
    "experiment_status",
    "roles",
    "frozen_objective",
    "frozen_criteria",
    "baseline",
    "fixture_refs",
    "blind_first",
    "builder_write_surface",
    "evaluator_write_surface",
    "metrics",
    "prohibited_shortcuts",
    "final_verdict"
  ],
  "properties": {
    "schema_version": {"const": "independent-evaluation-package-r0"},
    "package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "task_id": {"const": "IGNITION-20260916-179"},
    "experiment_status": {"const": "READY_FOR_INDEPENDENT_EVALUATION"},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builder", "evaluator", "adjudicator"],
      "properties": {
        "builder": {"$ref": "#/$defs/role"},
        "evaluator": {"$ref": "#/$defs/role"},
        "adjudicator": {"$ref": "#/$defs/role"}
      }
    },
    "frozen_objective": {"type": "string", "minLength": 30},
    "frozen_criteria": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "name", "observable_question", "evidence_required", "status"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "name": {"type": "string", "minLength": 3},
          "observable_question": {"type": "string", "minLength": 20},
          "evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "status": {"const": "FROZEN_NOT_YET_MEASURED"}
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "exact_head", "repository", "claim_ceiling"],
      "properties": {
        "identifier": {"const": "PRE_CAPABILITY_INHERITANCE_BASELINE"},
        "exact_head": {"const": "68565f2afb50989d2c2b0d346d774e3388702743"},
        "repository": {"const": "Arvin-liu/when-systems-catch-fire"},
        "claim_ceiling": {"type": "string", "minLength": 20}
      }
    },
    "fixture_refs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "blind_first": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "packet_order", "unblind_authority", "sealed_inputs"],
      "properties": {
        "required": {"const": true},
        "packet_order": {"enum": ["TASK_ONLY_THEN_FIXTURE_THEN_BASELINE", "FIXTURE_ONLY_THEN_TASK"]},
        "unblind_authority": {"const": "INDEPENDENT_EVALUATOR"},
        "sealed_inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
      }
    },
    "builder_write_surface": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3}
    },
    "evaluator_write_surface": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3}
    },
    "metrics": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "name", "unit", "measurement_status", "builder_may_measure"],
        "properties": {
          "metric_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 3},
          "unit": {"type": "string", "minLength": 1},
          "measurement_status": {"const": "NOT_YET_MEASURED"},
          "builder_may_measure": {"const": false}
        }
      }
    },
    "prohibited_shortcuts": {
      "type": "array",
      "minItems": 5,
      "items": {"type": "string", "minLength": 10}
    },
    "final_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cognitive_inheritance_verdict", "structured_conformance_status", "external_validity_status", "owner_acceptance"],
      "properties": {
        "cognitive_inheritance_verdict": {"const": "NOT_EVALUATED_BY_BUILDER"},
        "structured_conformance_status": {"const": "MECHANICALLY_VALIDATED"},
        "external_validity_status": {"const": "UNKNOWN"},
        "owner_acceptance": {"const": "NOT_REQUESTED"}
      }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "may_write", "may_issue_final_verdict", "assignment_status"],
      "properties": {
        "role_id": {"enum": ["BUILDER", "INDEPENDENT_EVALUATOR", "ADJUDICATOR"]},
        "may_write": {"type": "array", "items": {"type": "string", "minLength": 3}},
        "may_issue_final_verdict": {"type": "boolean"},
        "assignment_status": {"enum": ["CURRENT_BUILDER", "WAITING_FOR_OWNER_ASSIGNMENT", "UNASSIGNED"]}
      }
    }
  }
}
