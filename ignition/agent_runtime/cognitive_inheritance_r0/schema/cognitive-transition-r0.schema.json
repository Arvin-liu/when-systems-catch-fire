{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/ignition/agent_runtime/cognitive_inheritance_r0/schema/cognitive-transition-r0.schema.json",
  "title": "Cognitive Transition Record R0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "task_id",
    "previous_cognitive_model",
    "observed_anomaly_or_failure",
    "reframing",
    "new_representation",
    "new_method",
    "evaluation",
    "disposition",
    "migration_lineage",
    "provenance",
    "claim_ceiling",
    "builder_verdict",
    "final_state",
    "unknowns"
  ],
  "properties": {
    "schema_version": {"const": "cognitive-transition-r0"},
    "transition_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "task_id": {"const": "IGNITION-20260916-179"},
    "previous_cognitive_model": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "observed_anomaly_or_failure": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref"}
    },
    "reframing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_frame", "new_frame", "boundary"],
      "properties": {
        "previous_frame": {"type": "string", "minLength": 10},
        "new_frame": {"type": "string", "minLength": 10},
        "boundary": {"type": "string", "minLength": 10}
      }
    },
    "new_representation": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref"}
    },
    "new_method": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref"}
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_package_ref", "mechanical_checks", "independent_evaluation_status", "evaluator_role"],
      "properties": {
        "evaluation_package_ref": {"$ref": "#/$defs/ref"},
        "mechanical_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "independent_evaluation_status": {"const": "NOT_RUN"},
        "evaluator_role": {"const": "INDEPENDENT_EVALUATOR_REQUIRED"}
      }
    },
    "disposition": {"enum": ["ADOPT", "REJECT", "COEXIST", "UNRESOLVED"]},
    "migration_lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineage_id", "source_ref", "target_ref", "operation", "destructive_rewrite"],
        "properties": {
          "lineage_id": {"type": "string", "minLength": 3},
          "source_ref": {"$ref": "#/$defs/ref"},
          "target_ref": {"$ref": "#/$defs/ref"},
          "operation": {"type": "string", "minLength": 3},
          "destructive_rewrite": {"const": false}
        }
      }
    },
    "provenance": {"$ref": "#/$defs/provenance"},
    "claim_ceiling": {"$ref": "#/$defs/claim_boundary"},
    "builder_verdict": {"const": "NOT_EVALUATED_BY_BUILDER"},
    "final_state": {"const": "READY_FOR_INDEPENDENT_EVALUATION"},
    "unknowns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_id", "ref_kind"],
      "properties": {
        "stable_id": {"type": "string", "minLength": 3},
        "ref_kind": {"enum": ["OBJECT", "RELATION", "TRANSITION", "FIXTURE", "PACKAGE", "SOURCE"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "source_kind", "retrievability", "first_seen"],
      "properties": {
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "source_kind": {"enum": ["REPOSITORY_RECORD", "EXTERNAL_PRIMARY_SOURCE", "OWNER_INPUT", "DERIVED_OBSERVATION", "UNKNOWN"]},
        "retrievability": {"enum": ["LOCAL_AND_REPOSITORY", "REPOSITORY_ONLY", "EXTERNAL_REFERENCE_ONLY", "NOT_RETRIEVED"]},
        "first_seen": {"type": "string", "pattern": "^202[0-9]-[0-9]{2}-[0-9]{2}$"},
        "content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "locator": {"type": ["string", "null"]}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_status", "allowed_claims", "forbidden_inferences"],
      "properties": {
        "authority_status": {"enum": ["PLATFORM_PROVENANCE", "OBSERVATION_ONLY", "EXTERNAL_REFERENCE_ONLY", "UNKNOWN"]},
        "allowed_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "forbidden_inferences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
      }
    }
  }
}
