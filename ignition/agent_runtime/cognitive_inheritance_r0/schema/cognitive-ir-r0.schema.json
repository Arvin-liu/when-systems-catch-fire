{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/ignition/agent_runtime/cognitive_inheritance_r0/schema/cognitive-ir-r0.schema.json",
  "title": "Cognitive Intermediate Representation R0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "task_id",
    "status",
    "objects",
    "relations",
    "transition_refs",
    "provenance",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "cognitive-ir-r0"},
    "package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "task_id": {"type": "string", "const": "IGNITION-20260916-179"},
    "status": {"type": "string", "const": "READY_FOR_INDEPENDENT_EVALUATION"},
    "self_model_ref": {"type": ["string", "null"]},
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/object"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "transition_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/ref"}
    },
    "provenance": {"$ref": "#/$defs/provenance"},
    "claim_ceiling": {"$ref": "#/$defs/claim_boundary"}
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_id", "ref_kind"],
      "properties": {
        "stable_id": {"type": "string", "minLength": 3},
        "ref_kind": {"enum": ["OBJECT", "RELATION", "TRANSITION", "FIXTURE", "PACKAGE", "SOURCE"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "source_kind", "retrievability", "first_seen"],
      "properties": {
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        },
        "source_kind": {
          "enum": [
            "REPOSITORY_RECORD",
            "EXTERNAL_PRIMARY_SOURCE",
            "OWNER_INPUT",
            "DERIVED_OBSERVATION",
            "UNKNOWN"
          ]
        },
        "retrievability": {
          "enum": ["LOCAL_AND_REPOSITORY", "REPOSITORY_ONLY", "EXTERNAL_REFERENCE_ONLY", "NOT_RETRIEVED"]
        },
        "first_seen": {"type": "string", "pattern": "^202[0-9]-[0-9]{2}-[0-9]{2}$"},
        "content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "locator": {"type": ["string", "null"]
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence", "basis", "open_questions"],
      "properties": {
        "status": {
          "enum": ["KNOWN", "OBSERVED", "SUPPORTED", "HYPOTHESIS", "UNKNOWN", "NOT_MEASURED", "INCONCLUSIVE"]
        },
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "basis": {"type": "array", "items": {"type": "string", "minLength": 3}},
        "open_questions": {"type": "array", "items": {"type": "string", "minLength": 3}}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_status", "allowed_claims", "forbidden_inferences"],
      "properties": {
        "authority_status": {"enum": ["PLATFORM_PROVENANCE", "OBSERVATION_ONLY", "EXTERNAL_REFERENCE_ONLY", "UNKNOWN"]},
        "allowed_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "forbidden_inferences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
      }
    },
    "migration_lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineage_id", "operation", "source_schema", "target_schema", "destructive_rewrite"],
        "properties": {
          "lineage_id": {"type": "string", "minLength": 3},
          "operation": {"type": "string", "minLength": 3},
          "source_schema": {"type": "string", "minLength": 3},
          "target_schema": {"type": "string", "minLength": 3},
          "destructive_rewrite": {"const": false}
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_id",
        "schema_version",
        "object_type",
        "label",
        "content",
        "provenance",
        "uncertainty",
        "claim_boundary",
        "allowed_use",
        "lifecycle",
        "migration_lineage"
      ],
      "properties": {
        "stable_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:._-]+$"},
        "schema_version": {"const": "cognitive-ir-r0"},
        "object_type": {
          "enum": [
            "OBJECT",
            "CLAIM",
            "OBSERVATION",
            "EVIDENCE",
            "METHOD",
            "HYPOTHESIS",
            "COUNTEREXAMPLE",
            "BOUNDARY",
            "QUESTION",
            "DECISION",
            "ACTION",
            "FAILURE",
            "CAPABILITY",
            "EVALUATION",
            "COGNITIVE_MODEL",
            "COGNITIVE_TRANSITION",
            "UNKNOWN"
          ]
        },
        "label": {"type": "string", "minLength": 3},
        "content": {"type": "object"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "claim_boundary": {"$ref": "#/$defs/claim_boundary"},
        "allowed_use": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "lifecycle": {"enum": ["CANDIDATE", "CURRENT_R0", "SUPERSEDED", "RETIRED", "UNRESOLVED"]},
        "migration_lineage": {"$ref": "#/$defs/migration_lineage"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_id", "schema_version", "relation_type", "from", "to", "provenance", "uncertainty", "claim_boundary"],
      "properties": {
        "stable_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:._-]+$"},
        "schema_version": {"const": "cognitive-ir-r0"},
        "relation_type": {
          "enum": [
            "SUPPORTS",
            "CHALLENGES",
            "DEPENDS_ON",
            "DERIVED_FROM",
            "BOUNDED_BY",
            "TESTED_BY",
            "CONTRADICTS",
            "ANALOGOUS_TO",
            "GENERALIZES",
            "SPECIALIZES",
            "SUPERSEDES",
            "IMPLEMENTS",
            "REQUIRES",
            "TRANSFERS_TO",
            "EVALUATED_BY",
            "TRIGGERED_TRANSITION",
            "UNKNOWN_RELATION"
          ]
        },
        "from": {"$ref": "#/$defs/ref"},
        "to": {"$ref": "#/$defs/ref"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "claim_boundary": {"$ref": "#/$defs/claim_boundary"}
      }
    }
  }
}
