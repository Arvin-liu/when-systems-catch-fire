{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/blob/main/ignition/evaluation/heldout/r0.4/successor-visible/successor-output-r0.4.schema.json",
  "title": "R0.4 Successor Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "case_responses"],
  "properties": {
    "schema_version": {"const": "successor-output-r0.4"},
    "task_id": {"const": "IGNITION-20260919-188-R0.4"},
    "case_responses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/case_response"},
      "allOf": [
        {
          "contains": {"properties": {"case_id": {"const": "IGNITION-20260919-188-EXP-01"}}, "required": ["case_id"]},
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {"properties": {"case_id": {"const": "IGNITION-20260919-188-GOV-01"}}, "required": ["case_id"]},
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "case_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "observations", "interpretations", "uncertainties", "additional_evidence_needed"],
      "properties": {
        "case_id": {"enum": ["IGNITION-20260919-188-EXP-01", "IGNITION-20260919-188-GOV-01"]},
        "observations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "interpretations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "uncertainties": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "additional_evidence_needed": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
