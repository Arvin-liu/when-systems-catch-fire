+fn write_task229_capture_file(directory: &Path, name: &str, bytes: &[u8]) -> Result<()> {
+    let metadata = std::fs::symlink_metadata(directory)?;
+    if !metadata.file_type().is_dir()
+        || std::fs::canonicalize(directory).ok().as_deref() != Some(directory)
+    {
+        return Err(std::io::Error::other(
+            "Task229 capture directory must be an existing canonical directory",
+        )
+        .into());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.uid() != unsafe { libc::geteuid() } || metadata.mode() & 0o077 != 0 {
+            return Err(std::io::Error::other(
+                "Task229 capture directory must be private and owned by the runtime user",
+            )
+            .into());
+        }
+    }
+    let mut options = OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options
+            .mode(0o600)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC);
+    }
+    let mut file = options.open(directory.join(name))?;
+    file.write_all(bytes)?;
+    file.sync_all()?;
+    std::fs::File::open(directory)?.sync_all()?;
+    Ok(())
+}
