+        )
+        .into());
+    }
+    match mode.as_str() {
+        "canary" if expected_input_sha256.is_none() && canary_gate_path.is_none() => {
+            Ok(Some(Task229NativeRunConfig {
+                kind: Task229NativeRunKind::Canary,
+                capture_dir: PathBuf::from(capture_dir),
+                expected_input_sha256: None,
+                canary_gate_path: None,
