+use sha2::Digest;
+use sha2::Sha256;
+use std::path::PathBuf;
+use std::process::Command;
+
+fn main() {
+    let core_dir = PathBuf::from(std::env::var_os("CARGO_MANIFEST_DIR").expect("manifest dir"));
+    let workspace = core_dir.parent().expect("workspace directory");
+    let files = [
+        ("Cargo.toml", workspace.join("Cargo.toml")),
+        (
+            "codex-api/Cargo.toml",
+            workspace.join("codex-api/Cargo.toml"),
+        ),
+        (
+            "codex-api/src/endpoint/responses.rs",
+            workspace.join("codex-api/src/endpoint/responses.rs"),
+        ),
+        (
+            "codex-api/src/endpoint/session.rs",
+            workspace.join("codex-api/src/endpoint/session.rs"),
+        ),
+        ("core/Cargo.toml", core_dir.join("Cargo.toml")),
+        ("core/build.rs", core_dir.join("build.rs")),
+        ("core/src/client.rs", core_dir.join("src/client.rs")),
+    ];
+
+    let mut digest = Sha256::new();
+    for (name, path) in files {
+        println!("cargo:rerun-if-changed={}", path.display());
+        digest.update(name.as_bytes());
+        digest.update([0]);
+        digest.update(std::fs::read(path).expect("Task229 runtime source file"));
+    }
+    let source_sha256 = format!("{:x}", digest.finalize());
+
+    let git_root = workspace.parent().expect("Git worktree root");
+    let status = Command::new("git")
+        .arg("-C")
+        .arg(git_root)
+        .args([
+            "status",
+            "--porcelain",
+            "--untracked-files=no",
+            "--",
+            "codex-rs/Cargo.toml",
+            "codex-rs/codex-api/Cargo.toml",
+            "codex-rs/codex-api/src/endpoint/responses.rs",
+            "codex-rs/codex-api/src/endpoint/session.rs",
+            "codex-rs/core/Cargo.toml",
+            "codex-rs/core/build.rs",
+            "codex-rs/core/src/client.rs",
+        ])
+        .output();
+    let source_commit = match status {
+        Ok(status) if status.status.success() && status.stdout.is_empty() => Command::new("git")
+            .arg("-C")
+            .arg(git_root)
+            .args(["rev-parse", "HEAD"])
+            .output()
+            .ok()
+            .filter(|output| output.status.success())
+            .and_then(|output| String::from_utf8(output.stdout).ok())
+            .map(|commit| commit.trim().to_string())
+            .filter(|commit| commit.len() == 40 && commit.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()))
+            .unwrap_or_else(|| "unknown".to_string()),
+        _ => "unknown-dirty".to_string(),
+    };
+
+    println!("cargo:rustc-env=TASK229_R4_SOURCE_COMMIT={source_commit}");
+    println!("cargo:rustc-env=TASK229_R4_SOURCE_SHA256={source_sha256}");
+}
