+
+fn validate_private_capture_dir(directory: &Path) -> Result<(), ApiError> {
+    let metadata = std::fs::symlink_metadata(directory)
+        .map_err(|error| ApiError::Stream(format!("Task229 capture directory unavailable: {error}")))?;
+    if !metadata.file_type().is_dir() || std::fs::canonicalize(directory).ok().as_deref() != Some(directory) {
+        return Err(ApiError::Stream(
+            "Task229 capture directory must be an existing canonical directory".to_string(),
+        ));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.uid() != unsafe { libc::geteuid() } || metadata.mode() & 0o077 != 0 {
+            return Err(ApiError::Stream(
+                "Task229 capture directory must be private and owned by the runtime user".to_string(),
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn is_lower_hex(value: &str, expected_len: usize) -> bool {
+    value.len() == expected_len
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+pub(crate) fn sha256_hex(bytes: &[u8]) -> String {
+    format!("{:x}", sha2::Sha256::digest(bytes))
+}
