+fn verify_task229_canary_gate(config: &Task229NativeRunConfig) -> Result<()> {
+    let path = config
+        .canary_gate_path
+        .as_ref()
+        .ok_or_else(|| std::io::Error::other("Task229 canary gate path is missing"))?;
+    let metadata = std::fs::symlink_metadata(path)?;
+    if !metadata.file_type().is_file() || metadata.len() > 16_384 {
+        return Err(std::io::Error::other("Task229 canary gate file is invalid").into());
+    }
+    let bytes = std::fs::read(path)?;
+    let value = parse_task229_unique_json(&bytes)?;
+    let canary_input_sha256 = ApiResponsesClient::<ReqwestTransport>::task229_sha256_hex(
+        TASK229_NATIVE_CANARY_TEXT.as_bytes(),
+    );
+    let canary_body = br#"{"input":"Output exactly the ASCII token RUNTIME_CANARY_OK; no other characters.","model":"gpt-6-astra","reasoning":{"effort":"medium"},"store":false,"tool_choice":"none","tools":[]}"#;
+    let canary_body_sha256 =
+        ApiResponsesClient::<ReqwestTransport>::task229_sha256_hex(canary_body);
+    let canary_payload_sha256 =
+        ApiResponsesClient::<ReqwestTransport>::task229_sha256_hex(TASK229_NATIVE_CANARY_OUTPUT.as_bytes());
+    let matches = value.get("status").and_then(serde_json::Value::as_str)
+        == Some("CANARY_RUNTIME_GATE_PASSED")
+        && value.get("run_kind").and_then(serde_json::Value::as_str) == Some("canary")
+        && value
+            .get("run_id")
+            .and_then(serde_json::Value::as_str)
+            .is_some_and(|run_id| is_lower_hex(run_id, 32))
+        && value.get("source_commit").and_then(serde_json::Value::as_str)
+            == Some(config.source_commit.as_str())
+        && value.get("source_sha256").and_then(serde_json::Value::as_str)
+            == Some(config.source_sha256.as_str())
+        && value.get("input_sha256").and_then(serde_json::Value::as_str)
+            == Some(canary_input_sha256.as_str())
+        && value.get("request_body_sha256").and_then(serde_json::Value::as_str)
+            == Some(canary_body_sha256.as_str())
+        && value
+            .get("transport_response_sha256")
+            .and_then(serde_json::Value::as_str)
+            .is_some_and(|digest| is_lower_hex(digest, 64))
+        && value
+            .get("transport_response_bytes")
+            .and_then(serde_json::Value::as_u64)
+            .is_some_and(|bytes| bytes <= 1_048_576)
+        && value.get("successor_payload_sha256").and_then(serde_json::Value::as_str)
+            == Some(canary_payload_sha256.as_str())
+        && value
+            .get("successor_payload_bytes")
+            .and_then(serde_json::Value::as_u64)
+            == Some(TASK229_NATIVE_CANARY_OUTPUT.len() as u64)
+        && value.get("http_status").and_then(serde_json::Value::as_u64) == Some(200)
+        && value.get("request_model").and_then(serde_json::Value::as_str) == Some("gpt-6-astra")
+        && value.get("accepted_model_echo").and_then(serde_json::Value::as_str)
+            == Some("gpt-6-astra")
+        && value.get("request_reasoning_effort").and_then(serde_json::Value::as_str)
+            == Some("medium")
+        && value
+            .get("reasoning_effort_echo")
+            .is_none_or(|effort| effort.is_null() || effort.as_str() == Some("medium"))
+        && value.get("request_tools").and_then(serde_json::Value::as_array)
+            .is_some_and(Vec::is_empty)
+        && value.get("request_tool_choice").and_then(serde_json::Value::as_str) == Some("none")
+        && value.get("output_exact_match").and_then(serde_json::Value::as_bool) == Some(true)
+        && value.get("retry_count").and_then(serde_json::Value::as_u64) == Some(0);
+    if !matches {
+        return Err(std::io::Error::other(
+            "Task229 unit mode requires a successful exact-source canary gate",
+        )
+        .into());
+    }
+    Ok(())
+}
