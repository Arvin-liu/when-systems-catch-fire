+fn task229_single_user_text(prompt: &Prompt) -> Option<&str> {
+    let [ResponseItem::Message { role, content, .. }] = prompt.input.as_slice() else {
+        return None;
+    };
+    if role != "user" {
+        return None;
+    }
+    let [ContentItem::InputText { text }] = content.as_slice() else {
+        return None;
+    };
+    Some(text)
+}
