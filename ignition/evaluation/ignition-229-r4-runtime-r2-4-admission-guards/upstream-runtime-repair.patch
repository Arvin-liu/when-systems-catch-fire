+    })?;
+    let run_id = run_id.ok_or_else(|| std::io::Error::other("Task229 run id is required"))?;
+    if capture_dir.is_empty()
+        || !is_lower_hex(&run_id, 32)
+        || !is_lower_hex(TASK229_RUNTIME_SOURCE_COMMIT, 40)
+        || !is_lower_hex(TASK229_RUNTIME_SOURCE_SHA256, 64)
+    {
+        return Err(std::io::Error::other(
