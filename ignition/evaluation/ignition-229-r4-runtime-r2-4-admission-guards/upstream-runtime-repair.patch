+
+fn parse_task229_unique_json(bytes: &[u8]) -> Result<serde_json::Value> {
+    use serde::Deserialize;
+    let mut deserializer = serde_json::Deserializer::from_slice(bytes);
+    let value = Task229UniqueJson::deserialize(&mut deserializer)
+        .map_err(|error| std::io::Error::other(format!("Task229 JSON rejected: {error}")))?;
