+                canary_gate_path: Some(PathBuf::from(gate)),
+                run_id,
+                source_commit: TASK229_RUNTIME_SOURCE_COMMIT.to_string(),
+                source_sha256: TASK229_RUNTIME_SOURCE_SHA256.to_string(),
+            }))
+        }
+        _ => Err(std::io::Error::other(
+            "Task229 native request mode is invalid",
+        )
