{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/blob/main/ignition/evaluation/schemas/successor-read-ledger-r0.1.schema.json",
  "title": "Held-out Successor Read Ledger R0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "allowed_manifest_sha256", "reads", "out_of_scope_read_count"],
  "properties": {
    "schema_version": {"const": "successor-read-ledger-r0.1"},
    "task_id": {"const": "IGNITION-20260917-182"},
    "allowed_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose", "content_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "out_of_scope_read_count": {"type": "integer", "minimum": 0}
  }
}
