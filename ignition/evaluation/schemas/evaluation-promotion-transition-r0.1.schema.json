{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/blob/main/ignition/evaluation/schemas/evaluation-promotion-transition-r0.1.schema.json",
  "title": "Explicit Evaluation Adjudication Promotion Transition R0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "source_artifact_id",
    "source_sha256",
    "target_kind",
    "authorization",
    "automatic",
    "effect"
  ],
  "properties": {
    "schema_version": {"const": "evaluation-promotion-transition-r0.1"},
    "transition_id": {"type": "string", "minLength": 1},
    "source_artifact_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_kind": {"const": "ADJUDICATION_CANDIDATE"},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_type", "authorization_ref"],
      "properties": {
        "authority_type": {"enum": ["OWNER", "OWNER_GPT", "EXPLICIT_DELEGATE"]},
        "authorization_ref": {"type": "string", "minLength": 1}
      }
    },
    "automatic": {"const": false},
    "effect": {"const": "CREATE_ADJUDICATION_CANDIDATE_ONLY"}
  }
}
