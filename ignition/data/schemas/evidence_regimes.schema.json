{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/schemas/evidence_regimes.schema.json",
  "title": "Evidence Regimes Dataset",
  "description": "Machine-readable evidence regime records for domains covered by v0.2.",
  "type": "array",
  "minItems": 12,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "domain",
      "evidence_required",
      "max_claim_level_without_external_evidence",
      "created_in",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^EVID-\\d{3}$"
      },
      "domain": {
        "type": "string",
        "minLength": 1
      },
      "valid_claim_types": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "evidence_required": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "max_claim_level_without_external_evidence": {
        "type": "string",
        "enum": [
          "L0",
          "L1",
          "L2",
          "L3",
          "pending"
        ]
      },
      "pending_conditions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "forbidden_claims": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "created_in": {
        "type": "string",
        "const": "v0.2"
      },
      "updated_in": {
        "type": [
          "string",
          "null"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "pending",
          "deprecated",
          "draft"
        ]
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "notes": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
