{"record_id":"tr-114-l2-army-resource-event-realization","record_kind":"production","version":"1","layers":["L2","L6"],"source_form":{"text":"拥有更多士兵、资金或设备，未必足以构成强大。","language_tag":"zh-Hans","form_status":"historical_accepted_public_text"},"source_language_profile":"zh-hans-modern-written-r1","normalized_meaning_candidate":{"candidate_id":"mc-114-army-01","text":"More soldiers, money and equipment do not by themselves make an army stronger.","status":"CANDIDATE_PROJECTION_NOT_NEUTRAL_MEANING"},"target_form":{"text":"士兵更多、钱更多、设备更多，军队也未必就更强。","language_tag":"zh-Hans","form_status":"task_114_current_revision"},"target_language_profile":"zh-hans-modern-written-r1","source_frame":{"d02":"implicit_possessor_army; abstract_constitution_of_strength","d10":"resources_nominalized_as_possession_then_abstract_strength"},"target_frame":{"d02":"army_explicit_as_entity_being_evaluated; no_new_causal_agent","d10":"resource_comparison_then_strength_comparison"},"framing_deltas":[{"dimension_id":"d02","delta_type":"recoverable_evaluated_entity_made_explicit","source_value":"implicit_possessor_army; abstract_constitution_of_strength","target_value":"army_explicit_as_entity_being_evaluated; no_new_causal_agent","epistemic_relevance":true,"disposition":"human_adjudicated_and_accepted","justification":"The surrounding paragraph is explicitly about the army; naming it resolves rather than invents the evaluated object."},{"dimension_id":"d10","delta_type":"abstract_possession_realized_as_comparison","source_value":"resources_nominalized_as_possession_then_abstract_strength","target_value":"resource_comparison_then_strength_comparison","epistemic_relevance":false,"disposition":"human_adjudicated_and_accepted","justification":"The same contrast is expressed through ordinary Chinese comparison."}],"unmapped_residue":[],"claim_ceiling":"language realization only; historical mechanism remains plausible and externally unverified","provenance":{"created_by":"Task 114","source_locator":"docs/publi