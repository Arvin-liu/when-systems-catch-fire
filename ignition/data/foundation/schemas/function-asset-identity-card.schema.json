{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ignition Task 99 Canonical Function Asset Identity Card",
  "type": "object",
  "required": [
    "canonical_id", "historical_ids", "alias_candidates", "alias_candidate_count", "title",
    "source_anchors", "first_known_appearance_commit", "first_appearance_method",
    "current_public_exposure", "primary_identity", "secondary_identities", "identity_authority",
    "definition", "mathematical_properties", "algebraic_carrier_and_operation",
    "assumptions_and_quantifiers", "claimed_status", "mathematical_maturity",
    "external_evidence_maturity", "proof_obligations", "empirical_obligations",
    "known_counterexamples", "dependencies", "allowed_uses", "prohibited_uses",
    "claim_ceiling", "audit_gates", "six_layer_audit", "final_disposition",
    "adjudication_evidence_paths", "reviewer_state", "last_adjudicated_commit",
    "last_adjudicated_date", "record_sha256"
  ],
  "properties": {
    "canonical_id": {"type": "string", "minLength": 1},
    "historical_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "alias_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "alias_candidate_count": {"type": "integer", "minimum": 0},
    "title": {"type": "string", "minLength": 1},
    "source_anchors": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "first_line", "last_line", "role", "mention_count"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "first_line": {"type": "integer", "minimum": 1},
          "last_line": {"type": "integer", "minimum": 1},
          "role": {"type": "string", "minLength": 1},
          "mention_count": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "first_known_appearance_commit": {"type": "string", "minLength": 1},
    "first_appearance_method": {"type": "string", "minLength": 1},
    "current_public_exposure": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "primary_identity": {
      "enum": [
        "STRICT_MATHEMATICAL_FUNCTION", "PARAMETRIC_MATHEMATICAL_MODEL",
        "SCORING_OR_INDEX_FUNCTION", "GATE_OR_CLASSIFIER", "OPERATOR_OR_TRANSFORM",
        "RELATION_OR_CONSTRAINT", "ALGORITHM_OR_WORKFLOW", "HEURISTIC",
        "STRUCTURAL_METAPHOR", "CONJECTURE_OR_RESEARCH_CANDIDATE",
        "INVALID_OR_PSEUDO_FUNCTION", "UNRESOLVED_IDENTITY"
      ]
    },
    "secondary_identities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "identity_authority": {"type": "string", "minLength": 1},
    "definition": {
      "type": "object",
      "required": [
        "original_text", "original_formula", "inputs", "output", "domain", "codomain",
        "parameters", "units", "carrier", "operation",
        "exact_expression_or_executable_specification"
      ],
      "additionalProperties": true
    },
    "mathematical_properties": {
      "type": "object",
      "required": [
        "boundaries", "singularities", "continuity", "differentiability",
        "monotonicity", "computability", "counterexamples", "failure_modes"
      ],
      "properties": {
        "boundaries": {"type": "array", "items": {"type": "string"}},
        "singularities": {"type": "array", "items": {"type": "string"}},
        "continuity": {"type": "string"},
        "differentiability": {"type": "string"},
        "monotonicity": {"type": "string"},
        "computability": {"type": "string"},
        "counterexamples": {"type": "array"},
        "failure_modes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "algebraic_carrier_and_operation": {
      "type": "object",
      "required": ["carrier", "operation"],
      "properties": {
        "carrier": {"type": "string"},
        "operation": {"type": "string"}
      },
      "additionalProperties": false
    },
    "assumptions_and_quantifiers": {
      "type": "object",
      "required": ["assumptions", "quantifiers"],
      "properties": {
        "assumptions": {"type": "array"},
        "quantifiers": {"type": "string"}
      },
      "additionalProperties": false
    },
    "claimed_status": {
      "type": "object",
      "required": ["historical_assertion_grade", "model_or_theorem_status", "falsifiability_or_testability"],
      "properties": {
        "historical_assertion_grade": {"type": "string"},
        "model_or_theorem_status": {"type": "string"},
        "falsifiability_or_testability": {"type": "string"}
      },
      "additionalProperties": false
    },
    "mathematical_maturity": {"type": "string", "pattern": "^M[0-7]$"},
    "external_evidence_maturity": {"type": "string", "pattern": "^E[0-7]$"},
    "proof_obligations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "empirical_obligations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "known_counterexamples": {"type": "array"},
    "dependencies": {
      "type": "object",
      "required": ["parents", "children", "transitive_children"],
      "properties": {
        "parents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "children": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "transitive_children": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "allowed_uses": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "prohibited_uses": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "audit_gates": {
      "type": "object",
      "required": [
        "definition_gate", "dimension_and_type_gate", "counterexample_gate",
        "circular_reasoning_gate", "claim_layer_gate", "claim_ceiling_gate",
        "cross_domain_isomorphism_gate", "universal_quantifier_gate",
        "internal_test_truth_gate", "dependency_impact_gate"
      ],
      "additionalProperties": {"enum": ["PASS", "FAIL", "REQUIRES_HUMAN_REVIEW", "NOT_APPLICABLE"]}
    },
    "six_layer_audit": {
      "type": "object",
      "required": [
        "syntax_and_mapping", "algebra_and_analysis", "type_and_dimension",
        "logic", "numerical_and_computational", "domain_interpretation"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["result", "evidence"],
        "properties": {
          "result": {"enum": ["PASS", "FAIL", "REQUIRES_HUMAN_REVIEW", "NOT_APPLICABLE"]},
          "evidence": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "final_disposition": {
      "enum": [
        "KEEP_AS_ESTABLISHED_MATH", "KEEP_AS_VALID_MODEL",
        "KEEP_AS_TESTED_INDEX_OR_CLASSIFIER", "KEEP_AS_ALGORITHM",
        "KEEP_AS_TOY_MODEL", "KEEP_AS_STRUCTURAL_METAPHOR",
        "REWRITE_AND_RETEST", "DOWNGRADE_TO_CONJECTURE",
        "DOWNGRADE_TO_PENDING", "QUARANTINE_UNTIL_DEFINED",
        "WITHDRAW_PUBLIC_CLAIM", "REJECT_AS_INVALID", "HISTORICAL_ONLY"
      ]
    },
    "adjudication_evidence_paths": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "reviewer_state": {
      "enum": [
        "TASK98_HUMAN_ADJUDICATION_RECONFIRMED",
        "TASK99_REPOSITORY_EVIDENCE_ADJUDICATED",
        "TASK99_MACHINE_TRIAGED_EXPLICIT_QUARANTINE"
      ]
    },
    "last_adjudicated_commit": {"type": "string", "minLength": 1},
    "last_adjudicated_date": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
