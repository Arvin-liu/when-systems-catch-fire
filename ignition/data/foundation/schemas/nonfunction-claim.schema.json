{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ignition corpus-wide non-function claim",
  "type": "object",
  "required": [
    "canonical_id",
    "canonical_title",
    "minimal_atomic_claim",
    "claim_class",
    "assertion_type",
    "internal_external_status",
    "scope_and_quantifiers",
    "assumptions",
    "definitions",
    "obligations",
    "counterexamples_and_defeaters",
    "dependency_edges",
    "mathematical_maturity",
    "external_evidence_maturity",
    "replication_status",
    "final_disposition",
    "claim_ceiling",
    "prohibited_wording",
    "supersession_lineage",
    "evidence_references",
    "source_anchors",
    "audit_gates",
    "reviewer_state",
    "record_sha256"
  ],
  "properties": {
    "canonical_id": {"type": "string", "pattern": "^(CLAIM|NFC)-[A-Za-z0-9._-]+$"},
    "canonical_title": {"type": "string", "minLength": 1},
    "minimal_atomic_claim": {"type": "string", "minLength": 1},
    "claim_class": {
      "enum": [
        "THEOREM_OR_MATHEMATICAL_CLAIM",
        "LAW_OR_PRINCIPLE_CLAIM",
        "MECHANISM_OR_CAUSAL_CLAIM",
        "IMPOSSIBILITY_OR_UNIVERSAL_CLAIM",
        "CROSS_DOMAIN_CORRESPONDENCE",
        "PREDICTION_OR_FORECAST",
        "EMPIRICAL_OR_LITERATURE_CLAIM",
        "ONTOLOGICAL_OR_METAPHYSICAL_CLAIM",
        "INTERPRETATION_OR_FRAMEWORK_CLAIM",
        "NORMATIVE_OR_GOVERNANCE_CLAIM",
        "DESCRIPTIVE_REPOSITORY_CLAIM",
        "UNRESOLVED_CLAIM"
      ]
    },
    "assertion_type": {
      "enum": ["DESCRIPTIVE", "MATHEMATICAL", "EMPIRICAL", "NORMATIVE", "INTERPRETIVE", "METAPHYSICAL", "UNRESOLVED"]
    },
    "internal_external_status": {"enum": ["MODEL_INTERNAL", "EXTERNAL", "MIXED_OR_UNRESOLVED"]},
    "scope_and_quantifiers": {
      "type": "object",
      "required": ["scope", "quantifier_status", "model_class"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "quantifier_status": {"type": "string", "minLength": 1},
        "model_class": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "definitions": {"type": "array", "items": {"type": "string"}},
    "obligations": {
      "type": "object",
      "required": ["proof", "empirical", "literature", "prediction"],
      "properties": {
        "proof": {"type": "array", "items": {"type": "string"}},
        "empirical": {"type": "array", "items": {"type": "string"}},
        "literature": {"type": "array", "items": {"type": "string"}},
        "prediction": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "counterexamples_and_defeaters": {"type": "array", "items": {"type": "string"}},
    "dependency_edges": {"type": "array", "items": {"type": "object"}},
    "mathematical_maturity": {"enum": ["M0", "M1", "M2", "M3", "M4", "M5", "M6", "M7"]},
    "external_evidence_maturity": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7"]},
    "replication_status": {"enum": ["NOT_APPLICABLE", "NOT_ASSESSED", "NO_REPLICATION_CLAIMED", "INTERNAL_REPLAY_ONLY", "EXTERNAL_REPLICATION_DOCUMENTED"]},
    "final_disposition": {
      "enum": [
        "ACCEPTED_AS_DEFINITION",
        "ACCEPTED_AS_PROVED_MATHEMATICAL_RESULT",
        "ACCEPTED_AS_ESTABLISHED_EXTERNAL_FACT",
        "RETAINED_AS_TOY_MODEL",
        "RETAINED_AS_HEURISTIC",
        "RETAINED_AS_STRUCTURAL_METAPHOR",
        "RETAINED_AS_RESEARCH_HYPOTHESIS",
        "PENDING_PROOF",
        "PENDING_EMPIRICAL_TEST",
        "PENDING_LITERATURE_ADJUDICATION",
        "REWRITE_AND_RETEST",
        "QUARANTINED_AMBIGUOUS",
        "WITHDRAWN_UNSUPPORTED",
        "REJECTED_FALSE_OR_INVALID",
        "HISTORICAL_ONLY"
      ]
    },
    "claim_ceiling": {"type": "string", "minLength": 1},
    "prohibited_wording": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "supersession_lineage": {"type": "object"},
    "evidence_references": {"type": "array", "items": {"type": "object"}},
    "source_anchors": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "audit_gates": {
      "type": "object",
      "required": [
        "definition_audit", "quantifier_audit", "proof_audit", "counterexample_audit",
        "type_dimension_audit", "internal_external_audit", "model_class_audit",
        "cross_domain_audit", "evidence_audit", "novelty_audit", "prediction_audit",
        "conclusion_rebound_audit", "public_surface_audit"
      ],
      "additionalProperties": {"enum": ["PASS", "FAIL", "REQUIRES_HUMAN_REVIEW", "NOT_APPLICABLE"]}
    },
    "reviewer_state": {"enum": ["SOURCE_TEXT_RULE_ADJUDICATED", "EXISTING_CANONICAL_CLAIM_MAPPED", "TASK98_99_AUTHORITY_INHERITED", "EXPLICITLY_QUARANTINED"]},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
