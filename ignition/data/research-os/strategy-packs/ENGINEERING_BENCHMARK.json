{
  "schema_version": "research-os/0.1",
  "registry": "strategy-pack",
  "code": "ENGINEERING_BENCHMARK",
  "title": "Engineering Benchmark",
  "description": "Reconcile engineering/ML benchmark claims: locate primary benchmark, access datasets/code, reproduce the scored run, and verify object/denominator comparability before a bounded-strong claim.",
  "required_obligations": [
    "PRIMARY_SOURCE",
    "FULL_TEXT_OR_METHODS_OR_SUPPLEMENT",
    "DATA_OR_TABLE_ACCESS",
    "NUMERIC_RECOMPUTATION",
    "CONSTRUCT_AND_OUTCOME_DEFINITION",
    "SOURCE_INDEPENDENCE_CHECK",
    "POPULATION_JURISDICTION_TIME_SCOPE",
    "EXTERNAL_HUMAN_OR_DOMAIN_REVIEW"
  ],
  "typical_gaps": [
    "PRIMARY_SOURCE_MISSING",
    "RAW_DATA_OR_CODE_MISSING",
    "NUMERIC_CLAIM_NOT_RECOMPUTED",
    "OBJECT_OR_DENOMINATOR_MISMATCH",
    "OUTCOME_DEFINITION_CONFLICT",
    "SOURCE_DEPENDENCE_HIGH",
    "POPULATION_SCOPE_MISMATCH"
  ],
  "mandatory_calculations": [
    "RECOMPUTE_RESULT",
    "REPRODUCE_ANALYSIS",
    "LOCATE_RAW_DATA",
    "LOCATE_ANALYSIS_CODE"
  ],
  "common_failure_modes": [
    {"gap_code": "OBJECT_OR_DENOMINATOR_MISMATCH", "note": "Benchmark objects or scoring denominators not equivalent across systems."},
    {"gap_code": "NUMERIC_CLAIM_NOT_RECOMPUTED", "note": "Reported score accepted without reproduced run."},
    {"gap_code": "RAW_DATA_OR_CODE_MISSING", "note": "Benchmark code/data not located, reproducibility unverifiable."}
  ],
  "max_claim_ceiling": "BOUNDED_STRONG",
  "escalation_conditions": [
    {"when": "candidate claim ceiling would exceed BOUNDED_STRONG", "trigger_gap": "CLAIM_EXCEEDS_EVIDENCE", "escalate_to": "GPT_OWNER"},
    {"when": "high-stakes or publication claim", "trigger_gap": "HUMAN_JUDGMENT_REQUIRED", "escalate_to": "GPT_OWNER"},
    {"when": "reproduced score conflicts with source", "trigger_gap": "OBJECT_OR_DENOMINATOR_MISMATCH", "escalate_to": "GPT_OWNER"}
  ],
  "stop_criteria": [
    {"condition": "benchmark reproduced, comparability verified, obligations satisfied", "terminal_state": "CANDIDATE_COMPLETE", "note": "Bounded strong only after external review."},
    {"condition": "benchmark code/data inaccessible after search", "terminal_state": "INSUFFICIENT_EVIDENCE_COMPLETE", "note": "Honest insufficient-evidence conclusion."},
    {"condition": "comparability never verified", "terminal_state": "EVIDENCE_GATHERING", "note": "Must run BUILD_DEFINITION_CROSSWALK / COMPARE_OUTCOMES_OR_DENOMINATORS."}
  ]
}
