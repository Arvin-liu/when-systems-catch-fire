{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/ignition/reports/evaluations/ignition-190-method-use-trace-r0/schema/method-use-trace-r0.schema.json",
  "title": "Method-Use Trace R0 (task-local evidence adapter)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "task_id",
    "trace_id",
    "is_synthetic",
    "segments",
    "claim_ceiling",
    "authority_status",
    "canonical_claim_ids",
    "canonical_promotion",
    "successor_status",
    "evaluator_status"
  ],
  "properties": {
    "artifact_type": {
      "const": "EVALUATION_EVIDENCE"
    },
    "schema_version": {
      "const": "method-use-trace-r0"
    },
    "task_id": {
      "const": "IGNITION-20260920-190"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "is_synthetic": {
      "const": true
    },
    "segments": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "claim_ceiling": {
      "const": "METHOD_USE_TRACE_IS_EVIDENCE_ARTIFACT_NOT_CAPABILITY_PROOF"
    },
    "authority_status": {
      "const": "RESEARCH_ONLY"
    },
    "canonical_claim_ids": {
      "const": []
    },
    "canonical_promotion": {
      "const": "NONE"
    },
    "successor_status": {
      "const": "NOT_RUN"
    },
    "evaluator_status": {
      "const": "NOT_RUN"
    }
  },
  "$defs": {
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis",
        "open_questions"
      ],
      "properties": {
        "status": {
          "enum": [
            "KNOWN",
            "OBSERVED",
            "SUPPORTED",
            "HYPOTHESIS",
            "UNKNOWN",
            "NOT_MEASURED",
            "INCONCLUSIVE"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_status",
        "allowed_claims",
        "forbidden_inferences"
      ],
      "properties": {
        "authority_status": {
          "const": "OBSERVATION_ONLY"
        },
        "allowed_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "forbidden_inferences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "segment_kind",
        "source_ref",
        "source_sha256",
        "exact_locator",
        "summary",
        "uncertainty",
        "claim_ceiling"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "segment_kind": {
          "enum": [
            "METHOD_CANDIDATE",
            "SELECTION_RATIONALE",
            "CONTEXT",
            "METHOD_USE_EVENT",
            "OBSERVED_OUTCOME_OR_FAILURE",
            "REVISION_OR_DISPOSITION"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 3
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "exact_locator": {
          "type": "string",
          "minLength": 3
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        },
        "claim_ceiling": {
          "$ref": "#/$defs/claim_ceiling"
        },
        "candidate_ref": {
          "type": "string",
          "minLength": 3
        },
        "selected_candidate_ref": {
          "type": "string",
          "minLength": 3
        },
        "rationale": {
          "type": "string",
          "minLength": 10
        },
        "alternatives_considered": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "context_ref": {
          "type": "string",
          "minLength": 3
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "used_candidate_ref": {
          "type": "string",
          "minLength": 3
        },
        "input_ref": {
          "type": "string",
          "minLength": 3
        },
        "expected_observation": {
          "type": "string",
          "minLength": 10
        },
        "use_order": {
          "type": "integer",
          "minimum": 1
        },
        "use_segment_ref": {
          "type": "string",
          "minLength": 3
        },
        "outcome_type": {
          "enum": [
            "OBSERVED_OUTCOME",
            "FAILURE",
            "NO_DISCRIMINATING_OBSERVATION"
          ]
        },
        "observed_outcome": {
          "type": "string",
          "minLength": 10
        },
        "confounders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "causal_attribution": {
          "enum": [
            "NOT_ESTABLISHED",
            "SUPPORTED_WITHIN_SYNTHETIC_TRACE",
            "UNKNOWN"
          ]
        },
        "revision_type": {
          "enum": [
            "REVISE",
            "NO_REVISION",
            "REJECT",
            "COEXIST",
            "SUPERSEDE",
            "UNRESOLVED"
          ]
        },
        "revision_rationale": {
          "type": "string",
          "minLength": 10
        },
        "disposition": {
          "enum": [
            "ADOPT",
            "REJECT",
            "COEXIST",
            "UNRESOLVED",
            "REVISE",
            "NO_REVISION",
            "SUPERSEDE"
          ]
        },
        "target_candidate_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3
        },
        "rollback_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 3
        }
      }
    }
  }
}
