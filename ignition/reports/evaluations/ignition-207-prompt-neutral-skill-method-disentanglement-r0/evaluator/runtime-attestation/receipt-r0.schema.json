{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arvin-liu/when-systems-catch-fire/blob/main/ignition/reports/evaluations/ignition-207-prompt-neutral-skill-method-disentanglement-r0/evaluator/runtime-attestation/receipt-r0.schema.json",
  "title": "Runtime Configuration Attestation Receipt R0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "task_id",
    "schema_version",
    "experiment_id",
    "trial_id",
    "opaque_packet_id",
    "conversation_id",
    "requested_configuration",
    "observed_configuration",
    "prompt_set",
    "runtime",
    "lifecycle",
    "verification_evidence",
    "independent_verification",
    "attestation_status",
    "limitations",
    "credential_values_included",
    "receipt_sha256"
  ],
  "properties": {
    "artifact_type": {"const": "EVALUATION_EVIDENCE"},
    "task_id": {"const": "IGNITION-20260923-207"},
    "schema_version": {"const": "runtime-attestation-receipt-r0"},
    "experiment_id": {"type": "string", "minLength": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "opaque_packet_id": {"type": "string", "pattern": "^PKT-[0-9A-F]{6}$"},
    "conversation_id": {"type": "string", "minLength": 1},
    "requested_configuration": {"$ref": "#/$defs/configuration"},
    "observed_configuration": {"$ref": "#/$defs/configuration"},
    "prompt_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_prompt_sha256", "developer_prompt_sha256", "user_prompt_sha256", "packet_manifest_sha256", "output_schema_sha256"],
      "properties": {
        "system_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "developer_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "user_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "packet_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "output_schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_mode", "client_name", "client_version", "runtime_version", "host_pseudonym", "host_image_sha256"],
      "properties": {
        "runtime_mode": {"enum": ["LOCAL_RUNTIME", "PROVIDER_API", "HOSTED_SERVICE", "OTHER"]},
        "client_name": {"type": "string", "minLength": 1},
        "client_version": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1},
        "host_pseudonym": {"type": "string", "minLength": 1},
        "host_image_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at_utc", "finished_at_utc", "request_count", "tool_trace_sha256", "response_sha256"],
      "properties": {
        "started_at_utc": {"type": "string", "format": "date-time"},
        "finished_at_utc": {"type": "string", "format": "date-time"},
        "request_count": {"type": "integer", "minimum": 1},
        "tool_trace_sha256": {"$ref": "#/$defs/sha256"},
        "response_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verification_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "evidence_type", "path_or_uri", "sha256", "independent_source"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "evidence_type": {"enum": ["SIGNED_PROVIDER_ATTESTATION", "INDEPENDENT_RUNTIME_LOG", "SIGNED_BUILD_METADATA", "CLIENT_LOG", "OPERATOR_COMMAND", "OTHER"]},
          "path_or_uri": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "independent_source": {"type": "boolean"}
        }
      }
    },
    "independent_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier_pseudonym", "independence_status", "method", "verified_fields"],
      "properties": {
        "verifier_pseudonym": {"type": ["string", "null"]},
        "independence_status": {"enum": ["INDEPENDENT_OF_CONFIGURATION_AND_RUN", "NOT_INDEPENDENT", "UNKNOWN"]},
        "method": {"type": "string", "minLength": 1},
        "verified_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "attestation_status": {
      "enum": [
        "COMMAND_ASSIGNED_NOT_INDEPENDENTLY_VERIFIED",
        "PARTIALLY_INDEPENDENTLY_VERIFIED",
        "INDEPENDENTLY_VERIFIED",
        "UNVERIFIED",
        "INCOMPLETE_RECEIPT"
      ]
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "credential_values_included": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "detached_signature_reference": {"type": ["string", "null"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_id", "model_version", "deployment_id", "api_version", "sampling", "response_format", "tool_configuration_sha256"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "model_version": {"type": ["string", "null"]},
        "deployment_id": {"type": ["string", "null"]},
        "api_version": {"type": ["string", "null"]},
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["temperature", "top_p", "max_output_tokens", "seed"],
          "properties": {
            "temperature": {"type": ["number", "null"], "minimum": 0, "maximum": 2},
            "top_p": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
            "max_output_tokens": {"type": ["integer", "null"], "minimum": 1},
            "seed": {"type": ["integer", "null"]}
          }
        },
        "response_format": {"type": "string", "minLength": 1},
        "tool_configuration_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
