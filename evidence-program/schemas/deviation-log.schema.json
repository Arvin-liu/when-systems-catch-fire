{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arvin-liu.github.io/when-systems-catch-fire/evidence-program/schemas/deviation-log.schema.json",
  "title": "Deviation Log",
  "description": "Explicit, timestamped deviations from the preregistration (Task 103 §5).",
  "type": "object",
  "required": ["deviations"],
  "properties": {
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp_utc", "type", "description"],
        "properties": {
          "timestamp_utc": {"type": "string"},
          "type": {"type": "string", "enum": ["AMENDMENT", "NETWORK_RETRY", "SCOPE_CLARIFICATION", "TOOLING", "OTHER"]},
          "description": {"type": "string"},
          "approved_by": {"type": "string"},
          "preregistered_value": {"type": "string"},
          "revised_value": {"type": "string"}
        }
      }
    }
  }
}
